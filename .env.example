# Variables du serveur (valeurs factices ou vides). Copier en .env pour le local : node --env-file=.env server.mjs
# Sur Render : onglet Environment du service, jamais dans le dépôt. Toutes sont lues à l'exécution (astro:env), aucune n'est figée au build.

# Postgres (Render : fromDatabase). Local : base jetable, auth trust
DATABASE_URL=postgres://mybubble@127.0.0.1:5544/mybubble_dev

# Adresse publique du site, sans / final : liens des e-mails et retours Stripe partent d'ici, jamais de l'en-tête Host
SITE_URL=http://localhost:10000

# Seul compte admin : l'utilisatrice dont l'e-mail VÉRIFIÉ vaut cette adresse
ADMIN_EMAIL=gerante@example.com

# Les deux secrets suivants restent vides ici (une valeur d'exemple serait publique) : server.mjs refuse de démarrer sans eux.
# Second facteur de l'admin : base32 de 20 octets (32 caractères). Générer : npm run admin:totp
ADMIN_TOTP_SECRET=

# Poivre des mots de passe et des cookies d'appareil (32 octets aléatoires). Générer : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# À sauvegarder hors de Render : le perdre invalide tous les mots de passe
PASSWORD_PEPPER=

# Stripe (facultatif tant qu'aucune prestation n'a d'acompte) : clé secrète sk_test_… puis secret de signature du webhook whsec_…
# Destination du webhook : SITE_URL/api/stripe/webhook, événement checkout.session.completed seul, charge « Snapshot », version 2026-09-30.endive (celle de src/lib/server/stripe.ts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (facultatif en local : sous astro dev, l'e-mail est écrit dans la console) et adresse d'expédition vérifiée chez Resend
RESEND_API_KEY=
MAIL_FROM=My Bubble Beauty <rendez-vous@mybubble-beauty.com>

# Port d'écoute (Render ne le pose pas : 10000 par défaut)
# PORT=10000
