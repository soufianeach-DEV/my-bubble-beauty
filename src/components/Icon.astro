---
// Icônes SVG décoratives (repris de la v1) : toujours aria-hidden, le texte voisin porte le sens.
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
const soin = 'fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"';
const ICONS: Record<string, { box: string; attrs: string; body: string }> = {
  phone: { box: '0 0 24 24', attrs: 'fill="none" stroke="currentColor" stroke-width="1.5"', body: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>' },
  whatsapp: { box: '0 0 24 24', attrs: 'fill="none" stroke="currentColor" stroke-width="1.5"', body: '<path d="M4 20l1.3-4A8.5 8.5 0 1 1 8.4 19z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.8-2-1-1 1a4 4 0 0 1-2.2-2.2l1-1-1-2z"/>' },
  info: { box: '0 0 16 16', attrs: 'fill="none" stroke="currentColor" stroke-width="1.2"', body: '<circle cx="8" cy="8" r="6.5"/><path d="M8 7v4.2M8 4.8v.4" stroke-linecap="round"/>' },
  chevron: { box: '0 0 12 12', attrs: '', body: '<path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>' },
  pause: { box: '0 0 16 16', attrs: 'fill="currentColor"', body: '<rect x="4" y="3" width="2.5" height="10" rx="1"/><rect x="9.5" y="3" width="2.5" height="10" rx="1"/>' },
  check: { box: '0 0 20 20', attrs: 'fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"', body: '<circle cx="10" cy="10" r="8.5"/><path d="m6.5 10.2 2.3 2.3 4.7-4.9"/>' },
  facebook: { box: '0 0 24 24', attrs: 'fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"', body: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8z"/>' },
  instagram: { box: '0 0 24 24', attrs: 'fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"', body: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".8" fill="currentColor"/>' },
  snapchat: { box: '0 0 24 24', attrs: 'fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"', body: '<path d="M12 3c3 0 5 2.3 5 5.2v2.3l1.6-.5c.8 0 1 .9.3 1.3l-1.9 1c.4 1.6 1.7 2.9 3.4 3.5-.3.8-1.6 1-2.6 1.1-.2.6-.2 1.3-.9 1.3-.8 0-1.7-.6-2.9 0-1 .6-1.6 1.3-2 1.3s-1-.7-2-1.3c-1.2-.6-2.1 0-2.9 0-.7 0-.7-.7-.9-1.3-1-.1-2.3-.3-2.6-1.1 1.7-.6 3-1.9 3.4-3.5l-1.9-1c-.7-.4-.5-1.3.3-1.3l1.6.5V8.2C7 5.3 9 3 12 3z"/>' },
  'soin-0': { box: '0 0 48 48', attrs: soin, body: '<ellipse cx="24" cy="23" rx="11" ry="14"/><path d="M19 21h2M27 21h2M21 30c2 1.5 4 1.5 6 0"/><path d="M8 40c4-3 9-4 16-4s12 1 16 4"/>' },
  'soin-1': { box: '0 0 48 48', attrs: soin, body: '<ellipse cx="24" cy="36" rx="15" ry="5"/><ellipse cx="24" cy="26" rx="11" ry="4.2"/><ellipse cx="24" cy="17.5" rx="7" ry="3.2"/><path d="M33 9c1.5-2 3.5-3 6-3"/>' },
  'soin-2': { box: '0 0 48 48', attrs: soin, body: '<path d="M24 6c8 9 12 16 12 22a12 12 0 0 1-24 0c0-6 4-13 12-22z"/><path d="M19 30a5 5 0 0 0 5 5"/>' },
  'soin-3': { box: '0 0 48 48', attrs: soin, body: '<path d="M18 40c-5 0-7-4-6-9l2-12c1-5 4-8 7-8s5 3 5 7c0 5-3 8-3 13 0 3 1 4 1 6 0 2-2 3-6 3z"/><circle cx="30" cy="10" r="2"/><circle cx="34" cy="14" r="1.8"/><circle cx="36" cy="19" r="1.6"/>' },
  'soin-4': { box: '0 0 48 48', attrs: soin, body: '<rect x="16" y="20" width="16" height="20" rx="4"/><path d="M20 20v-5h8v5"/><path d="M22 15V7h4v8"/><path d="M20 30h8"/>' },
  'soin-5': { box: '0 0 48 48', attrs: soin, body: '<path d="M10 22c0-7 6-12 14-12s14 5 14 12c0 9-6 16-14 16s-14-7-14-16z"/><path d="M16 24c4 5 12 5 16 0"/><path d="M19 25.5v3M24 26.5v3M29 25.5v3"/>' },
};
const icon = ICONS[name];
if (!icon) throw new Error(`Icône inconnue : ${name}`);
const svg = `<svg${cls ? ` class="${cls}"` : ''} viewBox="${icon.box}" ${icon.attrs} aria-hidden="true" focusable="false">${icon.body}</svg>`;
---
<Fragment set:html={svg} />
