---
// Calendrier du mois, rendu par le serveur (aucun JS, CSP stricte) : remplace le champ date natif de la réservation, du déplacement
// et des dates de l'admin. Chaque jour ouvert est un lien vers la même page avec ?jour= (ou un bouton d'envoi si `name` est donné) ;
// jours fermés (aucune plage d'ouverture ce jour de semaine, ou fermeture posée par la gérante sur toute la journée), passés ou au-delà
// de la limite affichés grisés. Côté cliente, un jour grisé n'est pas cliquable ; dans l'admin (`soft`), il reste choisissable.
import { sql } from '../lib/server/db.ts';
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
  /** Jour choisi, AAAA-MM-JJ */
  day: string;
  today: string;
  lastDay: string;
  /** Lien vers un jour donné (sans `name`) */
  href?: (day: string) => string;
  label: string;
  /** Premier jour choisissable, AAAA-MM-JJ (par défaut : aujourd'hui) */
  min?: string;
  /** Admin : les jours grisés restent cliquables (consulter un jour passé, ouvrir exceptionnellement) */
  soft?: boolean;
  /** Dans un formulaire : chaque jour est un bouton d'envoi name=valeur (la saisie du formulaire est gardée) */
  name?: string;
}
const { lang, day, today, lastDay, href = (d: string) => `?jour=${d}`, label, min = today, soft = false, name } = Astro.props;
const locale = { fr: 'fr-BE', nl: 'nl-BE', en: 'en-GB' }[lang];
const utc = (d: string) => new Date(`${d}T12:00:00Z`);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const month = day.slice(0, 7);
const first = utc(`${month}-01`);
const lead = (first.getUTCDay() + 6) % 7; // cases vides avant le 1er (semaine commençant le lundi)
const count = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth() + 1, 0)).getUTCDate();
const [weekdays, closedDays] = await Promise.all([
  // Jours de semaine ISO (lundi = 1) qui ont au moins une plage d'ouverture
  sql<{ weekday: number }[]>`SELECT DISTINCT weekday FROM opening_hours`,
  // Jours du mois couverts en entier par une fermeture (minuit à minuit, heure de Bruxelles)
  sql<{ d: string }[]>`
    SELECT to_char(g.d, 'YYYY-MM-DD') AS d FROM generate_series(${`${month}-01`}::date, (${`${month}-01`}::date + interval '1 month' - interval '1 day')::date, interval '1 day') g(d)
    WHERE EXISTS (SELECT 1 FROM closures c WHERE c.starts_at <= g.d::timestamp AT TIME ZONE 'Europe/Brussels'
      AND c.ends_at >= (g.d + interval '1 day')::timestamp AT TIME ZONE 'Europe/Brussels')`,
]);
const open = new Set(weekdays.map((r) => Number(r.weekday)));
const closed = new Set(closedDays.map((r) => r.d));
const cells = Array.from({ length: count }, (_, i) => {
  const d = iso(new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth(), i + 1, 12)));
  const wd = ((utc(d).getUTCDay() + 6) % 7) + 1;
  // shut : salon fermé ce jour (fermeture posée ou jour de semaine sans horaires), à distinguer d'un jour passé
  const shut = closed.has(d) || !open.has(wd);
  return { d, n: i + 1, ok: d >= min && d <= lastDay && !shut, shut };
});
const monthName = (d: Date) => new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d);
const fullDay = (d: string) => new Intl.DateTimeFormat(locale, { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(utc(d));
// En-têtes lundi → dimanche dans la langue de la page (5 janvier 2026 = un lundi)
const heads = Array.from({ length: 7 }, (_, i) => new Intl.DateTimeFormat(locale, { weekday: 'short', timeZone: 'UTC' }).format(utc(`2026-01-${String(5 + i).padStart(2, '0')}`)));
// Mois voisins : premier jour réservable du mois (admin : le 1er), sinon pas de lien
const prevMonth = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth() - 1, 1, 12));
const nextMonth = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth() + 1, 1, 12));
const target = (m: Date) => {
  if (soft) return iso(m) <= lastDay ? iso(m) : null;
  const start = iso(m) < min ? min : iso(m);
  return start.slice(0, 7) === iso(m).slice(0, 7) && start <= lastDay ? start : null;
};
const prev = soft || month > min.slice(0, 7) ? target(prevMonth) : null;
const next = target(nextMonth);
---
<nav class="daypick" aria-label={label}>
<div class="dp-head">
  {prev ? (name
    ? <button class="dp-nav" type="submit" name={name} value={prev} formnovalidate aria-label={monthName(prevMonth)}>‹</button>
    : <a class="dp-nav" href={href(prev)} aria-label={monthName(prevMonth)}>‹</a>) : <span class="dp-nav" aria-hidden="true"></span>}
  <p class="dp-month">{monthName(first)}</p>
  {next ? (name
    ? <button class="dp-nav" type="submit" name={name} value={next} formnovalidate aria-label={monthName(nextMonth)}>›</button>
    : <a class="dp-nav" href={href(next)} aria-label={monthName(nextMonth)}>›</a>) : <span class="dp-nav" aria-hidden="true"></span>}
</div>
<ol class="dp-grid" role="list">
  {heads.map((h) => <li class="dp-wd" aria-hidden="true">{h}</li>)}
  {Array.from({ length: lead }, () => <li aria-hidden="true"></li>)}
  {cells.map((c) => {
    // Admin : un jour fermé est barré (et reste cliquable) ; un jour passé est seulement estompé
    const cls = ['dp-day', { 'dp-today': c.d === today, 'dp-off': !c.ok && !(soft && c.shut), 'dp-shut': soft && c.shut }];
    const aria = `${fullDay(c.d)}${c.shut ? ' (fermé)' : ''}`;
    const current = c.d === day ? 'date' : undefined;
    return <li>{c.ok || soft
      ? name
        ? <button class:list={cls} type="submit" name={name} value={c.d} formnovalidate aria-current={current} aria-label={aria}>{c.n}</button>
        : <a class:list={cls} href={href(c.d)} aria-current={current} aria-label={aria}>{c.n}</a>
      : <span class="dp-day dp-off" aria-hidden="true">{c.n}</span>}</li>;
  })}
</ol>
{soft && <p class="dp-legend"><span class="dp-day dp-shut" aria-hidden="true">19</span> Barré : salon fermé ce jour-là. Le jour reste choisissable.</p>}
</nav>

<style>
.daypick{max-width:22rem;margin:0 0 1.25rem;padding:.75rem;border:1px solid var(--line-soft);border-radius:16px;background:var(--bg)}
.dp-head{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-bottom:.4rem}
.dp-month{margin:0;font-weight:600;text-transform:capitalize}
.dp-nav{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:12px;background:none;font:inherit;font-size:1.4rem;line-height:1;text-decoration:none;color:var(--text);cursor:pointer}
a.dp-nav:hover,a.dp-nav:focus-visible,button.dp-nav:hover,button.dp-nav:focus-visible{background:var(--line-soft)}
.dp-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(7,1fr);gap:.2rem;text-align:center}
.dp-wd{font-size:.75rem;color:var(--text-soft);padding:.2rem 0;text-transform:capitalize}
.dp-day{display:grid;place-items:center;width:100%;aspect-ratio:1;min-height:40px;padding:0;border:0;border-radius:999px;background:none;font:inherit;text-decoration:none;color:var(--text);font-variant-numeric:tabular-nums;cursor:pointer}
a.dp-day:hover,a.dp-day:focus-visible,button.dp-day:hover,button.dp-day:focus-visible{background:var(--line-soft)}
.dp-today{box-shadow:inset 0 0 0 1px var(--accent)}
.dp-day[aria-current="date"]{background:var(--accent);color:var(--on-accent,#2a1d1a);font-weight:600;opacity:1}
.dp-off{color:var(--text-soft);opacity:.45}
span.dp-off{cursor:default}
.dp-shut{color:var(--text-soft);text-decoration:line-through;text-decoration-thickness:2px;outline:1px dashed var(--text-soft);outline-offset:-4px}
.dp-shut.dp-today{box-shadow:inset 0 0 0 1px var(--accent)}
.dp-legend{display:flex;align-items:center;gap:.5rem;margin:.5rem 0 0;font-size:.8125rem;color:var(--text-soft)}
.dp-legend .dp-day{width:2rem;min-height:2rem;flex:none;cursor:default}
</style>
