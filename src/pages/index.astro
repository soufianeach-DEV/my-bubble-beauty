---
// Page d'entrée du domaine : choix de la langue (cible x-default des hreflang).
import '../styles/global.css';
import { LANGS, LANG_META, SITE, JS_VERSION, pagePath, alternates } from '../lib/site';
const title = 'My Bubble Beauty — Dilbeek';
const description = 'Centre de beauté et bien-être à Anderlecht, Molenbeek-Saint-Jean, Dilbeek et Berchem-Sainte-Agathe : soins esthétiques, pédicure médicale et massages.';
---
<!DOCTYPE html>
<html lang="fr-BE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#F6ECE8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1E1615" media="(prefers-color-scheme: dark)">
<link rel="canonical" href={SITE + '/'}>
{alternates('home').map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href}>)}
<link rel="alternate" hreflang="x-default" href={SITE + '/'}>
<link rel="preload" href="/assets/fonts/italiana-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/assets/img/favicon.png" type="image/png" sizes="64x64">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="My Bubble Beauty">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={SITE + '/'}>
<meta property="og:image" content={SITE + '/assets/img/og-image.jpg'}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="fr_BE">
<meta name="twitter:card" content="summary_large_image">
<script is:inline src={`/assets/js/motion-pref.js?v=${JS_VERSION}`}></script>
</head>
<body class="chooser">
<main id="main" class="chooser__main">
<h1 class="chooser__logo"><img src="/assets/img/my-bubble-logo-480.webp" srcset="/assets/img/my-bubble-logo-480.webp 480w, /assets/img/my-bubble-logo.webp 960w" sizes="min(80vw, 440px)" width="960" height="828" alt="My Bubble Beauty"></h1>
<p class="chooser__tag"><span>Choisissez votre langue</span> · <span lang="nl-BE">Kies je taal</span> · <span lang="en">Choose your language</span></p>
<ul class="chooser__langs">{LANGS.map((l, i) => (
  <li><a class={`btn ${i === 0 ? 'btn--solid' : 'btn--ghost'} sheen`} href={pagePath(l, 'home')} hreflang={LANG_META[l].hreflang} lang={LANG_META[l].hreflang}>{LANG_META[l].name}</a></li>
))}</ul>
</main>
</body>
</html>
