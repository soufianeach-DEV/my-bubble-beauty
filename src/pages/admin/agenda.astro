---
export const prerender = false;
// Agenda : rendez-vous du jour ou de la semaine à l'heure de Bruxelles, annulation en deux temps et remboursement de l'acompte
import Admin from './_layout.astro';
import { adminId, staffId, agendaAction, deleteAction, fmtDay, fmtTime, openingSpan, readForm } from '../../lib/server/admin.ts';
import '../../styles/agenda-grille.css';
import { gridBounds, placeSpans } from '../../lib/server/agenda-grille.ts';
import RdvActions from './_rdv-actions.astro';
import { alertsFor } from '../../lib/server/profil.ts';
import { addDays, monday } from '../../lib/server/admin-form.ts';
import { adminAgenda } from '../../lib/server/booking.ts';
import { euros, isDay, todayBrussels } from '../../lib/server/pricing.ts';

const me = staffId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
// Suppression d'un rendez-vous : admin seulement
const admin = adminId(Astro.locals) !== null;
const q = Astro.url.searchParams;
const vue = q.get('vue') === 'jour' ? 'jour' : 'semaine';
const today = todayBrussels();
const jour = isDay(q.get('jour')) ? q.get('jour')! : today;
const link = (d: string, v = vue) => `/admin/agenda?jour=${d}&vue=${v}`;
let error = '';
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  const r = form.get('action') === 'delete'
    ? admin ? await deleteAction(form) : { ok: false as const, error: "Seule l'admin peut supprimer un rendez-vous." }
    : await agendaAction(me, form);
  // Déplacé : l'agenda suit le rendez-vous à sa nouvelle date
  if (r.ok) return Astro.redirect(`${link(r.day ?? jour)}&ok=${r.key}#r-${r.id}`, 303);
  error = r.error;
  Astro.response.status = 400;
}
const DONE: Record<string, string> = {
  annule: 'Rendez-vous annulé.',
  supprime: 'Rendez-vous supprimé.',
  rembourse: 'Acompte remboursé, rendez-vous annulé.',
  echec: "Le remboursement n'a pas abouti. S'il reste un acompte à rendre, le bouton « Rembourser l'acompte » reste sur la ligne : réessayez plus tard.",
  cree: 'Rendez-vous enregistré.',
  deplace: 'Rendez-vous déplacé. La cliente reçoit un e-mail si elle a un compte.',
  absente: 'Rendez-vous marqué « absente ».',
  venue: 'Absence retirée.',
  retard: 'Retard noté.',
  encaisse: 'Encaissement noté.',
  nonencaisse: 'Encaissement retiré.',
  aheure: 'Retard retiré.',
  rendu: 'Acompte noté comme remboursé hors du site.',
};
// Le formulaire repart vers l'URL courante : après un refus, le ?ok= du succès précédent ne doit plus s'afficher
const done = !error && DONE[q.get('ok') ?? ''];
const from = vue === 'jour' ? jour : monday(jour);
const count = vue === 'jour' ? 1 : 7;
const rows = await adminAgenda(from, count);
// Badges d'alerte de la fiche de soin, à voir avant le soin
const careAlerts = await alertsFor([...new Set(rows.map((r) => r.user_id).filter((x): x is number => !!x))]);
// Annulés et expirés masqués par défaut (?annules=1 pour les voir) ; ceux qui ont encore un acompte à rendre restent visibles
const showCancelled = q.get('annules') === '1';
const gone = (r: (typeof rows)[number]) => (r.status === 'cancelled' || r.status === 'expired') && !(r.paid && r.deposit_cents - r.refunded_cents > 0);
const hidden = rows.filter(gone).length;
const days = Array.from({ length: count }, (_, i) => addDays(from, i)).map((d) => ({ d, rows: rows.filter((r) => todayBrussels(r.starts_at) === d && (showCancelled || !gone(r))) }));
const STATUS = { confirmed: 'Confirmé', pending_payment: 'Paiement en cours', cancelled: 'Annulé', expired: 'Payé après expiration' };
const TONE = { confirmed: 'ok', pending_payment: 'wait', cancelled: 'off', expired: 'alert' };
// Acompte encaissé et pas encore rendu
const due = (r: (typeof rows)[number]) => (r.paid ? r.deposit_cents - r.refunded_cents : 0);
// Vue semaine : grille 7 jours × heures. Bornes = ouverture la plus tôt et fermeture la plus tard, élargies aux rendez-vous
// hors horaires, arrondies à l'heure, 16 h au plus (192 lignes de 5 min, voir agenda-grille.css).
type Row = (typeof rows)[number];
const span = vue === 'semaine' ? await openingSpan() : null;
const mins = (d: Date) => { const [h, m] = fmtTime(d).split(':').map(Number); return h * 60 + m; };
const spanOf = (r: Row) => ({ start: mins(r.starts_at), end: Math.max(mins(r.ends_at) || 1440, mins(r.starts_at) + 5) });
const shown = days.flatMap((x) => x.rows);
const { lo, hi } = gridBounds(span, shown.map(spanOf));
const nRows = (hi - lo) / 5;
const hours = Array.from({ length: (hi - lo) / 60 }, (_, i) => `${String(lo / 60 + i).padStart(2, '0')}:00`);
// Classes de placement (agenda-grille.css) ; chevauchement = plus d'un couloir dans le groupe
const place = (list: Row[]) => placeSpans(list.map(spanOf), lo, hi).map((p, i) => ({ r: list[i], cls: `gs-${p.row} gn-${p.rows} ln-${p.lane}-${p.lanes}`, overlap: p.lanes > 1 }));
const tone = (r: Row) => (r.status === 'cancelled' || r.status === 'expired' ? 'off' : r.no_show ? 'noshow' : r.status === 'pending_payment' ? 'wait' : r.past ? 'past' : 'ok');
const alertsOf = (r: Row) => (r.user_id ? careAlerts.get(r.user_id) ?? [] : []);
---
<Admin title="Agenda">
<span slot="actions" class="head-acts">{vue === 'jour' && <a class="btn btn--ghost" href={`/admin/imprimer?jour=${jour}`}>Imprimer la journée</a>}<a class="btn btn--solid" href="/admin/reservations/nouvelle">Saisir un rendez-vous</a></span>
{done && <p class="notice" role="status">{done}</p>}
{error && <p class="notice notice--error" role="alert">{error}</p>}
{(hidden > 0 || showCancelled) && <p class="hint">{showCancelled ? <a href={link(jour)}>Masquer les rendez-vous annulés</a> : <a href={`${link(jour)}&annules=1`}>Afficher les rendez-vous annulés ({hidden})</a>}</p>}
<div class="toolbar">
<nav class="pager" aria-label="Période">
  <a href={link(addDays(from, -count))}><span aria-hidden="true">‹</span> <span class="long">{vue === 'jour' ? 'Jour précédent' : 'Semaine précédente'}</span></a>
  <a href={link(today)}>Aujourd'hui</a>
  <a href={link(addDays(from, count))}><span class="long">{vue === 'jour' ? 'Jour suivant' : 'Semaine suivante'}</span> <span aria-hidden="true">›</span></a>
</nav>
<form class="pick" method="get" action="/admin/agenda">
  <div class="field"><label for="jour">Jour</label><input id="jour" name="jour" type="date" value={jour} required></div>
  <div class="field"><label for="vue">Affichage</label>
    <select id="vue" name="vue"><option value="semaine" selected={vue === 'semaine'}>Semaine</option><option value="jour" selected={vue === 'jour'}>Jour</option></select>
  </div>
  <button class="btn btn--ghost" type="submit">Afficher</button>
</form>
</div>
{vue === 'semaine' && (<>
  {/* Ordinateur : 7 colonnes × heures, hauteur selon la durée, chevauchements côte à côte ; un clic ouvre le panneau du rendez-vous */}
  <div class="cal" id="cal" role="group" aria-label="Semaine en grille horaire">
    <div class="cal-head"><span></span>{days.map(({ d, rows }) => {
      const n = rows.filter((r) => r.status === 'confirmed' || r.status === 'pending_payment').length;
      return <a class:list={['cal-day', { 'cal-day--today': d === today }]} href={link(d, 'jour')}>{fmtDay(d)}<small>{n ? `${n} rendez-vous` : 'Libre'}</small></a>;
    })}</div>
    <div class="cal-body">
      <ol class="cal-hours" aria-hidden="true">{hours.map((h, i) => <li class={`gs-${i * 12 + 1} gn-12 ln-1-1`}>{h}</li>)}</ol>
      {days.map(({ d, rows }) => (
        <ol class:list={['cal-col', { 'cal-col--today': d === today }]} aria-label={fmtDay(d)}>
          <li class={`cal-fill gs-1 gn-${Math.min(nRows, 144)} ln-1-1`} aria-hidden="true"></li>
          {nRows > 144 && <li class={`cal-fill gs-145 gn-${nRows - 144} ln-1-1`} aria-hidden="true"></li>}
          {place(rows).map(({ r, cls, overlap }) => (
            <li class={cls}><a class:list={['ev', `ev--${tone(r)}`, { 'ev--overlap': overlap }]} href={`#r-${r.id}`}>
              <b>{fmtTime(r.starts_at)}–{fmtTime(r.ends_at)}</b> {r.name ?? (r.erased ? 'Compte supprimé' : '—')}
              <small>{r.service}</small>
              {alertsOf(r).length > 0 && <span class="ev-alert">!<span class="visually-hidden"> fiche de soin : {alertsOf(r).join(', ')}</span></span>}
            </a></li>
          ))}
        </ol>
      ))}
    </div>
  </div>
  {/* Téléphone et tablette : liste par jour, même panneau au clic */}
  <ol class="week" aria-label="La semaine jour par jour">{days.map(({ d, rows }) => (
    <li class:list={['wk', { 'wk--today': d === today }]}>
      <a class="wk-head" href={link(d, 'jour')}>{fmtDay(d)}<small>{rows.length ? `${rows.length} rendez-vous` : 'Libre'}</small></a>
      {rows.length > 0 && <ul>{rows.map((r) => (
        <li><a href={`#r-${r.id}`} class={`ev ev--${tone(r)}`}><b>{fmtTime(r.starts_at)}</b> {r.name ?? (r.erased ? 'Compte supprimé' : '—')}<small>{r.service}</small></a></li>
      ))}</ul>}
    </li>
  ))}</ol>
  {/* Panneau de détail : ouvert par l'ancre #r-id (sans JS), fermé par « Fermer » ; après une action, la page revient sur ce panneau */}
  {shown.map((r) => (
    <aside class="rdv-panel" id={`r-${r.id}`} aria-labelledby={`h-r-${r.id}`}>
      <a class="rdv-close" href="#cal">Fermer<span class="visually-hidden"> le détail</span></a>
      <h2 id={`h-r-${r.id}`}>{fmtTime(r.starts_at)}–{fmtTime(r.ends_at)} <small>{fmtDay(todayBrussels(r.starts_at))}</small></h2>
      <p class="rdv-who">{r.user_id ? <a href={`/admin/clientes/${r.user_id}`}>{r.name ?? r.email}</a> : r.erased ? 'Compte supprimé' : r.name ?? '—'}
        {r.guest && <small> (saisie par l'institut)</small>}{r.deleting && <small> (suppression demandée)</small>}
        {r.phone && <><br><a href={`tel:${r.phone.replace(/[^0-9+]/g, '')}`}>{r.phone}</a></>}
        {r.email && <><br><small>{r.email}</small></>}</p>
      {alertsOf(r).length > 0 && <p class="rdv-alerts">{alertsOf(r).map((a) => <span class="badge badge--alert">{a}</span>)}</p>}
      <p>{r.service}<br>
        <span class={`badge badge--${r.no_show ? 'alert' : TONE[r.status]}`}>{r.no_show ? 'Absente' : STATUS[r.status]}</span>
        {r.late_minutes && <> · Arrivée en retard : {r.late_minutes} min</>}
        <br>Prix {euros(r.price_cents)}{r.discount_cents > 0 && <> · remise −{euros(r.discount_cents)}{r.promo && ` (${r.promo})`}</>}
        {r.deposit_cents > 0 && <><br>Acompte {euros(r.deposit_cents)}{r.paid ? ' payé' : ' non payé'}</>}
        {r.refunded_cents > 0 && <><br>Remboursé {euros(r.refunded_cents)}</>}</p>
      <div class="rdv-acts"><RdvActions r={r} admin={admin} /></div>
    </aside>
  ))}
</>)}
{vue === 'jour' && days.map(({ d, rows }) => (
  <section class:list={['day', { 'day--today': d === today, 'day--empty': rows.length === 0 }]} aria-labelledby={`d-${d}`}>
    <h2 id={`d-${d}`}><a href={link(d, 'jour')}>{fmtDay(d)}</a>{d === today && <span class="badge">Aujourd'hui</span>}
      {rows.length > 0 && <small>{rows.length} rendez-vous</small>}</h2>
    {rows.length === 0 ? <p class="none">Aucun rendez-vous.</p> : (
      <div class="table-wrap"><table class="data-table">
        <thead><tr><th scope="col">Heure</th><th scope="col">Prestation</th><th scope="col">Cliente</th><th scope="col">Statut</th><th scope="col">Montants</th><th scope="col">Actions</th></tr></thead>
        <tbody>{rows.map((r) => (
          <tr id={`r-${r.id}`}>
            <td class="time">{fmtTime(r.starts_at)}<small>{fmtTime(r.ends_at)}</small></td>
            <td>{r.service}</td>
            <td>
              {r.user_id ? <a href={`/admin/clientes/${r.user_id}`}>{r.name ?? r.email}</a> : r.erased ? 'Compte supprimé' : r.name ?? '—'}
              {r.user_id && (careAlerts.get(r.user_id) ?? []).map((a) => <><br><span class="badge badge--alert">{a}</span></>)}
              {r.guest && <small> (saisie par l'institut)</small>}{r.deleting && <small> (suppression demandée)</small>}
              {r.phone && <><br><a href={`tel:${r.phone.replace(/[^0-9+]/g, '')}`}>{r.phone}</a></>}
              {r.email && <><br><small>{r.email}</small></>}
            </td>
            <td>
              <span class={`badge badge--${r.no_show ? 'alert' : TONE[r.status]}`}>{r.no_show ? 'Absente' : STATUS[r.status]}</span>
              {r.late_minutes && <><br><small>Arrivée en retard : {r.late_minutes} min</small></>}
              {r.cancel_reason === 'account_deleted' && <><br><small>Compte supprimé par la cliente</small></>}
              {r.status === 'cancelled' && due(r) > 0 && <><br><small>Acompte gardé ou remboursement à relancer</small></>}
              {r.status === 'expired' && <><br><small>Créneau repris : acompte à rendre</small></>}
            </td>
            <td>
              Prix {euros(r.price_cents)}
              {r.discount_cents > 0 && <><br>Remise −{euros(r.discount_cents)}{r.promo && ` (${r.promo})`}</>}
              {r.deposit_cents > 0 && <><br>Acompte {euros(r.deposit_cents)}{r.paid ? ' payé' : ' non payé'}</>}
              {r.refunded_cents > 0 && <><br>Remboursé {euros(r.refunded_cents)}</>}
            </td>
            <td><RdvActions r={r} admin={admin} /></td>
          </tr>
        ))}</tbody>
      </table></div>
    )}
  </section>
))}
</Admin>

<style>
  .head-acts{display:flex;flex-wrap:wrap;gap:.5rem}
  .toolbar{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;align-items:flex-end;justify-content:space-between;margin:0 0 2rem;padding:1rem;border:1px solid var(--line-soft);border-radius:16px;background:var(--bg)}
  /* Trois liens collés en une seule pastille : se lit comme une navigation, pas comme trois actions */
  .pager{display:flex;flex-wrap:wrap;border:1px solid var(--line-soft);border-radius:999px;overflow:hidden}
  .pager a{display:inline-flex;align-items:center;gap:.35rem;min-height:44px;padding:.5rem 1rem;color:var(--text);text-decoration:none;font-size:.9375rem}
  .pager a + a{border-left:1px solid var(--line-soft)}
  .pager a:hover,.pager a:focus-visible{background:rgb(var(--card))}
  /* Petit écran : flèches seules, le libellé reste lu par les lecteurs d'écran */
  @media (max-width:599px){
    .pager{width:100%;flex-wrap:nowrap}
    .pager a{flex:1;justify-content:center;padding-inline:.5rem}
    .pager a:nth-child(2){flex:2}
    .pager .long{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .pager span[aria-hidden]{font-size:1.4rem;line-height:1}
  }
  .pick{display:flex;flex-wrap:wrap;gap:.75rem;align-items:flex-end}
  .pick .field{min-width:9rem;margin:0}
  .day{margin:0 0 1.75rem}
  .day h2{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem .75rem;margin:0 0 .75rem;font-size:1.35rem}
  .day h2 small{margin-left:auto;font:500 .8125rem var(--f-text);color:var(--text-soft)}
  .day--today h2 a{color:var(--accent)}
  /* Jour vide : une ligne discrète, l'œil va droit aux jours chargés */
  .day--empty{display:flex;flex-wrap:wrap;align-items:baseline;gap:.25rem 1rem;margin-bottom:.75rem;padding:0 0 .75rem;border-bottom:1px dashed var(--line-soft)}
  .day--empty h2{margin:0;font-size:1.05rem;color:var(--text-soft)}
  .none{margin:0;color:var(--text-soft);font-size:.9375rem}
  h2 a{color:inherit;text-decoration:none}
  h2 a:hover{text-decoration:underline}
  .time{font-weight:500;font-variant-numeric:tabular-nums;white-space:nowrap}
  .time small{display:block;font-weight:400;color:var(--text-soft)}
  .cell-form{display:grid;gap:.5rem;justify-items:start}
  /* Vue semaine, ordinateur : colonne des heures + 7 jours ; chaque jour est une grille de lignes de 5 min (6 px, 72 px l'heure) */
  .cal{display:none}
  @media (min-width:1024px){
    .cal{display:block;margin:0 0 2rem;border:1px solid var(--line-soft);border-radius:14px;background:var(--bg);overflow:hidden}
    .cal-head,.cal-body{display:grid;grid-template-columns:3.5rem repeat(7,minmax(0,1fr));column-gap:.35rem;padding:0 .5rem}
    .cal-head{position:sticky;top:0;z-index:2;padding-block:.6rem;border-bottom:1px solid var(--line-soft);background:var(--bg)}
    .cal-day{display:grid;gap:.1rem;color:var(--text);text-decoration:none;font-weight:500;font-size:.875rem;text-transform:capitalize;line-height:1.25}
    .cal-day small{font-weight:400;text-transform:none;color:var(--text-soft);font-size:.75rem}
    .cal-day--today{color:var(--accent)}
    .cal-day:hover{text-decoration:underline}
    .cal-body{padding-block:.5rem}
    .cal-hours,.cal-col{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:6px;list-style:none;margin:0;padding:0}
    .cal-hours li{font-size:.75rem;color:var(--text-soft);font-variant-numeric:tabular-nums;transform:translateY(-.45em)}
    /* Lignes des heures en fond, alignées sur le début de la grille (toujours une heure pleine) */
    .cal-col{background-image:repeating-linear-gradient(to bottom,var(--line-soft) 0 1px,transparent 1px 72px);border-left:1px solid var(--line-soft)}
    .cal-col--today{background-color:rgb(138 90 82 / .06)}
    .cal-fill{pointer-events:none}
    .cal-col li:not(.cal-fill){min-width:0;padding:1px}
  }
  /* Bloc d'un rendez-vous (grille et liste) */
  .ev{display:block;height:100%;overflow:hidden;padding:.3rem .45rem;border-radius:8px;border-left:3px solid var(--accent);background:rgb(138 90 82 / .16);color:var(--text);text-decoration:none;font-size:.78rem;line-height:1.3;position:relative}
  .ev:hover,.ev:focus-visible{background:rgb(138 90 82 / .28)}
  .ev b{font-variant-numeric:tabular-nums;font-weight:600}
  .ev small{display:block;color:var(--text-soft);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ev--past{opacity:.75}
  .ev--wait{border-left-style:dashed;border-left-color:rgb(196 150 70)}
  .ev--noshow{opacity:.55;text-decoration:line-through}
  .ev--off{opacity:.45;text-decoration:line-through;border-left-color:var(--line-soft)}
  /* Chevauchement : bord d'alerte pour le voir d'un coup d'œil */
  .ev--overlap{box-shadow:inset 0 0 0 1px rgb(200 80 70 / .7)}
  .ev-alert{position:absolute;top:.2rem;right:.3rem;display:grid;place-items:center;width:1.1rem;height:1.1rem;border-radius:50%;background:rgb(200 80 70);color:#fff;font-weight:700;font-size:.7rem}
  /* Vue semaine, téléphone et tablette : liste par jour */
  .week{display:grid;gap:.75rem;list-style:none;margin:0 0 2rem;padding:0}
  @media (min-width:1024px){.week{display:none}}
  .wk{display:grid;gap:.5rem;padding:.75rem;border:1px solid var(--line-soft);border-radius:14px;background:var(--bg)}
  .wk--today{border-color:var(--accent)}
  .wk-head{display:grid;gap:.1rem;color:var(--text);text-decoration:none;font-weight:500;text-transform:capitalize}
  .wk-head small{font-weight:400;text-transform:none;color:var(--text-soft);font-size:.8125rem}
  .wk ul{display:grid;gap:.35rem;list-style:none;margin:0;padding:0}
  .wk .ev{min-height:44px}
  /* Panneau de détail : caché, affiché quand son ancre est ciblée (#r-id) */
  .rdv-panel{display:none}
  .rdv-panel:target{display:grid;align-content:start;gap:.75rem;position:fixed;inset:0 0 0 auto;z-index:60;width:min(30rem,100%);overflow-y:auto;padding:1.25rem 1.5rem 2rem;background:var(--surface);border-left:1px solid var(--line-soft);box-shadow:-12px 0 32px rgb(0 0 0 / .25)}
  .rdv-panel h2{margin:0;font-size:1.5rem}
  .rdv-panel h2 small{display:block;font:400 .875rem var(--f-text);color:var(--text-soft);text-transform:capitalize}
  .rdv-panel p{margin:0}
  .rdv-alerts{display:flex;flex-wrap:wrap;gap:.35rem}
  .rdv-close{justify-self:end;display:inline-flex;align-items:center;min-height:44px;padding:0 .75rem}
  .rdv-acts{display:grid;gap:.5rem;padding-top:.75rem;border-top:1px solid var(--line-soft)}
  .cell-form .btn{min-height:44px;padding:.55rem 1rem;white-space:normal;text-align:left;line-height:1.3}
</style>
