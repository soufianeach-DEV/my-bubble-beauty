---
export const prerender = false;
// Agenda : rendez-vous du jour ou de la semaine à l'heure de Bruxelles, annulation en deux temps et remboursement de l'acompte
import Admin from './_layout.astro';
import { adminId, staffId, agendaAction, deleteAction, fmtDay, fmtTime, readForm } from '../../lib/server/admin.ts';
import Supprimer from './_supprimer.astro';
import { alertsFor } from '../../lib/server/profil.ts';
import { addDays, monday } from '../../lib/server/admin-form.ts';
import { adminAgenda } from '../../lib/server/booking.ts';
import { euros, isDay, todayBrussels } from '../../lib/server/pricing.ts';

const me = staffId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
// Suppression d'un rendez-vous : admin seulement
const admin = adminId(Astro.locals) !== null;
const q = Astro.url.searchParams;
const vue = q.get('vue') === 'jour' ? 'jour' : 'semaine';
const today = todayBrussels();
const jour = isDay(q.get('jour')) ? q.get('jour')! : today;
const link = (d: string, v = vue) => `/admin/agenda?jour=${d}&vue=${v}`;
let error = '';
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  const r = form.get('action') === 'delete'
    ? admin ? await deleteAction(form) : { ok: false as const, error: "Seule l'admin peut supprimer un rendez-vous." }
    : await agendaAction(me, form);
  // Déplacé : l'agenda suit le rendez-vous à sa nouvelle date
  if (r.ok) return Astro.redirect(`${link(r.day ?? jour)}&ok=${r.key}#r-${r.id}`, 303);
  error = r.error;
  Astro.response.status = 400;
}
const DONE: Record<string, string> = {
  annule: 'Rendez-vous annulé.',
  supprime: 'Rendez-vous supprimé.',
  rembourse: 'Acompte remboursé, rendez-vous annulé.',
  echec: "Le remboursement n'a pas abouti. S'il reste un acompte à rendre, le bouton « Rembourser l'acompte » reste sur la ligne : réessayez plus tard.",
  cree: 'Rendez-vous enregistré.',
  deplace: 'Rendez-vous déplacé. La cliente reçoit un e-mail si elle a un compte.',
  absente: 'Rendez-vous marqué « absente ».',
  venue: 'Absence retirée.',
  rendu: 'Acompte noté comme remboursé hors du site.',
};
// Le formulaire repart vers l'URL courante : après un refus, le ?ok= du succès précédent ne doit plus s'afficher
const done = !error && DONE[q.get('ok') ?? ''];
const from = vue === 'jour' ? jour : monday(jour);
const count = vue === 'jour' ? 1 : 7;
const rows = await adminAgenda(from, count);
// Badges d'alerte de la fiche de soin, à voir avant le soin
const careAlerts = await alertsFor([...new Set(rows.map((r) => r.user_id).filter((x): x is number => !!x))]);
// Annulés et expirés masqués par défaut (?annules=1 pour les voir) ; ceux qui ont encore un acompte à rendre restent visibles
const showCancelled = q.get('annules') === '1';
const gone = (r: (typeof rows)[number]) => (r.status === 'cancelled' || r.status === 'expired') && !(r.paid && r.deposit_cents - r.refunded_cents > 0);
const hidden = rows.filter(gone).length;
const days = Array.from({ length: count }, (_, i) => addDays(from, i)).map((d) => ({ d, rows: rows.filter((r) => todayBrussels(r.starts_at) === d && (showCancelled || !gone(r))) }));
const STATUS = { confirmed: 'Confirmé', pending_payment: 'Paiement en cours', cancelled: 'Annulé', expired: 'Payé après expiration' };
const TONE = { confirmed: 'ok', pending_payment: 'wait', cancelled: 'off', expired: 'alert' };
// Acompte encaissé et pas encore rendu
const due = (r: (typeof rows)[number]) => (r.paid ? r.deposit_cents - r.refunded_cents : 0);
---
<Admin title="Agenda">
<a slot="actions" class="btn btn--solid" href="/admin/reservations/nouvelle">Saisir un rendez-vous</a>
{done && <p class="notice" role="status">{done}</p>}
{error && <p class="notice notice--error" role="alert">{error}</p>}
{(hidden > 0 || showCancelled) && <p class="hint">{showCancelled ? <a href={link(jour)}>Masquer les rendez-vous annulés</a> : <a href={`${link(jour)}&annules=1`}>Afficher les rendez-vous annulés ({hidden})</a>}</p>}
<div class="toolbar">
<nav class="pager" aria-label="Période">
  <a href={link(addDays(from, -count))}><span aria-hidden="true">‹</span> <span class="long">{vue === 'jour' ? 'Jour précédent' : 'Semaine précédente'}</span></a>
  <a href={link(today)}>Aujourd'hui</a>
  <a href={link(addDays(from, count))}><span class="long">{vue === 'jour' ? 'Jour suivant' : 'Semaine suivante'}</span> <span aria-hidden="true">›</span></a>
</nav>
<form class="pick" method="get" action="/admin/agenda">
  <div class="field"><label for="jour">Jour</label><input id="jour" name="jour" type="date" value={jour} required></div>
  <div class="field"><label for="vue">Affichage</label>
    <select id="vue" name="vue"><option value="semaine" selected={vue === 'semaine'}>Semaine</option><option value="jour" selected={vue === 'jour'}>Jour</option></select>
  </div>
  <button class="btn btn--ghost" type="submit">Afficher</button>
</form>
</div>
{/* Grand écran, vue semaine : les 7 jours côte à côte d'un coup d'œil ; le détail et les actions restent dessous */}
{vue === 'semaine' && (
  <ol class="week" aria-label="La semaine en un coup d'œil">{days.map(({ d, rows }) => {
    const live = rows.filter((r) => r.status === 'confirmed' || r.status === 'pending_payment');
    return (
      <li class:list={['wk', { 'wk--today': d === today, 'wk--empty': live.length === 0 }]}>
        <a class="wk-head" href={link(d, 'jour')}>{fmtDay(d)}<small>{live.length ? `${live.length} rendez-vous` : 'Libre'}</small></a>
        {live.length > 0 && <ul>{live.map((r) => (
          <li><a href={`#r-${r.id}`} class:list={{ 'wk-wait': r.status === 'pending_payment', 'wk-noshow': r.no_show }}>
            <b>{fmtTime(r.starts_at)}</b> {r.name ?? (r.erased ? 'Compte supprimé' : '—')}<small>{r.service}</small>
          </a></li>
        ))}</ul>}
      </li>
    );
  })}</ol>
)}
{days.map(({ d, rows }) => (
  <section class:list={['day', { 'day--today': d === today, 'day--empty': rows.length === 0 }]} aria-labelledby={`d-${d}`}>
    <h2 id={`d-${d}`}><a href={link(d, 'jour')}>{fmtDay(d)}</a>{d === today && <span class="badge">Aujourd'hui</span>}
      {rows.length > 0 && <small>{rows.length} rendez-vous</small>}</h2>
    {rows.length === 0 ? <p class="none">Aucun rendez-vous.</p> : (
      <div class="table-wrap"><table class="data-table">
        <thead><tr><th scope="col">Heure</th><th scope="col">Prestation</th><th scope="col">Cliente</th><th scope="col">Statut</th><th scope="col">Montants</th><th scope="col">Actions</th></tr></thead>
        <tbody>{rows.map((r) => (
          <tr id={`r-${r.id}`}>
            <td class="time">{fmtTime(r.starts_at)}<small>{fmtTime(r.ends_at)}</small></td>
            <td>{r.service}</td>
            <td>
              {r.user_id ? <a href={`/admin/clientes/${r.user_id}`}>{r.name ?? r.email}</a> : r.erased ? 'Compte supprimé' : r.name ?? '—'}
              {r.user_id && (careAlerts.get(r.user_id) ?? []).map((a) => <><br><span class="badge badge--alert">{a}</span></>)}
              {r.guest && <small> (saisie par l'institut)</small>}{r.deleting && <small> (suppression demandée)</small>}
              {r.phone && <><br><a href={`tel:${r.phone.replace(/[^0-9+]/g, '')}`}>{r.phone}</a></>}
              {r.email && <><br><small>{r.email}</small></>}
            </td>
            <td>
              <span class={`badge badge--${r.no_show ? 'alert' : TONE[r.status]}`}>{r.no_show ? 'Absente' : STATUS[r.status]}</span>
              {r.cancel_reason === 'account_deleted' && <><br><small>Compte supprimé par la cliente</small></>}
              {r.status === 'cancelled' && due(r) > 0 && <><br><small>Acompte gardé ou remboursement à relancer</small></>}
              {r.status === 'expired' && <><br><small>Créneau repris : acompte à rendre</small></>}
            </td>
            <td>
              Prix {euros(r.price_cents)}
              {r.discount_cents > 0 && <><br>Remise −{euros(r.discount_cents)}{r.promo && ` (${r.promo})`}</>}
              {r.deposit_cents > 0 && <><br>Acompte {euros(r.deposit_cents)}{r.paid ? ' payé' : ' non payé'}</>}
              {r.refunded_cents > 0 && <><br>Remboursé {euros(r.refunded_cents)}</>}
            </td>
            <td>
              {(r.status === 'confirmed' || r.status === 'pending_payment') && (
                <details class="cancel"><summary>Annuler<span class="visually-hidden"> le rendez-vous de {fmtTime(r.starts_at)}, {r.name ?? r.service}</span></summary>
                  <form class="cell-form" method="post">
                    <input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value={r.id}>
                    {due(r) > 0 && <label class="check"><input type="checkbox" name="refund"><span>Rembourser l'acompte ({euros(due(r))})</span></label>}
                    <button class="btn btn--ghost" type="submit">Confirmer l'annulation</button>
                  </form>
                </details>
              )}
              {(r.status === 'cancelled' || r.status === 'expired') && due(r) > 0 && (
                <form class="cell-form" method="post">
                  <input type="hidden" name="id" value={r.id}>
                  <button class="btn btn--ghost" type="submit" name="action" value="refund">Rembourser l'acompte par Stripe ({euros(due(r))})</button>
                  <button class="btn btn--ghost" type="submit" name="action" value="manual_refund">Marquer remboursé hors site</button>
                </form>
              )}
              {r.status === 'confirmed' && !r.past && (
                <details class="cancel"><summary>Déplacer<span class="visually-hidden"> le rendez-vous de {fmtTime(r.starts_at)}</span></summary>
                  <form class="cell-form" method="post">
                    <input type="hidden" name="action" value="move"><input type="hidden" name="id" value={r.id}>
                    <label class="field">Date<input type="date" name="day" required value={todayBrussels(r.starts_at)}></label>
                    <label class="field">Heure<input type="time" name="time" required step="900" value={fmtTime(r.starts_at)}></label>
                    <button class="btn btn--ghost" type="submit">Confirmer le déplacement</button>
                  </form>
                </details>
              )}
              {r.status === 'confirmed' && r.past && (
                <form class="cell-form" method="post">
                  <input type="hidden" name="id" value={r.id}>
                  <button class="btn btn--ghost" type="submit" name="action" value={r.no_show ? 'show' : 'no_show'}>{r.no_show ? "Retirer l'absence" : 'Marquer absente'}</button>
                </form>
              )}
              {admin && <Supprimer id={r.id} label={`le rendez-vous de ${fmtTime(r.starts_at)}, ${r.name ?? r.service}`} />}
            </td>
          </tr>
        ))}</tbody>
      </table></div>
    )}
  </section>
))}
</Admin>

<style>
  .toolbar{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;align-items:flex-end;justify-content:space-between;margin:0 0 2rem;padding:1rem;border:1px solid var(--line-soft);border-radius:16px;background:var(--bg)}
  /* Trois liens collés en une seule pastille : se lit comme une navigation, pas comme trois actions */
  .pager{display:flex;flex-wrap:wrap;border:1px solid var(--line-soft);border-radius:999px;overflow:hidden}
  .pager a{display:inline-flex;align-items:center;gap:.35rem;min-height:44px;padding:.5rem 1rem;color:var(--text);text-decoration:none;font-size:.9375rem}
  .pager a + a{border-left:1px solid var(--line-soft)}
  .pager a:hover,.pager a:focus-visible{background:rgb(var(--card))}
  /* Petit écran : flèches seules, le libellé reste lu par les lecteurs d'écran */
  @media (max-width:599px){
    .pager{width:100%;flex-wrap:nowrap}
    .pager a{flex:1;justify-content:center;padding-inline:.5rem}
    .pager a:nth-child(2){flex:2}
    .pager .long{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .pager span[aria-hidden]{font-size:1.4rem;line-height:1}
  }
  .pick{display:flex;flex-wrap:wrap;gap:.75rem;align-items:flex-end}
  .pick .field{min-width:9rem;margin:0}
  .day{margin:0 0 1.75rem}
  .day h2{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem .75rem;margin:0 0 .75rem;font-size:1.35rem}
  .day h2 small{margin-left:auto;font:500 .8125rem var(--f-text);color:var(--text-soft)}
  .day--today h2 a{color:var(--accent)}
  /* Jour vide : une ligne discrète, l'œil va droit aux jours chargés */
  .day--empty{display:flex;flex-wrap:wrap;align-items:baseline;gap:.25rem 1rem;margin-bottom:.75rem;padding:0 0 .75rem;border-bottom:1px dashed var(--line-soft)}
  .day--empty h2{margin:0;font-size:1.05rem;color:var(--text-soft)}
  .none{margin:0;color:var(--text-soft);font-size:.9375rem}
  h2 a{color:inherit;text-decoration:none}
  h2 a:hover{text-decoration:underline}
  .time{font-weight:500;font-variant-numeric:tabular-nums;white-space:nowrap}
  .time small{display:block;font-weight:400;color:var(--text-soft)}
  .cell-form{display:grid;gap:.5rem;justify-items:start}
  /* Semaine en 7 colonnes : seulement quand la largeur le permet ; dessous, la liste par jour suffit */
  .week{display:none}
  @media (min-width:1024px){
    .week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:.5rem;list-style:none;margin:0 0 2.5rem;padding:0}
    .wk{display:flex;flex-direction:column;gap:.5rem;min-height:11rem;padding:.75rem;border:1px solid var(--line-soft);border-radius:14px;background:var(--bg)}
    .wk--today{border-color:var(--accent);box-shadow:inset 0 3px 0 var(--accent)}
    .wk--empty{background:none;border-style:dashed}
    .wk-head{display:grid;gap:.15rem;color:var(--text);text-decoration:none;font-weight:500;font-size:.9375rem;text-transform:capitalize}
    .wk-head small{font-weight:400;text-transform:none;color:var(--text-soft);font-size:.8125rem}
    .wk--today .wk-head{color:var(--accent)}
    .wk ul{display:grid;gap:.35rem;list-style:none;margin:0;padding:0}
    .wk ul a{display:grid;padding:.4rem .55rem;border-radius:10px;background:rgb(138 90 82 / .1);color:var(--text);text-decoration:none;font-size:.8125rem;line-height:1.35}
    .wk ul a:hover,.wk ul a:focus-visible{background:rgb(138 90 82 / .2)}
    .wk ul b{font-variant-numeric:tabular-nums}
    .wk ul small{color:var(--text-soft);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .wk-wait{outline:1px dashed rgb(196 150 70 / .7)}
    .wk-noshow{opacity:.6;text-decoration:line-through}
  }
  .cell-form .btn{min-height:44px;padding:.55rem 1rem;white-space:normal;text-align:left;line-height:1.3}
</style>
