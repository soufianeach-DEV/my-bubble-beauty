---
// Composant (préfixe _, hors routage) ; la ligne suivante satisfait le test des routes gardées
export const prerender = false;
// Actions sur un rendez-vous de l'agenda (tableau du jour et panneau de détail de la semaine) : annuler, rembourser,
// déplacer, absence, encaissement, retard, supprimer (admin). Les formulaires repartent vers l'URL courante (agendaAction).
import Supprimer from './_supprimer.astro';
import { fmtDateTime, fmtTime } from '../../lib/server/admin.ts';
import { centsInput } from '../../lib/server/admin-form.ts';
import { PAY_METHODS, type PayMethod, type adminAgenda } from '../../lib/server/booking.ts';
import { euros, todayBrussels } from '../../lib/server/pricing.ts';
interface Props { r: Awaited<ReturnType<typeof adminAgenda>>[number]; admin: boolean }
const { r, admin } = Astro.props;
// Acompte encaissé et pas encore rendu
const due = r.paid ? r.deposit_cents - r.refunded_cents : 0;
---
  {(r.status === 'confirmed' || r.status === 'pending_payment') && (
    <details class="cancel"><summary>Annuler<span class="visually-hidden"> le rendez-vous de {fmtTime(r.starts_at)}, {r.name ?? r.service}</span></summary>
      <form class="cell-form" method="post">
        <input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value={r.id}>
        {due > 0 && <label class="check"><input type="checkbox" name="refund"><span>Rembourser l'acompte ({euros(due)})</span></label>}
        <button class="btn btn--ghost" type="submit">Confirmer l'annulation</button>
      </form>
    </details>
  )}
  {(r.status === 'cancelled' || r.status === 'expired') && due > 0 && (
    <form class="cell-form" method="post">
      <input type="hidden" name="id" value={r.id}>
      <button class="btn btn--ghost" type="submit" name="action" value="refund">Rembourser l'acompte par Stripe ({euros(due)})</button>
      <button class="btn btn--ghost" type="submit" name="action" value="manual_refund">Marquer remboursé hors site</button>
    </form>
  )}
  {r.status === 'confirmed' && !r.past && (
    <details class="cancel"><summary>Déplacer<span class="visually-hidden"> le rendez-vous de {fmtTime(r.starts_at)}</span></summary>
      <form class="cell-form" method="post">
        <input type="hidden" name="action" value="move"><input type="hidden" name="id" value={r.id}>
        <label class="field">Date<input type="date" name="day" required value={todayBrussels(r.starts_at)}></label>
        <label class="field">Heure<input type="time" name="time" required step="900" value={fmtTime(r.starts_at)}></label>
        <button class="btn btn--ghost" type="submit">Confirmer le déplacement</button>
      </form>
    </details>
  )}
  {r.status === 'confirmed' && r.past && (
    <form class="cell-form" method="post">
      <input type="hidden" name="id" value={r.id}>
      <button class="btn btn--ghost" type="submit" name="action" value={r.no_show ? 'show' : 'no_show'}>{r.no_show ? "Retirer l'absence" : 'Marquer absente'}</button>
    </form>
  )}
{r.status === 'confirmed' && r.past && !r.no_show && (r.paid_method ? (
    <form class="cell-form" method="post">
      <input type="hidden" name="id" value={r.id}>
      <small>Encaissé {euros(r.paid_cents ?? 0)} · {PAY_METHODS[r.paid_method as PayMethod]}</small>
      <button class="btn btn--ghost" type="submit" name="action" value="unpay">Retirer l'encaissement</button>
    </form>
  ) : (
    <details class="cancel"><summary>Encaisser<span class="visually-hidden"> le rendez-vous du {fmtDateTime(r.starts_at)}</span></summary>
      <form class="cell-form" method="post">
        <input type="hidden" name="action" value="pay"><input type="hidden" name="id" value={r.id}>
        <label class="field">Mode<select name="method" required>{Object.entries(PAY_METHODS).map(([k, l]) => <option value={k}>{l}</option>)}</select></label>
        <label class="field">Montant payé (€)<input name="amount" required inputmode="decimal" pattern="\d{1,5}([.,]\d{1,2})?" value={centsInput(r.price_cents - r.discount_cents)}></label>
        <button class="btn btn--ghost" type="submit">Noter l'encaissement</button>
      </form>
    </details>
  ))}
  {r.status === 'confirmed' && r.past && !r.no_show && (r.late_minutes ? (
    <form class="cell-form" method="post">
      <input type="hidden" name="id" value={r.id}>
      <button class="btn btn--ghost" type="submit" name="action" value="on_time">Retirer le retard</button>
    </form>
  ) : (
    <details class="cancel"><summary>Arrivée en retard<span class="visually-hidden"> au rendez-vous de {fmtTime(r.starts_at)}</span></summary>
      <form class="cell-form" method="post">
        <input type="hidden" name="action" value="late"><input type="hidden" name="id" value={r.id}>
        <label class="field">Minutes de retard<input type="number" name="late" required min="1" max="240" step="1" inputmode="numeric"></label>
        <button class="btn btn--ghost" type="submit">Noter le retard</button>
      </form>
    </details>
  ))}
  {admin && <Supprimer id={r.id} label={`le rendez-vous de ${fmtTime(r.starts_at)}, ${r.name ?? r.service}`} />}

<style>
  .cell-form{display:grid;gap:.5rem;justify-items:start}
  .cell-form .btn{min-height:44px;padding:.55rem 1rem;white-space:normal;text-align:left;line-height:1.3}
</style>
