---
export const prerender = false;
// Rendez-vous pris par téléphone ou WhatsApp : confirmé tout de suite, jamais sur un autre rendez-vous.
// Cliente choisie dans la liste (le rendez-vous rejoint sa fiche) ou « Nouvelle personne » sans compte.
// Créneaux libres : même calcul que la réservation en ligne (slots) ; une autre heure reste possible, hors horaires avec « Ouvrir exceptionnellement ».
// Sans JS : « Voir les créneaux libres » renvoie la saisie en POST (jamais l'e-mail d'une cliente dans l'URL) ; un créneau est un bouton d'envoi.
import Admin from '../_layout.astro';
import { staffId, byCategory, fmtDay, listServices, newBooking, readForm } from '../../../lib/server/admin.ts';
import { clientLabel, giftClients } from '../../../lib/server/cadeaux.ts';
import { isDay, todayBrussels } from '../../../lib/server/pricing.ts';
import { addDays } from '../../../lib/server/admin-form.ts';
import DayPicker from '../../../components/DayPicker.astro';
const today = todayBrussels();
import { slots } from '../../../lib/server/slots.ts';

const me = staffId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
let error = '';
const sp = Astro.url.searchParams;
const KEYS = ['service', 'day', 'client', 'name', 'phone', 'time'] as const;
// Saisie gardée après un refus ou « Voir les créneaux libres » ; en GET, seule la cliente (?cliente=id) est préremplie
let v: Record<string, string> = { day: todayBrussels() };
const clients = await giftClients();
// Depuis la fiche : « Nouveau rendez-vous pour elle » (?cliente=id)
const pre = sp.get('cliente') ? clients.find((c) => String(c.id) === sp.get('cliente')) : undefined;
if (pre && !v.client) v.client = clientLabel(pre);
// Étape Heure ouverte une fois le jour choisi (clic dans le calendrier ou « Voir les créneaux de ce jour ») ; gardé d'un envoi à l'autre
let dayPicked = false;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  // Un créneau cliqué fixe l'heure ; sinon l'heure saisie à la main
  const slot = String(form.get('slot') ?? '');
  if (slot) form.set('time', slot);
  // Un jour cliqué dans le calendrier : on garde la saisie et on montre les créneaux de ce jour, sans enregistrer
  const pick = String(form.get('pick') ?? '');
  if (isDay(pick)) { form.set('day', pick); form.set('look', 'jour'); }
  // look=1 : prestation choisie (envoi automatique), look=jour : jour choisi ; sans look, on enregistre
  const look = String(form.get('look') ?? '');
  dayPicked = look === 'jour' || form.get('daypicked') === '1' || !look;
  if (!look) {
    const r = await newBooking(me, form);
    if (r.ok) return Astro.redirect(`/admin/agenda?jour=${r.day}&vue=jour&ok=${r.key}#r-${r.id}`, 303);
    error = r.error;
    Astro.response.status = 400;
  }
  v = Object.fromEntries(KEYS.map((k) => [k, String(form.get(k) ?? '').slice(0, 400)]));
  if (!isDay(v.day)) v.day = todayBrussels();
}
const services = (await listServices()).filter((s) => s.duration_min !== null);
const groups = byCategory(services).filter((g) => g.items.length);
const svc = services.find((s) => String(s.id) === v.service);
const free = svc && svc.active && isDay(v.day) ? await slots(Number(svc.id), v.day) : [];
const guestOpen = !v.client && !!(v.name || v.phone);
// Pas à pas : Cliente → Soin → Date → Heure. Une étape reste repliée tant que la précédente est vide ; une étape déjà remplie
// reste ouverte (retour avec erreur, cliente préremplie depuis sa fiche). Sans JS, tout est visible (:root[data-js] dans le CSS).
const locked = { soin: !(v.client || v.name) && !v.service, date: !v.service, heure: !(v.service && dayPicked) };
// Heure à la main : liste déroulante par quart d'heure de 7 h à 21 h 45 ; une heure saisie autrement (ex. 10:05) reste proposée
const TIMES = Array.from({ length: 60 }, (_, i) => `${String(7 + Math.floor(i / 4)).padStart(2, '0')}:${String((i % 4) * 15).padStart(2, '0')}`);
if (/^\d{2}:\d{2}$/.test(v.time ?? '') && !TIMES.includes(v.time)) { TIMES.push(v.time); TIMES.sort(); }
---
<Admin title="Nouveau rendez-vous">
<p class="lead">Pour un rendez-vous pris par téléphone ou WhatsApp. Il est confirmé tout de suite. Un chevauchement avec un autre rendez-vous est toujours refusé.</p>
{error && <p class="notice notice--error" role="alert">{error}</p>}
{groups.length === 0 ? (
  <p class="notice">Aucune prestation n'a encore de durée. Complétez d'abord les durées dans <a href="/admin/prestations">Prestations</a>.</p>
) : (
  <form class="nb" method="post" action="/admin/reservations/nouvelle">
    <div class="nb-col">
      <fieldset class="step">
        <legend><span class="step-n" aria-hidden="true">1</span> Cliente</legend>
        <div class="field"><label for="client">Chercher une cliente (nom ou e-mail)</label>
          <input id="client" name="client" list="clientes" maxlength="400" value={v.client} autocomplete="off" aria-describedby="client-hint">
          <datalist id="clientes">{clients.map((c) => <option value={clientLabel(c)} />)}</datalist>
          <p class="hint" id="client-hint">Le rendez-vous rejoint sa fiche, sa carte de fidélité et son historique.</p></div>
        <details class="guest" open={guestOpen}>
          <summary>Nouvelle personne, sans compte</summary>
          <div class="field"><label for="name">Nom</label><input id="name" name="name" maxlength="100" autocomplete="off" value={v.name}></div>
          <div class="field"><label for="phone">Téléphone (facultatif)</label>
            <input id="phone" name="phone" type="tel" maxlength="30" autocomplete="off" value={v.phone} aria-describedby="phone-hint">
            <span class="hint" id="phone-hint">Effacé automatiquement 3 ans après le rendez-vous.</span></div>
          <p class="hint">Laissez « Chercher une cliente » vide pour une personne sans compte.</p>
        </details>
      </fieldset>
      <fieldset class="step" data-step="soin" data-locked={locked.soin || undefined}>
        <legend><span class="step-n" aria-hidden="true">2</span> Soin</legend>
        <p class="step-wait">Choisissez d'abord la cliente.</p>
        <div class="field"><label for="service">Prestation</label>
          {/* Choisir la prestation affiche tout de suite les créneaux (main.js, data-autolook) ; sans JS, « Voir les créneaux libres » */}
          <select id="service" name="service" required data-autolook>
            <option value="">Choisir…</option>
            {groups.map((g) => (
              <optgroup label={g.label}>{g.items.map((s) => <option value={s.id} selected={String(s.id) === v.service}>{s.name_fr} ({s.duration_min} min){!s.active && ' — non proposée en ligne'}</option>)}</optgroup>
            ))}
          </select></div>
      </fieldset>
    </div>
    <div class="nb-col">
      <fieldset class="step" data-step="date" data-locked={locked.date || undefined}>
        <legend><span class="step-n" aria-hidden="true">3</span> Date</legend>
        <p class="step-wait">Choisissez d'abord le soin.</p>
        {/* Même calendrier que la réservation en ligne ; un jour fermé reste choisissable (« Ouvrir exceptionnellement ») */}
        <p class="dp-label" id="day-label">Date : <strong>{fmtDay(v.day)}</strong></p>
        <input type="hidden" name="day" value={v.day}>
        <DayPicker lang="fr" day={v.day} today={today} lastDay={addDays(today, 365)} label="Date du rendez-vous" soft name="pick" />
        <button class="btn btn--ghost" type="submit" name="look" value="jour" formnovalidate>Voir les créneaux de ce jour</button>
        {dayPicked && <input type="hidden" name="daypicked" value="1">}
      </fieldset>
    </div>
    <div class="nb-col">
      <fieldset class="step" data-step="heure" data-locked={locked.heure || undefined}>
        <legend><span class="step-n" aria-hidden="true">4</span> Heure</legend>
        <p class="step-wait">Choisissez d'abord le jour dans le calendrier.</p>
        {!svc ? <p class="hint">Choisissez une prestation et une date : les créneaux libres s'affichent ici.</p>
          : !svc.active ? <p class="hint">Cette prestation n'est pas proposée en ligne : pas de créneaux calculés. Choisissez l'heure dans la liste.</p>
          : free.length === 0 ? <p class="hint">Aucun créneau libre le {fmtDay(v.day)} (fermé, complet, ou moins de 2 h d'avance). Choisissez une autre heure dans la liste si besoin.</p>
          : <>
            <p class="hint">Créneaux libres le {fmtDay(v.day)} pour {svc.name_fr} ({svc.duration_min} min). Un clic enregistre le rendez-vous.</p>
            <div class="slots">{free.map((s) => <button class="btn btn--ghost" type="submit" name="slot" value={s.label}>{s.label}</button>)}</div>
          </>}
        {/* Autre heure toujours visible : liste déroulante plutôt que le champ horaire du navigateur */}
        <div class="other">
          <div class="field"><label for="time">{free.length ? 'Ou une autre heure (Bruxelles)' : 'Heure de début (Bruxelles)'}</label>
            <select id="time" name="time"><option value="">Choisir une heure…</option>{TIMES.map((t) => <option value={t} selected={t === v.time}>{t}</option>)}</select></div>
          <label class="check"><input type="checkbox" name="force"><span>Ouvrir exceptionnellement (jour fermé ou hors des heures d'ouverture)</span></label>
          <button class="btn btn--solid" type="submit">Enregistrer le rendez-vous</button>
        </div>
      </fieldset>
    </div>
  </form>
)}
</Admin>

<style>
  .lead{max-width:60rem}
  .nb{display:grid;gap:1.25rem;align-items:start}
  /* Une ligne : cliente et soin, calendrier au milieu, heures à droite */
  @media (min-width:1200px){.nb{grid-template-columns:repeat(3,minmax(0,1fr))}}
  .nb-col{display:grid;gap:1.25rem;min-width:0}
  /* Étapes numérotées ; repliées (titre et consigne seuls) tant que la précédente est vide, seulement si le JS tourne */
  .step-n{display:inline-grid;place-items:center;width:1.6rem;height:1.6rem;margin-right:.35rem;border-radius:50%;background:var(--accent);color:var(--accent-ink);font-size:.8125rem;font-weight:600}
  .step-wait{display:none;margin:0;color:var(--text-soft)}
  :global(:root[data-js]) .step[data-locked]{opacity:.65}
  /* :global sur l'enfant : le calendrier est un composant (autre portée de style) */
  :global(:root[data-js]) .step[data-locked] > :global(:not(legend):not(.step-wait)){display:none}
  :global(:root[data-js]) .step[data-locked] .step-wait{display:block}
  :global(:root[data-js]) .step[data-locked] .step-n{background:var(--line-soft);color:var(--text)}
  .step{transition:opacity var(--dur-ui)}
  /* Colonne bornée : une prestation au nom long ou le calendrier ne poussent plus le cadre hors de l'écran (375 px) */
  fieldset{display:grid;grid-template-columns:minmax(0,1fr);gap:.85rem;margin:0;padding:1rem 1.25rem;border:1px solid var(--line-soft);border-radius:14px;min-width:0}
  .dp-label{margin:0}
  /* Le calendrier remplit toute la colonne du milieu */
  fieldset :global(.daypick){max-width:none;margin:0}
  legend{font-weight:600;padding:0 .3rem}
  .field{margin:0}
  .field :is(input,select){width:100%}
  fieldset > .btn{justify-self:start;min-height:44px}
  details summary{cursor:pointer;min-height:44px;display:flex;align-items:center;color:var(--link);text-decoration:underline;text-underline-offset:.2em}
  details[open] summary{margin-bottom:.5rem}
  details{display:grid;gap:.75rem}
  details > .btn{justify-self:start;min-height:44px}
  .other{display:grid;gap:.75rem;padding-top:.75rem;border-top:1px solid var(--line-soft)}
  .other > .btn{justify-self:start;min-height:44px}
  .slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(5.5rem,1fr));gap:.5rem}
  .slots .btn{min-height:44px;padding:.4rem .5rem;justify-content:center}
  .check{display:flex;align-items:center;gap:.5rem;min-height:44px}
  .check input{width:1.25rem;height:1.25rem;margin:0;accent-color:var(--accent)}
</style>
