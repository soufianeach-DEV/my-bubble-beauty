---
export const prerender = false;
// Utilisateurs : l'équipe de l'institut (admin, gestionnaire). Rôle donné à un compte existant, changé, retiré ; compte désactivé,
// supprimé (suppression douce) ou restauré ; application d'authentification relancée. Admin seulement, jamais sur soi ni sur la gérante.
import Admin from './_layout.astro';
import { adminId, fmtDateTime, readForm } from '../../lib/server/admin.ts';
import { ACCOUNTS_PER_PAGE, ENROL_DAYS, listAccounts, listStaff, ROLE_LABELS, staffAction, type AccountSort } from '../../lib/server/staff.ts';

const me = adminId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
let error = '';
let errorId: number | null = null;
let draft = { email: '', role: 'gestionnaire' };
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  const r = await staffAction(me, form);
  if (r.ok) return Astro.redirect(`/admin/utilisateurs?ok=${r.key}#u-${r.id}`, 303);
  error = r.error;
  errorId = Number(form.get('id')) || null;
  if (form.get('action') === 'grant') draft = { email: String(form.get('email') ?? '').slice(0, 254), role: String(form.get('role') ?? 'gestionnaire') };
  Astro.response.status = 400;
}
const DONE: Record<string, string> = {
  grant: `Rôle enregistré. La personne se connecte avec son compte habituel et enregistre son application d'authentification dans les ${ENROL_DAYS} jours.`,
  role: 'Rôle changé.', demote: 'Rôle retiré : le compte redevient un compte client et ses sessions sont fermées.',
  block: 'Compte désactivé : la personne est déconnectée et ne peut plus se connecter.', unblock: 'Compte réactivé.',
  remove: 'Compte supprimé : il est masqué et ne peut plus se connecter. Son historique reste.', restore: 'Compte restauré.',
  reset_totp: `Application d'authentification relancée : la personne en enregistre une nouvelle dans les ${ENROL_DAYS} jours.`,
};
const done = !error && DONE[Astro.url.searchParams.get('ok') ?? ''];
// « Tous les comptes » : recherche, tri et page dans l'URL (GET), gardés après une action
const qs = Astro.url.searchParams;
const q = (qs.get('q') ?? '').trim().slice(0, 100);
const sort: AccountSort = qs.get('tri') === 'nom' ? 'nom' : qs.get('tri') === 'connexion' ? 'connexion' : 'recent';
const pageNo = Math.min(Math.max(Number(qs.get('page')) || 1, 1), 10_000);
const [all, accounts] = await Promise.all([listStaff(), listAccounts(q, sort, pageNo)]);
const pages = Math.max(1, Math.ceil(accounts.total / ACCOUNTS_PER_PAGE));
const listUrl = (p: number) => `/admin/utilisateurs?${new URLSearchParams({ ...(q && { q }), ...(sort !== 'recent' && { tri: sort }), ...(p > 1 && { page: String(p) }) })}#h-all`;
// Anciens membres : comptes de l'équipe supprimés, restaurables ; ils n'ont plus aucun accès (connexion refusée)
const staff = all.filter((s) => !s.removed_at);
const former = all.filter((s) => s.removed_at);
const day = new Intl.DateTimeFormat('fr-BE', { timeZone: 'Europe/Brussels', dateStyle: 'medium' }).format;
---
<Admin title="Utilisateurs">
{done && <p class="notice" role="status">{done}</p>}
{error && errorId === null && <p class="notice notice--error" role="alert">{error}</p>}

<details class="add-box" open={draft.email !== ''}>
<summary>Ajouter par adresse e-mail</summary>
<section aria-labelledby="h-add">
  <h2 id="h-add" class="visually-hidden">Ajouter un admin ou un gestionnaire</h2>
  <p class="hint">La personne crée d'abord son compte sur le site et confirme son adresse. Admin : tout l'espace. Gestionnaire : accueil, agenda, rendez-vous, fiches clientes (notes comprises), prestations et fermetures, sans horaires d'ouverture, codes promo, journal, métriques ni utilisateurs.</p>
  <form class="form add" method="post">
    <input type="hidden" name="action" value="grant">
    <div class="field grow"><label for="email">Adresse e-mail du compte</label><input id="email" name="email" type="email" value={draft.email} maxlength="254" autocomplete="off" required></div>
    <div class="field"><label for="role">Rôle</label>
      <select id="role" name="role">
        <option value="gestionnaire" selected={draft.role !== 'admin'}>Gestionnaire</option>
        <option value="admin" selected={draft.role === 'admin'}>Admin</option>
      </select>
    </div>
    <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
    <button class="btn btn--solid" type="submit">Ajouter</button>
  </form>
</section>
</details>

<section aria-labelledby="h-team">
  <h2 id="h-team">Équipe <small>({staff.length})</small></h2>
  <ul class="team">{staff.map((s) => {
    const locked = s.role === 'super' || s.id === me;
    const totp = s.role === 'super' ? 'Code de la gérante' : s.totp_confirmed_at ? 'Application enregistrée' : s.enrol_until ? `Application à enregistrer avant le ${day(s.enrol_until)}` : "Délai pour enregistrer l'application passé";
    return (
    <li id={`u-${s.id}`} class:list={['member', { 'member--off': s.blocked_at || s.removed_at }]}>
      <div class="who">
        <strong>{s.name || s.email}</strong>{s.name && <small>{s.email}</small>}
        <p class="tags">
          <span class={s.role === 'gestionnaire' ? 'badge' : 'badge badge--ok'}>{ROLE_LABELS[s.role]}</span>
          {s.blocked_at && <span class="badge badge--alert">Désactivé le {day(s.blocked_at)}</span>}
          {s.removed_at && <span class="badge badge--alert">Supprimé le {day(s.removed_at)}</span>}
          <span class={s.totp_confirmed_at || s.role === 'super' ? 'badge' : 'badge badge--wait'}>{totp}</span>
        </p>
        <small>Statut : {s.blocked_at ? 'désactivé' : s.role !== 'super' && !s.totp_confirmed_at ? "application d'authentification en attente" : 'actif'} · dernière connexion : {s.last_login ? fmtDateTime(s.last_login) : 'jamais'}</small>
        {s.role_at && s.role !== 'super' && <small>Dans l'équipe depuis le {fmtDateTime(s.role_at)}</small>}
      </div>
      {errorId === s.id && <p class="notice notice--error" role="alert">{error}</p>}
      {locked ? <p class="hint">{s.role === 'super' ? 'Compte de la gérante : il ne peut être ni rétrogradé, ni désactivé, ni supprimé.' : 'Votre compte : une autre admin peut le modifier.'}</p> : (
        <details class="manage" open={errorId === s.id}>
          <summary>Modifier</summary>
          <div class="acts">
            <form class="act" method="post">
              <input type="hidden" name="action" value="role"><input type="hidden" name="id" value={s.id}>
              <div class="field"><label for={`r-${s.id}`}>Rôle</label>
                <select id={`r-${s.id}`} name="role">
                  <option value="gestionnaire" selected={s.role === 'gestionnaire'}>Gestionnaire</option>
                  <option value="admin" selected={s.role === 'admin'}>Admin</option>
                </select>
              </div>
              <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
              <button class="btn btn--ghost" type="submit">Changer le rôle</button>
            </form>
            <form class="act" method="post">
              <input type="hidden" name="action" value={s.blocked_at ? 'unblock' : 'block'}><input type="hidden" name="id" value={s.id}>
              <p class="hint">{s.blocked_at ? 'La personne pourra de nouveau se connecter.' : 'Déconnecte la personne et bloque sa connexion. Réactivable.'}</p>
              <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
              <button class="btn btn--ghost" type="submit">{s.blocked_at ? 'Réactiver' : 'Désactiver'}</button>
            </form>
            <form class="act" method="post">
              <input type="hidden" name="action" value={s.removed_at ? 'restore' : 'remove'}><input type="hidden" name="id" value={s.id}>
              <p class="hint">{s.removed_at ? "Le compte redevient utilisable (sauf s'il est aussi désactivé)." : "Retire tout accès : sessions fermées, connexion refusée, compte masqué. Il passe dans « Anciens membres », restaurable."}</p>
              <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
              <button class="btn btn--ghost" type="submit">{s.removed_at ? 'Restaurer' : 'Supprimer'}</button>
            </form>
            <form class="act" method="post">
              <input type="hidden" name="action" value="reset_totp"><input type="hidden" name="id" value={s.id}>
              <p class="hint">Téléphone perdu ou délai passé : la personne enregistre une nouvelle application à sa prochaine connexion.</p>
              <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
              <button class="btn btn--ghost" type="submit">Relancer l'application</button>
            </form>
            <form class="act" method="post">
              <input type="hidden" name="action" value="demote"><input type="hidden" name="id" value={s.id}>
              <p class="hint">Le compte redevient un compte client, sans accès à l'administration.</p>
              <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
              <button class="btn btn--ghost" type="submit">Retirer de l'équipe</button>
            </form>
          </div>
        </details>
      )}
    </li>
  ); })}</ul>
</section>

<section aria-labelledby="h-all">
  <h2 id="h-all">Tous les comptes <small>({accounts.total})</small></h2>
  <p class="hint">Comptes clients, hors équipe et hors comptes supprimés. Choisissez un rôle sur la ligne : la personne passe dans « Équipe » et ses sessions sont fermées. Il faut une adresse confirmée.</p>
  <form class="form find" method="get" action="/admin/utilisateurs#h-all">
    <div class="field grow"><label for="q">Rechercher (nom ou e-mail)</label><input id="q" name="q" type="search" value={q} maxlength="100"></div>
    <div class="field"><label for="tri">Trier par</label>
      <select id="tri" name="tri">
        <option value="recent" selected={sort === 'recent'}>Inscription récente</option>
        <option value="nom" selected={sort === 'nom'}>Nom</option>
        <option value="connexion" selected={sort === 'connexion'}>Dernière connexion</option>
      </select>
    </div>
    <button class="btn btn--ghost" type="submit">Afficher</button>
  </form>
  {accounts.rows.length === 0 ? <p>Aucun compte{q && ' pour cette recherche'}.</p> : (
  <ul class="team">{accounts.rows.map((a) => (
    <li id={`u-${a.id}`} class="member account">
      <div class="who">
        <strong>{a.name || a.email}</strong>{a.name && <small>{a.email}</small>}
        <p class="tags"><span class={a.verified ? 'badge badge--ok' : 'badge badge--wait'}>{a.verified ? 'Adresse confirmée' : 'Adresse non confirmée'}</span></p>
        <small>Inscrite le {day(a.created_at)} · dernière connexion : {a.last_login ? fmtDateTime(a.last_login) : 'jamais'}</small>
      </div>
      {errorId === a.id && <p class="notice notice--error" role="alert">{error}</p>}
      {a.verified ? (
        <form class="assign" method="post">
          <input type="hidden" name="action" value="assign"><input type="hidden" name="id" value={a.id}>
          <div class="field"><label for={`r-${a.id}`}>Rôle</label>
            <select id={`r-${a.id}`} name="role">
              <option value="none" selected>Aucun (cliente)</option>
              <option value="gestionnaire">Gestionnaire</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
          <button class="btn btn--ghost" type="submit">Appliquer</button>
        </form>
      ) : <p class="hint">Rôle possible une fois l'adresse confirmée.</p>}
    </li>
  ))}</ul>
  )}
  {pages > 1 && <nav class="pager" aria-label="Pages des comptes">
    {pageNo > 1 && <a class="btn btn--ghost" href={listUrl(pageNo - 1)}>Page précédente</a>}
    <span>Page {pageNo} sur {pages}</span>
    {pageNo < pages && <a class="btn btn--ghost" href={listUrl(pageNo + 1)}>Page suivante</a>}
  </nav>}
</section>

<section aria-labelledby="h-former">
  <h2 id="h-former">Anciens membres <small>({former.length})</small></h2>
  {former.length === 0 ? <p>Aucun.</p> : (
  <ul class="team">{former.map((s) => (
    <li id={`u-${s.id}`} class="member member--off">
      <div class="who"><strong>{s.name || s.email}</strong>{s.name && <small>{s.email}</small>}
        <p class="tags"><span class="badge">{ROLE_LABELS[s.role]}</span><span class="badge badge--alert">Supprimé le {day(s.removed_at!)}</span></p>
        <small>Dernière connexion : {s.last_login ? fmtDateTime(s.last_login) : 'jamais'}</small></div>
      {errorId === s.id && <p class="notice notice--error" role="alert">{error}</p>}
      <form class="act" method="post">
        <input type="hidden" name="action" value="restore"><input type="hidden" name="id" value={s.id}>
        <p class="hint">Rend l'accès avec le même rôle{s.blocked_at ? ' (le compte reste désactivé : réactivez-le ensuite)' : ''}.</p>
        <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
        <button class="btn btn--ghost" type="submit">Restaurer</button>
      </form>
      <form class="act" method="post">
        <input type="hidden" name="action" value="demote"><input type="hidden" name="id" value={s.id}>
        <p class="hint">Retire définitivement le rôle : le compte redevient un compte client (toujours supprimé).</p>
        <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
        <button class="btn btn--ghost" type="submit">Retirer le rôle</button>
      </form>
    </li>
  ))}</ul>)}
</section>
</Admin>

<style>
  section{margin-bottom:2rem}
  .add{display:flex;flex-wrap:wrap;gap:.75rem 1rem;align-items:flex-end}
  .add .grow{flex:1 1 16rem;min-width:0}
  select{min-height:44px;padding:.4rem .6rem;border:1px solid var(--line-soft);border-radius:8px;background:rgb(var(--card));color:var(--text);font:inherit}
  .add-box{margin-bottom:2rem}
  .add-box > summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font-weight:500}
  .find,.assign{display:flex;flex-wrap:wrap;gap:.5rem 1rem;align-items:flex-end}
  .find .grow{flex:1 1 16rem;min-width:0}
  .find .field,.assign .field{margin:0}
  .account{grid-template-columns:minmax(0,1fr) auto;align-items:center}
  @media (max-width:719px){.account{grid-template-columns:1fr}}
  .pager{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;margin-top:1rem}
  .check{display:flex;align-items:center;gap:.5rem;min-height:44px}
  .check input{width:1.25rem;height:1.25rem;margin:0;accent-color:var(--accent)}
  .team{display:grid;gap:.75rem;list-style:none;margin:0;padding:0}
  .member{display:grid;gap:.75rem;padding:1rem 1.25rem;border:1px solid var(--line-soft);border-radius:16px;background:var(--bg);scroll-margin-top:1rem}
  .member--off{opacity:.8}
  .who{display:grid;gap:.25rem;min-width:0;overflow-wrap:anywhere}
  .who small{color:var(--text-soft)}
  .tags{display:flex;flex-wrap:wrap;gap:.4rem;margin:.25rem 0 0}
  .member .notice,.member .hint{margin:0}
  h2 small{font-size:1rem;color:var(--text-soft)}
  .manage summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font-weight:500}
  /* Une carte par action : côte à côte sur ordinateur, l'une sous l'autre sur téléphone */
  .acts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr));gap:.75rem;margin-top:.5rem}
  .act{display:grid;gap:.5rem;align-content:start;padding:.85rem 1rem;border:1px solid var(--line-soft);border-radius:12px}
  .act .btn{min-height:44px;padding:.55rem 1rem;justify-self:start}
</style>
