---
export const prerender = false;
// Fiche cliente : coordonnées, état du compte, statistiques, notes (données de santé seulement avec son accord), rendez-vous,
// absences et acomptes à rendre, désactivation, suppression, effacement à sa demande, dernières lignes du journal la concernant.
// La gestionnaire voit la fiche et écrit les notes ; les actions sur le compte et le journal restent à l'admin.
import Admin from '../_layout.astro';
import { adminId, staffId, agendaAction, deleteAction, fmtDateTime, readForm } from '../../../lib/server/admin.ts';
import Supprimer from '../_supprimer.astro';
import FicheForm from '../_fiche-form.astro';
import { clientAction, clientDetail } from '../../../lib/server/admin-clientes.ts';
import { ACTION_LABELS } from '../../../lib/server/journal.ts';
import { euros, todayBrussels } from '../../../lib/server/pricing.ts';
import { centsInput } from '../../../lib/server/admin-form.ts';
import { PAY_METHODS, type PayMethod } from '../../../lib/server/booking.ts';
import { rdvStatus } from '../../../lib/server/statut.ts';
import { GRACE_DAYS } from '../../../lib/server/rgpd.ts';
import { FORMS, KINDS, listConsents } from '../../../lib/server/consentements.ts';
import { suivi, suiviAction } from '../../../lib/server/suivi.ts';
import { clientGifts, STATE_LABELS as GIFT_STATES } from '../../../lib/server/cadeaux.ts';
import { applyReward, loyaltyCard, rewardableBookings } from '../../../lib/server/fidelite.ts';
import { clientPackages, saleLines, sellPackage, stopPackage, STATE_LABELS as PACKAGE_STATES } from '../../../lib/server/forfaits.ts';
import { ALLERGIES, AMBIENCE, alertsOf, COVER, HEAT, PRESSURE, readProfile, saveProfile, SKIN, TOUCH, withDraft, ZONES } from '../../../lib/server/profil.ts';

const me = staffId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
const manage = adminId(Astro.locals) !== null;
const id = /^[1-9]\d{0,17}$/.test(Astro.params.id ?? '') ? Number(Astro.params.id) : null;
if (!id) return new Response(null, { status: 404 });
const self = `/admin/clientes/${id}`;
let error = '';
let historyDraft: string | null = null;
let birthDraft: string | null = null;
let profDraft: FormData | null = null;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  // Les actions sur un rendez-vous passent par l'agenda (mêmes règles et même journal)
  const scope = form.get('scope');
  const r = form.get('action') === 'delete' ? (manage ? await deleteAction(form) : { ok: false as const, error: "Seule l'admin peut supprimer un rendez-vous." }) : scope === 'booking' ? await agendaAction(me, form) : scope === 'suivi' ? await suiviAction(me, form) : scope === 'fidelite' ? await applyReward(me, form) : scope === 'profil' ? await saveProfile(me, id, form) : scope === 'forfait' ? await (form.get('action') === 'stop' ? stopPackage : sellPackage)(me, id, form) : await clientAction(me, form, manage);
  if (r.ok && r.key === 'efface') return Astro.redirect('/admin/clientes?ok=efface', 303);
  if (r.ok) return Astro.redirect(`${self}?ok=${r.key}${r.id !== id && r.key !== 'supprime' ? `#b-${r.id}` : ''}`, 303);
  error = r.error;
  if (form.get('action') === 'health') {
    historyDraft = String(form.get('medical_history') ?? '').slice(0, 4000);
    birthDraft = String(form.get('birth_date') ?? '').slice(0, 10);
  }
  if (form.get('scope') === 'profil') profDraft = form;
  Astro.response.status = 400;
}
const c = await clientDetail(id);
if (!c) return new Response(null, { status: 404 });
const { user: u, bookings, stats, events } = c;
// Rendez-vous à venir : signalés avant une suppression (ils restent dans l'agenda)
const upcoming = bookings.filter((b) => !b.past && b.status === 'confirmed');
// Bons cadeaux rattachés à la cliente (pages des bons : admin seulement)
const gifts = manage ? await clientGifts(u.id) : [];
const [consents, sv, card, rewardable, prof, packages, lines] = await Promise.all([listConsents(u.id), suivi(u.id), loyaltyCard(u.id), rewardableBookings(u.id), readProfile(u.id), clientPackages(u.id), saleLines()]);
// Badges d'alerte d'après la fiche enregistrée ; après un refus, le formulaire réaffiche toute la saisie, pas seulement les notes
const careAlerts = alertsOf(prof.care, prof.health);
if (profDraft) withDraft(prof, profDraft);
// Lecture de la fiche : [titre, valeurs, alerte] ; seules les lignes renseignées s'affichent
const pick = <T extends Record<string, string>>(o: T, keys: string[] | undefined, other?: string) => [...(keys ?? []).filter((k) => k !== 'autre' || !other).map((k) => o[k as keyof T] ?? k), ...(other ? [other] : [])];
const sheetRows = ([
  ['Allergies', pick(ALLERGIES, prof.health?.allergies, prof.health?.allergies_other), true],
  ['Peau', pick(SKIN, prof.health?.skin), false],
  ['Contre-indications', prof.health?.contra ? [prof.health.contra] : [], true],
  ['Ne pas toucher', pick(ZONES, prof.care.zones, prof.care.zones_other), true],
  ['Toucher', prof.care.touch ? [TOUCH[prof.care.touch as keyof typeof TOUCH]] : [], prof.care.touch === 'limite' || prof.care.touch === 'prevenir'],
  ['Chaleur', prof.care.heat ? [HEAT[prof.care.heat as keyof typeof HEAT]] : [], false],
  ['Couverture', prof.care.cover ? [COVER[prof.care.cover as keyof typeof COVER]] : [], false],
  ['Pression', prof.care.pressure ? [PRESSURE[prof.care.pressure as keyof typeof PRESSURE]] : [], false],
  ['Ambiance', prof.care.ambience ? [AMBIENCE[prof.care.ambience as keyof typeof AMBIENCE]] : [], false],
  ['Odeurs', prof.care.scents ? [prof.care.scents] : [], false],
] as [string, (string | undefined)[], boolean][]).map(([t, v, a]) => [t, v.filter(Boolean) as string[], a] as const).filter(([, v]) => v.length > 0);
const DONE: Record<string, string> = {
  notes: 'Fiche de soin enregistrée.', supprime: 'Rendez-vous supprimé.', sante: 'Date de naissance et antécédents enregistrés.', 'fidelite-remise': 'Remise de fidélité appliquée au rendez-vous.', 'fidelite-offert': 'Soin offert appliqué au rendez-vous : la carte repart à zéro.', seance: 'Séance mise à jour.', block: 'Compte désactivé : la cliente est déconnectée et ne peut plus se connecter.', unblock: 'Compte réactivé.',
  remove: "Compte supprimé : il n'apparaît plus dans les listes et ne peut plus se connecter. Ses rendez-vous restent.", unremove: 'Compte restauré : la cliente peut de nouveau se connecter.', restore: 'Suppression annulée : le compte est de nouveau actif. Les rendez-vous annulés le restent.',
  absente: 'Rendez-vous marqué « absente ».', venue: 'Absence retirée.', retard: 'Retard noté.', aheure: 'Retard retiré.', encaisse: 'Encaissement noté.', nonencaisse: 'Encaissement retiré.', 'forfait-vendu': 'Forfait vendu : les séances de ce soin seront prises dessus à la réservation.', 'forfait-arrete': 'Forfait arrêté : plus aucune séance ne sera prise dessus. Le remboursement éventuel se fait à l’institut.', horsforfait: 'Rendez-vous retiré du forfait : la séance est rendue, le prix de la carte s’applique.', rendu: 'Acompte noté comme remboursé hors du site.',
};
const done = !error && DONE[Astro.url.searchParams.get('ok') ?? ''];
const day = new Intl.DateTimeFormat('fr-BE', { timeZone: 'Europe/Brussels', dateStyle: 'long' }).format;
const STATUS: Record<string, string> = { confirmed: 'Confirmé', pending_payment: 'Paiement en cours', cancelled: 'Annulé', expired: 'Payé après expiration' };
const REASON: Record<string, string> = { client: 'par la cliente', admin: "par l'institut", account_deleted: 'compte supprimé' };
const due = (b: (typeof bookings)[number]) => (b.paid ? b.deposit_cents - b.refunded_cents : 0);
const purgeOn = u.deleted_at && new Date(u.deleted_at.getTime() + GRACE_DAYS * 86_400_000);
const LANGS: Record<string, string> = { fr: 'français', nl: 'néerlandais', en: 'anglais' };
const tel = (p: string) => `tel:${p.replace(/[^0-9+]/g, '')}`;
const dmy = (d: string) => d.split('-').reverse().join('/');
const PACKAGE_TONE = { actif: 'ok', epuise: 'wait', expire: 'alert', arrete: 'alert' } as const;
const canSell = !u.blocked_at && !u.removed_at && !u.deleted_at;
---
<Admin title={u.name || u.email}>
{done && <p class="notice" role="status">{done}</p>}
{error && <p class="notice notice--error" role="alert">{error}</p>}
<p class="fiche-top"><a href="/admin/clientes">← Toutes les clientes</a>{!u.blocked_at && !u.removed_at && !u.deleted_at && <a class="btn btn--solid" href={`/admin/reservations/nouvelle?cliente=${u.id}`}>Nouveau rendez-vous pour elle</a>}</p>
{careAlerts.length > 0 && <p class="care-alerts" role="note">{careAlerts.map((a) => <span class="badge badge--alert">{a}</span>)}</p>}
{u.removed_at && <p class="notice notice--error">Compte supprimé par l'institut le {day(u.removed_at)}. Il reste restaurable.</p>}
{u.blocked_at && <p class="notice notice--error">Compte désactivé depuis le {day(u.blocked_at)}.</p>}
{purgeOn && <p class="notice notice--error">Suppression demandée le {day(u.deleted_at!)}. Sans retour de la cliente, le compte sera effacé le {day(purgeOn)}.</p>}

{/* Trois colonnes sur grand écran : identité et compte, fiche de soin, rendez-vous et séances */}
<div class="cl-grid">
<div class="cl-col">
<section aria-labelledby="h-coord">
<h2 id="h-coord">Coordonnées</h2>
<dl class="recap">
  <dt>E-mail</dt><dd><a href={`mailto:${u.email}`}>{u.email}</a></dd>
  <dt>Téléphone</dt><dd>{u.phone ? <a href={tel(u.phone)}>{u.phone}</a> : '—'}</dd>
  <dt>Langue</dt><dd>{LANGS[u.locale] ?? u.locale}</dd>
  <dt>Cliente depuis</dt><dd>{day(u.created_at)}</dd>
  <dt>Rendez-vous honorés</dt><dd>{stats.done}</dd>
  <dt>Absences</dt><dd>{stats.no_shows}</dd>
  <dt>Retards</dt><dd>{stats.lates}{stats.late_minutes > 0 && ` (${stats.late_minutes} min en tout)`}</dd>
  <dt>Annulations</dt><dd>{stats.cancelled}</dd>
  <dt>Total des soins honorés</dt><dd>{euros(stats.spent_cents)}</dd>
</dl>
</section>
<section aria-labelledby="h-consent">
<h2 id="h-consent">Consentements</h2>
{consents.length === 0 ? <p>Aucun consentement signé.</p> : (
<ul class="consents">{consents.map((k) => <li><a href={`${self}/consentement?voir=${k.id}`}>{FORMS[k.kind].title}</a> · signé le {fmtDateTime(k.signed_at)} {k.channel === 'institut' ? "à l'institut" : 'en ligne'}{k.specialist && ` · spécialiste : ${k.specialist}`}</li>)}</ul>
)}
<p class="hint">Faire signer à l'institut, sur la tablette :</p>
<p class="sign-links">{KINDS.map((k) => <a class="btn btn--ghost" href={`${self}/consentement?type=${k}`}>{FORMS[k].title.replace(/^Consentement (éclairé )?/, '')}</a>)}</p>
</section>
{manage && <section aria-labelledby="h-compte">
<h2 id="h-compte">Compte</h2>
{/* Chaque action demande la case « Je confirme », vérifiée aussi côté serveur (clientForm) */}
{purgeOn && (
  <form class="form" method="post" action={self}>
    <input type="hidden" name="id" value={u.id}>
    <p class="hint">À faire seulement si la cliente le demande. Ses rendez-vous annulés lors de la suppression ne reviennent pas.</p>
    <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
    <button class="btn btn--solid" type="submit" name="action" value="restore">Annuler la suppression</button>
  </form>
)}
{/* Actions rares repliées : la fiche tient sur un écran */}
<details class="cancel acct" open={!!(u.blocked_at || u.removed_at)}>
<summary>Désactiver, supprimer ou effacer le compte</summary>
<form class="form" method="post" action={self}>
  <input type="hidden" name="id" value={u.id}>
  {u.blocked_at
    ? <p class="hint">La cliente pourra de nouveau se connecter.</p>
    : <p class="hint">Désactiver déconnecte la cliente et l'empêche de se connecter. Ses rendez-vous restent. Réactivable à tout moment.</p>}
  <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
  {u.blocked_at
    ? <button class="btn btn--ghost" type="submit" name="action" value="unblock">Réactiver le compte</button>
    : <button class="btn btn--ghost" type="submit" name="action" value="block">Désactiver le compte</button>}
</form>
<form class="form" method="post" action={self}>
  <input type="hidden" name="id" value={u.id}>
  {u.removed_at
    ? <p class="hint">Le compte revient dans la liste des clientes. S'il est aussi désactivé, réactivez-le pour qu'elle puisse se connecter.</p>
    : <><p class="hint">Supprimer retire le compte des listes et ferme ses sessions. Rien n'est effacé : rendez-vous, notes et journal restent, et le compte se restaure depuis l'onglet « Supprimées ».</p>
      {upcoming.length > 0 && <p class="notice">{upcoming.length} rendez-vous à venir : ils restent dans l'agenda. Annulez-les d'abord si besoin.</p>}</>}
  <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
  {u.removed_at
    ? <button class="btn btn--solid" type="submit" name="action" value="unremove">Restaurer le compte</button>
    : <button class="btn btn--ghost" type="submit" name="action" value="remove">Supprimer le compte</button>}
</form>
<details class="cancel">
  <summary>Effacer le compte à la demande de la cliente</summary>
  <form class="form" method="post" action={self}>
    <input type="hidden" name="action" value="erase"><input type="hidden" name="id" value={u.id}>
    <p class="hint">Effacement immédiat et définitif : coordonnées, notes et sessions disparaissent. Les rendez-vous à venir sont annulés et les acomptes payés restent à rendre hors du site. Les rendez-vous passés restent pour la comptabilité, marqués « compte supprimé ».</p>
    <div class="field"><label for="confirm">Tapez EFFACER pour confirmer</label><input id="confirm" name="confirm" required autocomplete="off" pattern="EFFACER"></div>
    <button class="btn btn--ghost" type="submit">Effacer définitivement</button>
  </form>
</details>
</details>
</section>}
{gifts.length > 0 && <section aria-labelledby="h-gifts">
<h2 id="h-gifts">Bons cadeaux</h2>
<ul class="events">{gifts.map((g) => <li><a href={`/admin/bons-cadeaux/${g.id}`}>{g.code}</a> · {g.service} · {GIFT_STATES[g.state]} · jusqu'au {g.expires_on.split('-').reverse().join('/')}</li>)}</ul>
</section>}
{/* Journal (connexions, exports, IP) : admin seulement, comme la page Journal */}
{manage && <section aria-labelledby="h-journal">
<h2 id="h-journal">Journal récent</h2>
{events.length === 0 ? <p>Aucune ligne.</p> : (
<ul class="events">{events.map((e) => <li><time datetime={e.at.toISOString()}>{fmtDateTime(e.at)}</time> — {ACTION_LABELS[e.action] ?? e.action}{e.action === 'admin_action' && typeof e.details.action === 'string' && ` (${e.details.action})`}</li>)}</ul>
)}
<p><a href={`/admin/journal?cliente=${u.id}`}>Tout le journal de cette cliente</a></p>
</section>}
</div>
<div class="cl-col">
<section aria-labelledby="h-notes">
<h2 id="h-notes">Fiche de soin</h2>
{prof.filledAt && <p class="hint">Remplie par la cliente le {day(prof.filledAt)}. Vous pouvez la corriger ci-dessous.</p>}
{prof.clientNote && <p class="client-note"><strong>Mot de la cliente :</strong> {prof.clientNote}</p>}
{/* Lecture d'abord : badges compacts ; le formulaire complet se déplie sous « Modifier la fiche » */}
{sheetRows.length === 0 && !prof.notes ? <p class="hint">Fiche vide pour l'instant.</p> : (
<dl class="recap sheet-read">
  {sheetRows.map(([t, vals, alert]) => <><dt>{t}</dt><dd class="tags">{vals.map((v) => <span class={`badge${alert ? ' badge--alert' : ''}`}>{v}</span>)}</dd></>)}
  {prof.notes && <><dt>Notes</dt><dd class="note-text">{prof.notes}</dd></>}
</dl>)}
{!prof.consent && <p class="hint">Pas d'accord pour les données de santé : allergies, peau et contre-indications ne sont pas notées.</p>}
<details class="sheet-edit" open={!!profDraft}>
<summary class="btn btn--ghost">Modifier la fiche</summary>
<FicheForm prof={prof} action={`${self}#h-notes`} />
</details>
</section>
</div>
<div class="cl-col">
<section aria-labelledby="h-rdv">
<h2 id="h-rdv">Rendez-vous</h2>
{bookings.length === 0 ? <p>Aucun rendez-vous.</p> : (
<div class="table-wrap"><table class="data-table">
  <thead><tr><th scope="col">Date</th><th scope="col">Prestation</th><th scope="col">Statut</th><th scope="col">Montants</th><th scope="col">Actions</th></tr></thead>
  <tbody>{bookings.map((b) => (
    <tr id={`b-${b.id}`}>
      <td><a href={`/admin/agenda?jour=${todayBrussels(b.starts_at)}&vue=jour#r-${b.id}`}>{fmtDateTime(b.starts_at)}</a>{b.moved && <><br><small>déplacé</small></>}</td>
      <td>{b.service}</td>
      <td>
        {b.status === 'expired' ? STATUS[b.status] : <span class={`badge badge--${rdvStatus(b).tone}`}>{rdvStatus(b).label}</span>}
        {b.late_minutes && <><br><small>En retard : {b.late_minutes} min</small></>}
        {b.cancel_reason && <><br><small>{REASON[b.cancel_reason]}</small></>}
        {b.review_request_sent_at && <><br><small class="review-state">Avis : {[
          `mail envoyé le ${fmtDateTime(b.review_request_sent_at)}`,
          b.review_clicked_at && `cliqué le ${fmtDateTime(b.review_clicked_at)}`,
          b.review_found_at && `avis trouvé (${fmtDateTime(b.review_found_at)})`,
          b.review_reminder_sent_at ? `relancée le ${fmtDateTime(b.review_reminder_sent_at)}` : (b.review_clicked_at || b.review_found_at) && 'pas de relance',
        ].filter(Boolean).join(' · ')}</small></>}
        {due(b) > 0 && b.status !== 'confirmed' && <><br><small>Acompte à rendre</small></>}
      </td>
      <td>Prix {euros(b.price_cents - b.discount_cents)}{b.package && <><br><span class="badge">Forfait</span> <small>{b.package}</small></>}{b.deposit_cents > 0 && <><br>Acompte {euros(b.deposit_cents)}{b.paid ? ' payé' : ''}</>}{b.refunded_cents > 0 && <><br>Remboursé {euros(b.refunded_cents)}</>}</td>
      <td>
        {b.status === 'confirmed' && b.package && (
          <form class="cell-form" method="post" action={self}>
            <input type="hidden" name="scope" value="booking"><input type="hidden" name="id" value={b.id}>
            <button class="btn btn--ghost" type="submit" name="action" value="unpackage">Retirer du forfait<span class="visually-hidden"> le rendez-vous du {fmtDateTime(b.starts_at)}</span></button>
          </form>
        )}
        {b.status === 'confirmed' && b.past && (
          <form class="cell-form" method="post" action={self}>
            <input type="hidden" name="scope" value="booking"><input type="hidden" name="id" value={b.id}>
            <button class="btn btn--ghost" type="submit" name="action" value={b.no_show ? 'show' : 'no_show'}>{b.no_show ? "Retirer l'absence" : 'Marquer absente'}</button>
          </form>
        )}
{b.status === 'confirmed' && b.past && !b.no_show && (b.paid_method ? (
          <form class="cell-form" method="post" action={self}>
            <input type="hidden" name="scope" value="booking"><input type="hidden" name="id" value={b.id}>
            <small>Encaissé {euros(b.paid_cents ?? 0)} · {PAY_METHODS[b.paid_method as PayMethod]}</small>
            <button class="btn btn--ghost" type="submit" name="action" value="unpay">Retirer l'encaissement</button>
          </form>
        ) : (
          <details class="cancel"><summary>Encaisser<span class="visually-hidden"> le rendez-vous du {fmtDateTime(b.starts_at)}</span></summary>
            <form class="cell-form" method="post" action={self}>
              <input type="hidden" name="scope" value="booking"><input type="hidden" name="action" value="pay"><input type="hidden" name="id" value={b.id}>
              <label class="field">Mode<select name="method" required>{Object.entries(PAY_METHODS).map(([k, l]) => <option value={k}>{l}</option>)}</select></label>
              <label class="field">Montant payé (€)<input name="amount" required inputmode="decimal" pattern="\d{1,5}([.,]\d{1,2})?" value={centsInput(b.price_cents - b.discount_cents)}></label>
              <button class="btn btn--ghost" type="submit">Noter l'encaissement</button>
            </form>
          </details>
        ))}
        {b.status === 'confirmed' && b.past && !b.no_show && (b.late_minutes ? (
          <form class="cell-form" method="post" action={self}>
            <input type="hidden" name="scope" value="booking"><input type="hidden" name="id" value={b.id}>
            <button class="btn btn--ghost" type="submit" name="action" value="on_time">Retirer le retard</button>
          </form>
        ) : (
          <details class="cancel"><summary>Arrivée en retard<span class="visually-hidden"> le {fmtDateTime(b.starts_at)}</span></summary>
            <form class="cell-form" method="post" action={self}>
              <input type="hidden" name="scope" value="booking"><input type="hidden" name="action" value="late"><input type="hidden" name="id" value={b.id}>
              <label class="field">Minutes de retard<input type="number" name="late" required min="1" max="240" step="1" inputmode="numeric"></label>
              <button class="btn btn--ghost" type="submit">Noter le retard</button>
            </form>
          </details>
        ))}
        {b.status !== 'confirmed' && b.status !== 'pending_payment' && due(b) > 0 && (
          <form class="cell-form" method="post" action={self}>
            <input type="hidden" name="scope" value="booking"><input type="hidden" name="id" value={b.id}>
            <button class="btn btn--ghost" type="submit" name="action" value="manual_refund">Marquer remboursé hors site ({euros(due(b))})</button>
          </form>
        )}
        {manage && <Supprimer id={b.id} label={`le rendez-vous du ${fmtDateTime(b.starts_at)}`} action={self} />}
      </td>
    </tr>
  ))}</tbody>
</table></div>
)}
</section>
<section aria-labelledby="h-forfaits">
<h2 id="h-forfaits">Forfaits</h2>
{packages.length === 0 ? <p>Aucun forfait.</p> : (
<ul class="pkgs">{packages.map((p) => (
  <li id={`f-${p.id}`}>
    <p><strong>{p.label}</strong> <span class={`badge badge--${PACKAGE_TONE[p.state]}`}>{PACKAGE_STATES[p.state]}</span></p>
    <p><strong>{p.left} séance{p.left > 1 ? 's' : ''} restante{p.left > 1 ? 's' : ''}</strong> sur {p.total} · {p.done} faite{p.done > 1 ? 's' : ''} · {p.booked} réservée{p.booked > 1 ? 's' : ''}</p>
    <p class="meter" aria-hidden="true"><span>{Array.from({ length: p.total }, (_, i) => <i class:list={{ on: i < p.done, mark: i >= p.done && i < p.done + p.booked }}></i>)}</span></p>
    <p class="hint">{p.service} · vendu {euros(p.price_cents)} le {day(p.sold_at)} · valable jusqu'au {dmy(p.expires_on)}{p.cancelled_at && ` · arrêté le ${day(p.cancelled_at)}${p.cancel_reason ? ` : ${p.cancel_reason}` : ''}`}</p>
    {!p.cancelled_at && p.state !== 'expire' && (
      <details class="cancel"><summary>Arrêter le forfait<span class="visually-hidden"> {p.label}</span></summary>
        <form class="cell-form" method="post" action={`${self}#f-${p.id}`}>
          <input type="hidden" name="scope" value="forfait"><input type="hidden" name="action" value="stop"><input type="hidden" name="package" value={p.id}>
          <p class="hint">Plus aucune séance ne sera prise dessus. Les rendez-vous déjà réservés restent. Le site ne rembourse rien : le remboursement éventuel se fait à l'institut.</p>
          <label class="field">Motif (facultatif)<input name="reason" maxlength="300"></label>
          <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
          <button class="btn btn--ghost" type="submit">Arrêter le forfait</button>
        </form>
      </details>
    )}
  </li>
))}</ul>
)}
{canSell && lines.length > 0 && (
  <details class="cancel sell"><summary class="btn btn--ghost">Vendre un forfait</summary>
    <form class="form" method="post" action={`${self}#h-forfaits`}>
      <input type="hidden" name="scope" value="forfait"><input type="hidden" name="action" value="sell">
      <div class="field"><label for="offer">Forfait de la carte et soin couvert</label>
        <select id="offer" name="offer" required>{lines.map((l) => (
          <optgroup label={`${l.name_fr} · ${l.sessions} séances · ${euros(l.price_cents)}`}>{l.covers.map((s) => <option value={`${l.id}-${s.id}`}>{l.covers.length > 1 ? `${l.name_fr} pour ${s.name_fr}` : l.name_fr}</option>)}</optgroup>
        ))}</select></div>
      <p class="hint">Prix de la carte, valable 24 mois. Chaque rendez-vous de ce soin, en ligne ou ici, prend une séance (0 €). Une absence ne décompte pas de séance.</p>
      <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme la vente</span></label>
      <button class="btn btn--solid" type="submit">Enregistrer la vente</button>
    </form>
  </details>
)}
</section>
<section aria-labelledby="h-fidelite">
<h2 id="h-fidelite">Carte de fidélité</h2>
<p><strong>{card.sessions} séance{card.sessions > 1 ? 's' : ''}</strong> sur la carte en cours, <strong>{euros(card.spentCents)}</strong> payés.
  Séance comptée à partir de {card.rules.min_euros} € payés. {card.rules.discount_percent} % de remise après {card.rules.discount_after} séances{card.discountUsed && ' (déjà utilisée)'} ;
  {card.rules.free_label} ({card.rules.free_value} €) offert après {card.rules.free_after} séances et {card.rules.free_min_total} € payés.</p>
{/* Rentabilité : avantages accordés (remises et soins offerts) rapportés à tout ce que la cliente a payé ; et coût du prochain soin offert rapporté à la carte en cours */}
<p class="hint">Rentabilité : {euros(card.lifetime.rewardsCents)} d'avantages accordés pour {euros(card.lifetime.spentCents)} payés au total{card.lifetime.spentCents > 0 && ` (${(card.lifetime.rewardsCents / card.lifetime.spentCents * 100).toFixed(1).replace('.', ',')} %)`}.
  {card.spentCents > 0 && `Le soin offert vaudrait ${(card.rules.free_value * 100 / card.spentCents * 100).toFixed(1).replace('.', ',')} % de la carte en cours.`}</p>
<p class="meter" aria-hidden="true"><span>{Array.from({ length: card.rules.free_after }, (_, i) => <i class:list={{ on: i < card.sessions, mark: i + 1 === card.rules.discount_after }}></i>)}</span></p>
{(card.discount || card.free) ? (
  rewardable.length === 0 ? <p class="notice">Avantage disponible : {card.free ? `${card.rules.free_label} offert` : `${card.rules.discount_percent} % de remise`}. Saisissez d'abord le rendez-vous où l'appliquer.</p> : (
  <form class="form" method="post" action={`${self}#h-fidelite`}>
    <input type="hidden" name="scope" value="fidelite"><input type="hidden" name="id" value={u.id}><input type="hidden" name="kind" value={card.free ? 'free' : 'discount'}>
    <p class="notice">Avantage disponible : <strong>{card.free ? `${card.rules.free_label} offert` : `${card.rules.discount_percent} % de remise sur le soin`}</strong></p>
    <div class="field"><label for="reward-booking">Rendez-vous où l'appliquer</label>
      <select id="reward-booking" name="booking" required>{rewardable.map((b) => <option value={b.id}>{fmtDateTime(b.starts_at)} · {b.service} · {euros(b.price_cents)}</option>)}</select></div>
    <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
    <button class="btn btn--solid" type="submit">Appliquer</button>
  </form>)
) : <p class="hint">Aucun avantage disponible pour l'instant.</p>}
{card.last && <p class="hint">Dernier avantage : {card.last.kind === 'free' ? 'soin offert' : 'remise'} le {fmtDateTime(card.last.used_at)}.</p>}
</section>
<section aria-labelledby="h-suivi">
<h2 id="h-suivi">Suivi des séances</h2>
<form class="form" method="post" action={`${self}#h-suivi`}>
  <input type="hidden" name="scope" value="suivi"><input type="hidden" name="action" value="health"><input type="hidden" name="id" value={u.id}>
  <div class="field"><label for="birth_date">Date de naissance</label><input id="birth_date" name="birth_date" type="date" min="1900-01-02" value={birthDraft ?? sv.birthDate ?? ''}></div>
  {sv.consent
    ? <div class="field"><label for="medical_history">Antécédents médicaux</label><textarea id="medical_history" name="medical_history" rows="4" maxlength="4000">{historyDraft ?? sv.history ?? ''}</textarea>
        <p class="hint">Données de santé : chiffrées, visibles par l'admin et la gestionnaire seulement, jamais dans un e-mail ni au journal. Effacées si la cliente retire son accord.</p></div>
    : <p class="hint">Antécédents médicaux : la cliente n'a pas donné son accord pour ses données de santé. Rien ne peut être noté.</p>}
  <button class="btn btn--ghost" type="submit">Enregistrer</button>
</form>
{sv.seances.length === 0 ? <p>Aucune séance réalisée.</p> : (
<ol class="seances">{sv.seances.map((s, i) => (
  <li id={`s-${s.id}`}>
    <p><strong>Séance {i + 1}</strong> · {fmtDateTime(s.starts_at)}</p>
    <p>{s.service}{s.zone && ` · zone : ${s.zone}`}{s.practitioner && ` · ${s.practitioner}`}</p>
    <details><summary>Zone et praticienne</summary>
      <form class="seance-form" method="post" action={`${self}#s-${s.id}`}>
        <input type="hidden" name="scope" value="suivi"><input type="hidden" name="action" value="seance"><input type="hidden" name="id" value={u.id}><input type="hidden" name="booking" value={s.id}>
        <label>Zone traitée<input name="zone" maxlength="100" value={s.zone ?? ''}></label>
        <label>Praticienne<select name="practitioner"><option value="">—</option>{sv.team.map((t) => <option value={t.id} selected={t.id === s.practitioner_id}>{t.name}</option>)}</select></label>
        <button class="btn btn--ghost" type="submit">Enregistrer</button>
      </form>
    </details>
  </li>
))}</ol>
)}
</section>
</div>
</div>
</Admin>

<style>
  /* Fiche sans long défilement : 3 colonnes dès 1600 px ; 2 dès 1200 px (rendez-vous à droite) ; 2 dès 960 px (rendez-vous dessous) */
  .cl-grid{display:grid;gap:0 2rem;align-items:start}
  .cl-col{min-width:0}
  .cl-col > section > h2{margin-top:1.25rem}
  @media (min-width:960px){.cl-grid{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr)}.cl-col:last-child{grid-column:1 / -1}}
  /* Dès 1200 px : identité et fiche à gauche, rendez-vous et séances à droite */
  @media (min-width:1200px){.cl-grid{grid-template-columns:minmax(0,1fr) minmax(0,1.3fr)}.cl-col:first-child{grid-row:1}.cl-col:nth-child(2){grid-column:1;grid-row:2}.cl-col:last-child{grid-column:2;grid-row:1 / span 2}}
  @media (min-width:1600px){.cl-grid{grid-template-columns:minmax(0,.85fr) minmax(0,1.1fr) minmax(0,1.35fr)}.cl-col:nth-child(n){grid-column:auto;grid-row:auto}}
  .fiche-top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem}
  .fiche-top .btn{min-height:44px}
  .sheet-read{grid-template-columns:auto 1fr;margin-bottom:1rem}
  .tags{display:flex;flex-wrap:wrap;gap:.35rem}
  .note-text{white-space:pre-line}
  .sheet-edit > summary{list-style:none;display:inline-flex;margin:0 0 1rem;cursor:pointer}
  .sheet-edit > summary::-webkit-details-marker{display:none}
  .sheet-edit[open] > summary{margin-bottom:1rem}
  .recap{display:grid;grid-template-columns:auto 1fr;gap:.4rem 1.25rem;margin:0 0 1.5rem}
  .recap dt{color:var(--text-soft)}
  .recap dd{margin:0;min-width:0;overflow-wrap:anywhere}
  textarea{width:100%;font:inherit}
  .cell-form{display:grid;gap:.5rem;justify-items:start}
  .cell-form .btn{min-height:44px;padding:.55rem 1rem;white-space:normal;text-align:left;line-height:1.3}
  .events{padding-left:1.1rem}
  .consents{padding-left:1.1rem}
  .care-alerts{display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 1rem}
  .meter span{display:flex;flex-wrap:wrap;gap:.3rem}
  .meter i{width:1.1rem;height:1.1rem;border-radius:50%;border:1px solid var(--line-soft)}
  .meter i.on{background:var(--accent);border-color:var(--accent)}
  .meter i.mark{outline:2px solid var(--accent);outline-offset:1px}
  .pkgs{list-style:none;margin:0 0 1rem;padding:0;display:grid;gap:.6rem}
  .pkgs li{padding:.75rem 1rem;border:1px solid var(--line-soft);border-radius:12px;scroll-margin-top:1rem}
  .pkgs p{margin:0 0 .3rem}
  .sell > summary{list-style:none;display:inline-flex;min-height:44px;cursor:pointer}
  .sell > summary::-webkit-details-marker{display:none}
  .sell[open] > summary{margin-bottom:1rem}
  .seances{list-style:none;margin:1rem 0 0;padding:0;display:grid;gap:.6rem}
  .seances li{padding:.75rem 1rem;border:1px solid var(--line-soft);border-radius:12px;scroll-margin-top:1rem}
  .seances p{margin:0 0 .2rem}
  .seance-form{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:flex-end;margin-top:.5rem}
  .seance-form label{display:grid;gap:.25rem;font-size:.8125rem;color:var(--text-soft);min-width:0;flex:1 1 12rem}
  .seance-form input,.seance-form select{min-height:44px;font:inherit}
  .seance-form .btn{min-height:44px}
  .sign-links{display:flex;flex-wrap:wrap;gap:.5rem}
  .sign-links .btn{min-height:44px}
  section{margin-bottom:2rem}
  .check{display:flex;align-items:center;gap:.5rem;min-height:44px}
  .check input{width:1.25rem;height:1.25rem;margin:0;accent-color:var(--accent)}
</style>
