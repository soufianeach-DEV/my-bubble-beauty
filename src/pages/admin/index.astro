---
export const prerender = false;
// Accueil de l'admin : la journée en un coup d'œil pour la gérante (le matin, entre deux soins), avant l'Agenda détaillé.
// N'affiche que ce que la base contient ; ce qui manque est signalé, jamais déduit.
import { ADMIN_EMAIL, MAIL_FROM, RESEND_API_KEY } from 'astro:env/server';
import Admin from './_layout.astro';
import { adminId, deleteAction, readForm, staffId, fmtDateTime, fmtDay, fmtTime } from '../../lib/server/admin.ts';
import Supprimer from './_supprimer.astro';
import { alertsFor } from '../../lib/server/profil.ts';
import { addDays, monday } from '../../lib/server/admin-form.ts';
import { adminAgenda } from '../../lib/server/booking.ts';
import { alerts, clientCards, dayFrame, freeMinutes, loadByDay } from '../../lib/server/accueil.ts';
import { isDay, todayBrussels } from '../../lib/server/pricing.ts';
import { JS_VERSION } from '../../lib/site';

const me = staffId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
// Seule action de la page : supprimer un rendez-vous de la ligne du temps (admin seulement)
const admin = adminId(Astro.locals) !== null;
let delError = '';
if (Astro.request.method === 'POST') {
  const form = admin ? await readForm(Astro.request) : null;
  const r = form ? await deleteAction(form) : { ok: false as const, error: "Seule l'admin peut supprimer un rendez-vous." };
  if (r.ok) return Astro.redirect('/admin?ok=supprime#h-line', 303);
  delError = r.error;
  Astro.response.status = 400;
}

const now = new Date();
const today = todayBrussels();
const tomorrow = addDays(today, 1);
// Mini-calendrier : mois demandé (?mois=AAAA-MM) ou mois en cours, grille du lundi au dimanche
const asked = Astro.url.searchParams.get('mois') ?? '';
const first = isDay(`${asked}-01`) ? `${asked}-01` : `${today.slice(0, 7)}-01`;
const nextFirst = `${addDays(first, 32).slice(0, 7)}-01`;
const prevMonth = addDays(first, -1).slice(0, 7);
const gridFrom = monday(first);
const gridTo = addDays(monday(addDays(nextFirst, -1)), 7);

const [rows, frame, cards, freeTomorrow, load, week, al] = await Promise.all([
  adminAgenda(today, 1), dayFrame(today), clientCards(today), freeMinutes(tomorrow),
  loadByDay(gridFrom, gridTo), loadByDay(today, addDays(today, 7)), alerts(ADMIN_EMAIL),
]);
// Badges d'alerte (zones à ne pas toucher, allergies, toucher limité) des clientes du jour
const careAlerts = await alertsFor(cards.map((c) => c.id));

const live = rows.filter((r) => r.status === 'confirmed' || r.status === 'pending_payment');
const next = live.find((r) => r.starts_at > now && !r.no_show);
const state = (r: (typeof rows)[number]) =>
  r.status === 'cancelled' ? ['Annulé', 'off'] : r.no_show ? ['Absente', 'alert'] : r.status === 'pending_payment' ? ['Paiement en cours', 'wait']
  : r.status === 'expired' ? ['Expiré', 'off'] : now < r.starts_at ? ['À venir', 'wait'] : now < r.ends_at ? ['En cours', 'ok'] : ['Terminé', 'off'];
const minutes = (n: number) => (n < 60 ? `${n} min` : `${Math.floor(n / 60)} h${n % 60 ? ` ${String(n % 60).padStart(2, '0')}` : ''}`);
const until = (d: Date) => { const m = Math.max(0, Math.round((d.getTime() - now.getTime()) / 60000)); return m === 0 ? 'maintenant' : `dans ${minutes(m)}`; };
const digits = (p: string) => p.replace(/[^0-9+]/g, '');
const agenda = (d: string) => `/admin/agenda?jour=${d}&vue=jour`;
const shortDate = new Intl.DateTimeFormat('fr-BE', { timeZone: 'Europe/Brussels', day: 'numeric', month: 'short', year: 'numeric' }).format;
const monthName = new Intl.DateTimeFormat('fr-BE', { timeZone: 'UTC', month: 'long', year: 'numeric' }).format(new Date(`${first}T12:00:00Z`));
const weekDay = new Intl.DateTimeFormat('fr-BE', { timeZone: 'UTC', weekday: 'short', day: 'numeric' }).format;
const cells = Array.from({ length: (Date.parse(gridTo) - Date.parse(gridFrom)) / 86400000 }, (_, i) => addDays(gridFrom, i));
const level = (n = 0) => (n === 0 ? 0 : n <= 2 ? 1 : n <= 4 ? 2 : 3);
const guests = live.filter((r) => r.guest);
const mailOff = !RESEND_API_KEY || !MAIL_FROM;
const alertCount = al.pending.length + al.moved.length + al.cancelled.length + al.newClients.length + al.closures.length + (mailOff ? 1 : 0);
---
<Admin title="Accueil">
{delError && <p class="notice notice--error" role="alert">{delError}</p>}
{!delError && Astro.url.searchParams.get('ok') === 'supprime' && <p class="notice" role="status">Rendez-vous supprimé.</p>}
<span slot="actions" class="head-acts"><a class="btn btn--ghost" href={`/admin/imprimer?jour=${today}`}>Imprimer la journée</a><a class="btn btn--solid" href="/admin/reservations/nouvelle">Saisir un rendez-vous</a></span>
<script is:inline src={`/assets/js/compte-a-rebours.js?v=${JS_VERSION}`} defer></script>

{/* 1. La journée */}
{/* Les deux informations qui demandent une action ou orientent la journée, avant tout le reste */}
<div class="priority">
  {al.noDuration.length > 0 && <p class="prio prio--warn">{al.noDuration.length} prestation{al.noDuration.length > 1 ? 's' : ''} ne {al.noDuration.length > 1 ? 'peuvent' : 'peut'} pas être réservée{al.noDuration.length > 1 ? 's' : ''} en ligne : il leur manque une durée. <a href="/admin/prestations">Indiquer les durées</a></p>}
  <p class="prio">Libre : <strong>{minutes(frame.freeMin)}</strong> aujourd'hui, <strong>{minutes(freeTomorrow)}</strong> demain. <a href={agenda(tomorrow)}>Voir demain</a></p>
</div>
<section class="today" aria-labelledby="h-today">
  <div>
    <h2 id="h-today">{fmtDay(today)}</h2>
    <p class="day-open">{frame.hours.length ? <>Ouvert {frame.hours.map((h) => `${h.opens}–${h.closes}`).join(' et ')}</> : 'Fermé aujourd\'hui (aucune plage d\'ouverture)'}
      {frame.closures.map((c) => <span class="badge badge--alert">Fermeture {fmtTime(c.starts_at)}–{fmtTime(c.ends_at)}{c.reason && ` · ${c.reason}`}</span>)}</p>
  </div>
  <dl class="kpis">
    <div><dt>Rendez-vous</dt><dd>{live.length}</dd></div>
    <div><dt>Temps libre restant</dt><dd>{minutes(frame.freeMin)}</dd></div>
    <div class="kpi-next"><dt>Prochain rendez-vous</dt>
      <dd>{next ? <><time data-countdown datetime={next.starts_at.toISOString()}>{until(next.starts_at)}</time><small>{fmtTime(next.starts_at)} · {next.name ?? '—'} · {next.service}</small></> : <small>Plus rien aujourd'hui</small>}</dd>
    </div>
  </dl>
  <nav class="quick" aria-label="Actions rapides">
    <a class="btn btn--ghost" href="/admin/horaires#fermetures">Bloquer un créneau</a>
    {next?.phone && <>
      <a class="btn btn--ghost" href={`tel:${digits(next.phone)}`}>Appeler {next.name ?? 'la cliente'}</a>
      <a class="btn btn--ghost" href={`https://wa.me/${digits(next.phone).replace(/^\+/, '')}`}>WhatsApp</a>
    </>}
  </nav>
</section>

<div class="grid">
  {/* 2. Ligne du temps */}
  <section class="panel timeline" aria-labelledby="h-line">
    <h2 id="h-line">Rendez-vous du jour <a class="more" href={agenda(today)}>Agenda du jour</a></h2>
    {rows.length === 0 ? <p class="none">Aucun rendez-vous aujourd'hui.</p> : (
      <ol>{rows.filter((r) => r.status !== 'cancelled' && r.status !== 'expired').map((r) => { const [label, tone] = state(r); return (
        <li class:list={[`tl tl--${tone}`, { 'tl--next': r.id === next?.id }]}>
          <span class="tl-time">{fmtTime(r.starts_at)}<small>{minutes(Math.round((r.ends_at.getTime() - r.starts_at.getTime()) / 60000))}</small></span>
          <span class="tl-who">
            {r.user_id ? <a href={`/admin/clientes/${r.user_id}`}>{r.name ?? r.email}</a> : <span>{r.name ?? (r.erased ? 'Compte supprimé' : '—')}</span>}
            <small>{r.service}{r.guest && ' · saisie par l\'institut'}</small>
          </span>
          <span class={`badge badge--${tone}`}>{label}</span>
          {admin && <span class="tl-del"><Supprimer id={r.id} label={`le rendez-vous de ${fmtTime(r.starts_at)}`} action="/admin" /></span>}
        </li>
      ); })}</ol>
    )}
  </section>

  {/* 5. Alertes */}
  <section class="panel alerts" aria-labelledby="h-alerts">
    <h2 id="h-alerts">Alertes {alertCount > 0 && <span class="badge badge--alert">{alertCount}</span>}</h2>
    <ul>
      {mailOff && <li class="al al--alert">Envoi d'e-mails non configuré : confirmations et rappels ne partent pas.</li>}
      {al.pending.map((r) => <li class="al al--wait">Paiement en cours : {r.name ?? '—'}, {fmtDateTime(r.starts_at)}</li>)}
      {al.moved.map((r) => <li class="al"><a href={agenda(todayBrussels(r.starts_at))}>Déplacé</a> : {r.name ?? '—'}, {r.service}, maintenant le {fmtDateTime(r.starts_at)}</li>)}
      {al.cancelled.map((r) => <li class="al al--off">Annulé : {r.name ?? '—'}, {r.service}, {fmtDateTime(r.starts_at)}{r.cancel_reason === 'account_deleted' && ' (compte supprimé)'}</li>)}
      {al.newClients.map((c) => <li class="al al--ok">Nouvelle inscrite : <a href={`/admin/clientes/${c.id}`}>{c.name ?? c.email}</a>, le {shortDate(c.created_at)}</li>)}
      {al.closures.map((c) => <li class="al">Fermeture : {fmtDateTime(c.starts_at)} → {fmtDateTime(c.ends_at)}{c.reason && ` (${c.reason})`}</li>)}
      {/* La durée sert à calculer les créneaux : sans elle, une prestation ne peut pas être réservée en ligne */}
    </ul>
    <p class="hint">Non disponible : anniversaires (aucune date de naissance enregistrée).</p>
  </section>
</div>

{/* 3. Fiches des clientes du jour */}
<section class="cards-wrap" aria-labelledby="h-cards">
  <h2 id="h-cards">Fiches des clientes du jour</h2>
  {cards.length === 0 && guests.length === 0 ? <p class="none">Aucune cliente attendue aujourd'hui.</p> : (
    <div class="cards">
      {cards.map((c) => (
        <article class="card">
          <h3><a href={`/admin/clientes/${c.id}`}>{c.name ?? c.email}</a>{c.visits === 0 && <span class="badge badge--wait">Première visite</span>}</h3>
          <p class="contact">{c.phone ? <a href={`tel:${digits(c.phone)}`}>{c.phone}</a> : 'Pas de téléphone'} · <span>{c.email}</span></p>
          <dl>
            <div><dt>Visites</dt><dd>{c.visits}{c.no_shows > 0 && ` (+ ${c.no_shows} absence${c.no_shows > 1 ? 's' : ''})`}</dd></div>
            <div><dt>Dernière visite</dt><dd>{c.last_visit ? shortDate(c.last_visit) : '—'}</dd></div>
            <div><dt>Cliente depuis</dt><dd>{shortDate(c.created_at)}</dd></div>
          </dl>
          {(careAlerts.get(c.id) ?? []).length > 0 && <p class="care-alerts">{careAlerts.get(c.id)!.map((a) => <span class="badge badge--alert">{a}</span>)}</p>}
          {c.services.length > 0 && <p class="past"><b>Déjà faits :</b> {c.services.join(', ')}</p>}
          {/* RGPD : seulement ce qui est déjà en base. Sans accord, les notes ne doivent rien contenir de médical. */}
          <p class:list={['consent', { 'consent--no': !c.health_consent_at }]}>{c.health_consent_at
            ? `Accord santé donné le ${shortDate(c.health_consent_at)}. Allergies et contre-indications : voir la fiche de soin.`
            : 'Pas d\'accord pour les données de santé : rien de médical dans les notes.'}</p>
          {c.notes ? <p class="notes">{c.notes}</p> : <p class="notes notes--empty">Aucune note.</p>}
        </article>
      ))}
      {guests.map((r) => (
        <article class="card card--guest">
          <h3>{r.name ?? '—'}<span class="badge badge--off">Sans compte</span></h3>
          <p class="contact">{r.phone ? <a href={`tel:${digits(r.phone)}`}>{r.phone}</a> : 'Pas de téléphone'}</p>
          <p class="notes notes--empty">Rendez-vous saisi par l'institut : seuls le nom et le téléphone sont enregistrés.</p>
        </article>
      ))}
    </div>
  )}
</section>

<div class="grid">
  {/* 4. Mini-calendrier du mois */}
  <section class="panel cal" aria-labelledby="h-cal">
    <h2 id="h-cal"><span class="cap">{monthName}</span>
      <span class="cal-nav"><a href={`/admin?mois=${prevMonth}#h-cal`} aria-label="Mois précédent">‹</a><a href={`/admin?mois=${nextFirst.slice(0, 7)}#h-cal`} aria-label="Mois suivant">›</a></span></h2>
    <ol class="cal-grid" aria-label={`Rendez-vous par jour, ${monthName}`}>
      {['lun', 'mar', 'mer', 'jeu', 'ven', 'sam', 'dim'].map((d) => <li class="cal-dow" aria-hidden="true">{d}</li>)}
      {cells.map((d) => (
        <li class:list={['cal-day', `cal-l${level(load[d])}`, { 'cal-out': d.slice(0, 7) !== first.slice(0, 7), 'cal-today': d === today }]}>
          <a href={agenda(d)} aria-label={`${fmtDay(d)} : ${load[d] ?? 0} rendez-vous`}><span>{Number(d.slice(8))}</span>{load[d] ? <small>{load[d]}</small> : null}</a>
        </li>
      ))}
    </ol>
    <p class="hint">Couleur : de 1–2 à 5 rendez-vous et plus. Un clic ouvre le jour dans l'Agenda.</p>
  </section>

  {/* 4 bis. Les 7 prochains jours */}
  <section class="panel next7" aria-labelledby="h-week">
    <h2 id="h-week">7 prochains jours <a class="more" href="/admin/agenda">Agenda</a></h2>
    <ul>{Array.from({ length: 7 }, (_, i) => addDays(today, i)).map((d) => (
      <li><a href={agenda(d)}><span class="cap">{d === today ? 'Aujourd\'hui' : d === tomorrow ? 'Demain' : weekDay(new Date(`${d}T12:00:00Z`))}</span>
        <span class:list={['bar', `cal-l${level(week[d])}`]}>{week[d] ? `${week[d]} rendez-vous` : 'Libre'}</span></a></li>
    ))}</ul>
  </section>
</div>
</Admin>

<style>
  .head-acts{display:flex;flex-wrap:wrap;gap:.5rem}
  h2{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem .75rem;margin:0 0 1rem;font-size:1.35rem}
  .more{margin-left:auto;font:500 .875rem var(--f-text)}
  .none,.hint{margin:0;color:var(--text-soft);font-size:.9375rem}
  .hint{margin-top:.75rem;font-size:.8125rem}
  .cap::first-letter{text-transform:uppercase}
  .panel,.today,.card{border:1px solid var(--line-soft);border-radius:16px;background:var(--bg)}
  .panel{padding:1.25rem}
  .grid{display:grid;gap:1.25rem;margin:0 0 1.75rem}
  @media (min-width:1024px){.grid{grid-template-columns:minmax(0,3fr) minmax(0,2fr)}}

  .today{display:grid;gap:1rem 2rem;padding:1.25rem 1.5rem;margin:0 0 1.75rem}
  @media (min-width:1024px){.today{grid-template-columns:minmax(0,1fr) auto;align-items:center}.quick{grid-column:1 / -1}}
  .today h2{margin:0 0 .35rem;font-size:1.6rem}
  .today h2::first-letter{text-transform:uppercase}
  .day-open{display:flex;flex-wrap:wrap;gap:.4rem .75rem;align-items:center;margin:0;color:var(--text-soft)}
  .priority{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:.75rem;margin:0 0 1rem}
  .prio{margin:0;padding:.9rem 1.1rem;border:1px solid var(--line-soft);border-radius:14px;background:var(--bg)}
  .prio--warn{border-color:var(--accent);background:rgb(138 90 82 / .1)}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:.75rem;margin:0}
  @media (min-width:1024px){.kpis{grid-template-columns:auto auto minmax(14rem,auto)}}
  .kpis div{padding:.75rem 1rem;border-radius:12px;background:rgb(138 90 82 / .08)}
  .kpis dt{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--text-soft)}
  .kpis dd{margin:.2rem 0 0;font:400 1.6rem/1.2 var(--f-title)}
  .kpis small{display:block;font:400 .875rem/1.4 var(--f-text);color:var(--text-soft)}
  .quick{display:flex;flex-wrap:wrap;gap:.5rem}

  .timeline ol{display:grid;gap:.5rem;list-style:none;margin:0;padding:0}
  .tl-del{grid-column:1 / -1}
  .tl{display:grid;grid-template-columns:4.5rem minmax(0,1fr) auto;gap:.75rem;align-items:center;padding:.6rem .75rem;border-left:3px solid var(--line-soft);border-radius:10px;background:rgb(138 90 82 / .05)}
  .tl--ok{border-left-color:rgb(76 128 92)}
  .tl--wait{border-left-color:rgb(196 150 70)}
  .tl--alert{border-left-color:rgb(176 70 60)}
  .tl--off{opacity:.65}
  .tl--next{box-shadow:0 0 0 2px var(--accent)}
  .tl-time{font-weight:500;font-variant-numeric:tabular-nums}
  .tl-time small,.tl-who small{display:block;font-weight:400;font-size:.8125rem;color:var(--text-soft)}
  .tl-who{min-width:0}

  .alerts ul{display:grid;gap:.4rem;list-style:none;margin:0;padding:0}
  .al{padding:.55rem .75rem;border-radius:10px;font-size:.9375rem;background:rgb(138 90 82 / .08)}
  .al--alert{background:rgb(176 70 60 / .16)}
  .al--wait{background:rgb(196 150 70 / .2)}
  .al--ok{background:rgb(76 128 92 / .16)}
  .al--off{background:rgb(120 110 108 / .14)}
  .al--info{background:none;border:1px dashed var(--line-soft)}

  .cards-wrap{margin:0 0 1.75rem}
  .cards{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(min(100%,19rem),1fr))}
  .card{display:grid;gap:.6rem;align-content:start;padding:1rem 1.15rem}
  .card h3{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;margin:0;font-size:1.15rem}
  .card p{margin:0}
  .contact{font-size:.9375rem;overflow-wrap:anywhere}
  .card dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:0}
  .card dt{font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--text-soft)}
  .card dd{margin:0;font-weight:500}
  .past{font-size:.875rem}
  .consent{padding:.45rem .65rem;border-radius:8px;font-size:.8125rem;background:rgb(76 128 92 / .14)}
  .consent--no{background:rgb(196 150 70 / .18)}
  .care-alerts{display:flex;flex-wrap:wrap;gap:.35rem;margin:0}
  .notes{white-space:pre-line;font-size:.9375rem;padding:.6rem .75rem;border-radius:8px;background:rgb(138 90 82 / .06)}
  .notes--empty{color:var(--text-soft);background:none;padding:0}

  .cal h2{justify-content:space-between}
  .cal-nav{display:flex;gap:.25rem}
  .cal-nav a{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line-soft);border-radius:999px;color:var(--text);text-decoration:none;font-size:1.3rem}
  .cal-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:.3rem;list-style:none;margin:0;padding:0}
  .cal-dow{text-align:center;font-size:.75rem;text-transform:uppercase;color:var(--text-soft)}
  .cal-day{border-radius:10px}
  .cal-day a{display:grid;place-items:center;align-content:center;min-height:44px;height:2.9rem;border-radius:10px;color:var(--text);text-decoration:none;font-variant-numeric:tabular-nums}
  .cal-day small{font-size:.7rem;line-height:1}
  .cal-day a:hover,.cal-day a:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
  .cal-out a{opacity:.4}
  .cal-today a{box-shadow:inset 0 0 0 2px var(--accent);font-weight:600}
  .cal-l1{background:rgb(138 90 82 / .14)}
  .cal-l2{background:rgb(138 90 82 / .3)}
  .cal-l3{background:rgb(138 90 82 / .5)}

  .next7 ul{display:grid;gap:.35rem;list-style:none;margin:0;padding:0}
  .next7 a{display:grid;grid-template-columns:7rem minmax(0,1fr);gap:.75rem;align-items:center;min-height:44px;color:var(--text);text-decoration:none}
  .next7 .bar{padding:.45rem .7rem;border-radius:8px;font-size:.875rem;border:1px dashed var(--line-soft)}
  .next7 .bar:not(.cal-l0){border-style:solid;border-color:transparent}
</style>
