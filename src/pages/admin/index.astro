---
export const prerender = false;
// Accueil de l'admin = « Aujourd'hui » : une carte par rendez-vous du jour, un seul bouton visible selon le moment
// (Arrivée, puis Terminer et encaisser), le reste derrière « ··· » avec la conséquence écrite ; la clôture du soir en bas.
// N'affiche que ce que la base contient ; ce qui manque est signalé, jamais déduit.
import { ADMIN_EMAIL, MAIL_FROM, RESEND_API_KEY } from 'astro:env/server';
import Admin from './_layout.astro';
import Encaisser from './_encaisser.astro';
import Supprimer from './_supprimer.astro';
import { adminId, agendaAction, deleteAction, readForm, staffId, fmtDateTime, fmtDay, fmtTime } from '../../lib/server/admin.ts';
import { alertsFor } from '../../lib/server/profil.ts';
import { addDays, monday } from '../../lib/server/admin-form.ts';
import { PAY_METHODS, type PayMethod } from '../../lib/server/booking.ts';
import { alerts, clientCards, dayBookings, dayFrame, freeMinutes, loadByDay, type DayBooking } from '../../lib/server/accueil.ts';
import { consentFor, FORMS } from '../../lib/server/consentements.ts';
import { rdvStatus } from '../../lib/server/statut.ts';
import { euros, isDay, todayBrussels } from '../../lib/server/pricing.ts';

const me = staffId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
// Supprimer : admin seulement ; toutes les autres actions d'un rendez-vous passent par agendaAction (mêmes gardes que l'Agenda)
const admin = adminId(Astro.locals) !== null;
let error = '';
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  const r = form.get('action') === 'delete'
    ? admin ? await deleteAction(form) : { ok: false as const, error: "Seule l'admin peut supprimer un rendez-vous." }
    : await agendaAction(me, form);
  if (r.ok) return Astro.redirect(`/admin?ok=${r.key}#${r.key === 'supprime' ? 'h-day' : `c-${r.id}`}`, 303);
  error = r.error;
  Astro.response.status = 400;
}
const DONE: Record<string, string> = {
  arrivee: 'Arrivée notée.', nonarrivee: 'Arrivée annulée.', encaisse: 'Honoré et payé : encaissement noté.', nonencaisse: 'Encaissement retiré.',
  absente: 'Rendez-vous marqué « absente ».', venue: 'Absence retirée.', retard: 'Retard noté.', aheure: 'Retard retiré.',
  annule: 'Rendez-vous annulé.', rembourse: 'Acompte remboursé, rendez-vous annulé.', supprime: 'Rendez-vous supprimé.',
  echec: "Le remboursement n'a pas abouti : réessayez depuis l'Agenda.",
};
const done = !error && DONE[Astro.url.searchParams.get('ok') ?? ''];

const now = new Date();
const today = todayBrussels();
const tomorrow = addDays(today, 1);
const hourNow = Number(new Intl.DateTimeFormat('fr-BE', { timeZone: 'Europe/Brussels', hour: '2-digit', hourCycle: 'h23' }).format(now));
// Mini-calendrier : mois demandé (?mois=AAAA-MM) ou mois en cours, grille du lundi au dimanche
const asked = Astro.url.searchParams.get('mois') ?? '';
const first = isDay(`${asked}-01`) ? `${asked}-01` : `${today.slice(0, 7)}-01`;
const nextFirst = `${addDays(first, 32).slice(0, 7)}-01`;
const prevMonth = addDays(first, -1).slice(0, 7);
const gridFrom = monday(first);
const gridTo = addDays(monday(addDays(nextFirst, -1)), 7);

const [rows, frame, cards, freeTomorrow, load, week, al] = await Promise.all([
  dayBookings(today), dayFrame(today), clientCards(today), freeMinutes(tomorrow),
  loadByDay(gridFrom, gridTo), loadByDay(today, addDays(today, 7)), alerts(ADMIN_EMAIL),
]);
// Badges d'alerte de la fiche de soin (zones, allergies, toucher) : repliés sous une icône, jamais affichés au comptoir
const careAlerts = await alertsFor(cards.map((c) => c.id));
const card = new Map(cards.map((c) => [c.id, c]));

const minutes = (n: number) => (n < 60 ? `${n} min` : `${Math.floor(n / 60)} h${n % 60 ? ` ${String(n % 60).padStart(2, '0')}` : ''}`);
const length = (r: DayBooking) => minutes(Math.round((r.ends_at.getTime() - r.starts_at.getTime()) / 60000));
const digits = (p: string) => p.replace(/[^0-9+]/g, '');
const agenda = (d: string) => `/admin/agenda?jour=${d}&vue=jour`;
const shortDate = new Intl.DateTimeFormat('fr-BE', { timeZone: 'Europe/Brussels', day: 'numeric', month: 'short', year: 'numeric' }).format;
const monthName = new Intl.DateTimeFormat('fr-BE', { timeZone: 'UTC', month: 'long', year: 'numeric' }).format(new Date(`${first}T12:00:00Z`));
const weekDay = new Intl.DateTimeFormat('fr-BE', { timeZone: 'UTC', weekday: 'short', day: 'numeric' }).format;
const cells = Array.from({ length: (Date.parse(gridTo) - Date.parse(gridFrom)) / 86400000 }, (_, i) => addDays(gridFrom, i));
const level = (n = 0) => (n === 0 ? 0 : n <= 2 ? 1 : n <= 4 ? 2 : 3);
const mailOff = !RESEND_API_KEY || !MAIL_FROM;

// Ce que chaque carte montre et propose
const view = rows.map((r) => {
  const st = rdvStatus(r);
  const live = r.status === 'confirmed' && !r.no_show;
  const begun = r.past || !!r.arrived_at;
  const kind = r.user_id ? consentFor(r.slug) : null;
  const consent = kind && !r.signed.includes(kind) ? kind : null;
  const primary = !live ? null : !begun ? (consent ? 'consent' : 'arrive') : r.paid_method || r.package ? null : 'pay';
  const absence = [
    r.package && "La séance n'est pas décomptée du forfait : elle reste à prendre.",
    r.gift && 'Le bon cadeau redevient utilisable.',
    r.paid_method && "L'encaissement noté est retiré.",
    r.late_minutes && 'Le retard noté est effacé.',
    r.user_id && 'Cette séance ne compte pas sur la carte de fidélité.',
  ].filter((x): x is string => !!x);
  return { r, st, live, begun, consent, primary, absence, due: r.paid ? r.deposit_cents - r.refunded_cents : 0 };
});
const next = view.find((v) => v.live && !v.begun)?.r;
const liveCount = view.filter((v) => v.r.status === 'confirmed' && !v.r.no_show).length;

// Alertes du jour qui demandent un geste ; le reste (déplacés, annulés, inscrites…) se replie dans « Infos »
const consentTodo = view.filter((v) => v.consent && !v.begun);
const toCash = view.filter((v) => v.live && v.r.ended && !v.r.paid_method && !v.r.package);
const infoCount = al.pending.length + al.moved.length + al.cancelled.length + al.newClients.length + al.closures.length;

// Clôture du soir : rendez-vous terminés non encaissés, caisse par mode de paiement (modes existants), séances de forfait
const stillOpen = view.filter((v) => v.live && !v.r.ended && !v.r.paid_method && !v.r.package).length;
const tills = (Object.keys(PAY_METHODS) as PayMethod[]).map((k) => {
  const paid = rows.filter((r) => r.paid_method === k && !r.no_show);
  return { k, n: paid.length, cents: paid.reduce((s, r) => s + (r.paid_cents ?? 0), 0) };
}).filter((t) => t.n > 0);
const packageDone = view.filter((v) => v.live && v.r.package && v.begun).length;
const tillTotal = tills.reduce((s, t) => s + t.cents, 0);
---
<Admin title="Aujourd'hui">
<span slot="actions" class="head-acts"><a class="btn btn--ghost" href={`/admin/imprimer?jour=${today}`}>Imprimer la journée</a><a class="btn btn--solid" href="/admin/reservations/nouvelle">Saisir un rendez-vous</a></span>
{error && <p class="notice notice--error" role="alert">{error}</p>}
{done && <p class="notice" role="status">{done}</p>}

<header class="day-head">
  <h2 id="h-day">{fmtDay(today)}</h2>
  <p class="day-open">{frame.hours.length ? <>Ouvert {frame.hours.map((h) => `${h.opens}–${h.closes}`).join(' et ')}</> : "Fermé aujourd'hui (aucune plage d'ouverture)"}
    <span>· {liveCount} rendez-vous · libre {minutes(frame.freeMin)} (demain {minutes(freeTomorrow)})</span>
    {frame.closures.map((c) => <span class="badge badge--alert">Fermeture {fmtTime(c.starts_at)}–{fmtTime(c.ends_at)}{c.reason && ` · ${c.reason}`}</span>)}
    {al.noDuration.length > 0 && <a class="todo" href="/admin/prestations?filtre=sans-duree">Réglages à faire : {al.noDuration.length}<span class="visually-hidden"> prestation{al.noDuration.length > 1 ? 's' : ''} sans durée</span></a>}</p>
</header>

{(consentTodo.length > 0 || toCash.length > 0 || mailOff) && (
  <ul class="gestures" aria-label="À faire aujourd'hui">
    {consentTodo.map(({ r, consent }) => <li><a href={`/admin/clientes/${r.user_id}/consentement?type=${consent}`}><strong>{r.name ?? 'Cliente'}</strong>&nbsp;: {FORMS[consent!].title} à signer avant le soin de {fmtTime(r.starts_at)}</a></li>)}
    {toCash.length > 0 && <li><a href="#cloture">{toCash.length} rendez-vous terminé{toCash.length > 1 ? 's' : ''} à encaisser</a></li>}
    {mailOff && <li class="g-alert">Envoi d'e-mails non configuré : confirmations et rappels ne partent pas.</li>}
  </ul>
)}

<div class="day">
  <section class="rdvs" aria-labelledby="h-rdvs">
    <h2 id="h-rdvs" class="visually-hidden">Rendez-vous du jour</h2>
    {view.length === 0 ? <p class="none">Aucun rendez-vous aujourd'hui.</p> : (
      <ol class="cards">{view.map(({ r, st, live, begun, consent, primary, absence, due }) => { const c = r.user_id ? card.get(r.user_id) : undefined; const care = r.user_id ? careAlerts.get(r.user_id) ?? [] : []; return (
        <li class:list={['rc', `rc--${st.tone}`, { 'rc--next': r.id === next?.id }]} id={`c-${r.id}`}>
          <p class="rc-time"><time datetime={r.starts_at.toISOString()}>{fmtTime(r.starts_at)}</time> <small>{length(r)}</small>
            <span class={`badge badge--${st.tone}`}>{st.label}</span></p>
          <h3>{r.user_id ? <a href={`/admin/clientes/${r.user_id}`}>{r.name ?? 'Cliente'}</a> : <span>{r.name ?? 'Sans nom'}</span>}
            {c && c.visits === 0 && <span class="badge badge--wait">Première visite</span>}{r.guest && <span class="badge badge--off">Sans compte</span>}</h3>
          <p class="rc-svc">{r.service}</p>
          <ul class="prep">
            {r.package && <li>Séance {r.package_n} sur {r.package_total} du forfait{begun && live && ' · déduite, rien à encaisser'}</li>}
            {consent && <li class="p-warn">{FORMS[consent].title} à signer</li>}
            {r.gift && !r.paid_method && <li>Bon cadeau : soin offert</li>}
            {r.late_minutes && <li>Retard {r.late_minutes} min</li>}
            {r.arrived_at && !r.paid_method && <li>Arrivée à {fmtTime(r.arrived_at)}</li>}
            {r.paid_method && <li>Encaissé {euros(r.paid_cents ?? 0)} · {PAY_METHODS[r.paid_method as PayMethod]}</li>}
            {care.length > 0 && <li><details class="care"><summary><span aria-hidden="true">⚠</span> À lire avant le soin ({care.length})</summary><p>{care.map((a) => <span class="badge badge--alert">{a}</span>)}</p></details></li>}
            {c?.notes && <li><details class="care"><summary>Note de la fiche</summary><p class="note">{c.notes}</p></details></li>}
          </ul>
          <div class="rc-acts">
            {primary === 'arrive' && <form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="arrive"><input type="hidden" name="id" value={r.id}>
              <button class="btn btn--solid big" type="submit">Arrivée<span class="visually-hidden"> de {r.name ?? 'la cliente'}</span></button></form>}
            {primary === 'consent' && <a class="btn btn--solid big" href={`/admin/clientes/${r.user_id}/consentement?type=${consent}`}>Faire signer sur la tablette</a>}
            {primary === 'pay' && <Encaisser r={r} />}
            <details class="more">
              <summary aria-label={`Plus d'actions : ${r.name ?? 'rendez-vous'} à ${fmtTime(r.starts_at)}`}><span aria-hidden="true">···</span></summary>
              <div class="menu">
                {live && !r.arrived_at && primary !== 'arrive' && <form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="arrive"><input type="hidden" name="id" value={r.id}>
                  <button class="btn btn--ghost" type="submit">Noter l'arrivée{r.past && ' (retard calculé)'}</button></form>}
                {live && r.arrived_at && !r.paid_method && <form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="unarrive"><input type="hidden" name="id" value={r.id}>
                  <button class="btn btn--ghost" type="submit">Annuler l'arrivée</button><small>Le retard calculé à l'arrivée est retiré, pas un retard saisi à la main.</small></form>}
                {live && r.past && (r.late_minutes
                  ? <form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="on_time"><input type="hidden" name="id" value={r.id}><button class="btn btn--ghost" type="submit">Retirer le retard</button></form>
                  : <details><summary>Retard</summary><form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="late"><input type="hidden" name="id" value={r.id}>
                      <label class="field">Minutes de retard<input type="number" name="late" required min="1" max="240" step="1" inputmode="numeric"></label><button class="btn btn--ghost" type="submit">Noter le retard</button></form></details>)}
                {r.status === 'confirmed' && r.past && (r.no_show
                  ? <form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="show"><input type="hidden" name="id" value={r.id}><button class="btn btn--ghost" type="submit">Retirer l'absence</button></form>
                  : <details><summary>Absente</summary><form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="no_show"><input type="hidden" name="id" value={r.id}>
                      <ul class="cons">{absence.map((t) => <li>{t}</li>)}</ul><button class="btn btn--ghost" type="submit">Confirmer l'absence</button></form></details>)}
                {live && r.paid_method && <details><summary>Retirer l'encaissement</summary><form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="unpay"><input type="hidden" name="id" value={r.id}>
                  <ul class="cons"><li>Le rendez-vous repasse « à encaisser ». Le montant sort de la caisse du jour.</li></ul><button class="btn btn--ghost" type="submit">Confirmer le retrait</button></form></details>}
                {(r.status === 'pending_payment' || (live && !r.past)) && <details><summary>Annuler le rendez-vous</summary><form method="post" action={`/admin#c-${r.id}`}><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value={r.id}>
                  <ul class="cons"><li>Le créneau est libéré.</li>{r.user_id && <li>La cliente reçoit un e-mail d'annulation.</li>}{r.package && <li>La séance est rendue au forfait.</li>}</ul>
                  {due > 0 && <label class="check"><input type="checkbox" name="refund"><span>Rembourser l'acompte ({euros(due)})</span></label>}
                  <button class="btn btn--ghost" type="submit">Confirmer l'annulation</button></form></details>}
                {admin && !r.past && <Supprimer id={r.id} label={`le rendez-vous de ${fmtTime(r.starts_at)}`} action="/admin" />}
                <p class="links">{r.user_id && <a href={`/admin/clientes/${r.user_id}`}>Fiche</a>}{r.phone && <a href={`tel:${digits(r.phone)}`}>Appeler</a>}<a href={`${agenda(today)}#r-${r.id}`}>Agenda</a></p>
              </div>
            </details>
          </div>
        </li>
      ); })}</ol>
    )}

    {/* Le soir : ce qui reste à encaisser, puis la caisse du jour par mode */}
    <details class="close" id="cloture" open={hourNow >= 17}>
      <summary><h2>Clôturer la journée</h2></summary>
      {toCash.length > 0 && <>
        <h3>À encaisser ({toCash.length})</h3>
        <ul class="cash">{toCash.map(({ r }) => (
          <li><p><strong>{fmtTime(r.starts_at)}</strong> {r.name ?? 'Sans nom'}<br><small>{r.service}</small></p><Encaisser r={r} label="Encaisser" /></li>
        ))}</ul>
      </>}
      <h3>Caisse du jour</h3>
      {tills.length === 0 && packageDone === 0 ? <p class="none">Aucun encaissement noté aujourd'hui.</p> : (
        <table class="till">
          <tbody>
            {tills.map((t) => <tr><th scope="row">{PAY_METHODS[t.k]}</th><td>{t.n} rendez-vous</td><td>{euros(t.cents)}</td></tr>)}
            {packageDone > 0 && <tr><th scope="row">Forfait</th><td>{packageDone} séance{packageDone > 1 ? 's' : ''}</td><td>rien à encaisser</td></tr>}
          </tbody>
          <tfoot><tr><th scope="row">Total encaissé</th><td></td><td>{euros(tillTotal)}</td></tr></tfoot>
        </table>
      )}
      {toCash.length === 0 && (stillOpen === 0
        ? <p class="closed" role="status">Journée close. Rien d'autre à faire.</p>
        : <p class="none">Encore {stillOpen} rendez-vous en cours ou à venir : la journée se clôture quand tout est encaissé.</p>)}
    </details>
  </section>

  <div class="side">
  <section class="panel cal" aria-labelledby="h-cal">
    <h2 id="h-cal"><span class="cap">{monthName}</span>
      <span class="cal-nav"><a href={`/admin?mois=${prevMonth}#h-cal`} aria-label="Mois précédent">‹</a><a href={`/admin?mois=${nextFirst.slice(0, 7)}#h-cal`} aria-label="Mois suivant">›</a></span></h2>
    <ol class="cal-grid" aria-label={`Rendez-vous par jour, ${monthName}`}>
      {['lun', 'mar', 'mer', 'jeu', 'ven', 'sam', 'dim'].map((d) => <li class="cal-dow" aria-hidden="true">{d}</li>)}
      {cells.map((d) => (
        <li class:list={['cal-day', `cal-l${level(load[d])}`, { 'cal-out': d.slice(0, 7) !== first.slice(0, 7), 'cal-today': d === today }]}>
          <a href={agenda(d)} aria-label={`${fmtDay(d)} : ${load[d] ?? 0} rendez-vous`}><span>{Number(d.slice(8))}</span>{load[d] ? <small>{load[d]}</small> : null}</a>
        </li>
      ))}
    </ol>
  </section>
  <section class="panel next7" aria-labelledby="h-week">
    <h2 id="h-week">7 prochains jours <a class="more-link" href="/admin/agenda">Agenda</a></h2>
    <ul>{Array.from({ length: 7 }, (_, i) => addDays(today, i)).map((d) => (
      <li><a href={agenda(d)}><span class="cap">{d === today ? "Aujourd'hui" : d === tomorrow ? 'Demain' : weekDay(new Date(`${d}T12:00:00Z`))}</span>
        <span class:list={['bar', `cal-l${level(week[d])}`]}>{week[d] ? `${week[d]} rendez-vous` : 'Libre'}</span></a></li>
    ))}</ul>
  </section>
  {/* Informations sans geste à faire : repliées, le nombre reste visible */}
  <details class="panel infos">
    <summary><h2>Infos ({infoCount})</h2></summary>
    {infoCount === 0 ? <p class="none">Rien de neuf.</p> : <ul>
      {al.pending.map((r) => <li class="al al--wait">Paiement en cours : {r.name ?? '—'}, {fmtDateTime(r.starts_at)}</li>)}
      {al.moved.map((r) => <li class="al"><a href={agenda(todayBrussels(r.starts_at))}>Déplacé</a> : {r.name ?? '—'}, {r.service}, maintenant le {fmtDateTime(r.starts_at)}</li>)}
      {al.cancelled.map((r) => <li class="al al--off">Annulé : {r.name ?? '—'}, {r.service}, {fmtDateTime(r.starts_at)}{r.cancel_reason === 'account_deleted' && ' (compte supprimé)'}</li>)}
      {al.newClients.map((c) => <li class="al al--ok">Nouvelle inscrite : <a href={`/admin/clientes/${c.id}`}>{c.name ?? c.email}</a>, le {shortDate(c.created_at)}</li>)}
      {al.closures.map((c) => <li class="al">Fermeture : {fmtDateTime(c.starts_at)} → {fmtDateTime(c.ends_at)}{c.reason && ` (${c.reason})`}</li>)}
    </ul>}
  </details>
  </div>
</div>
</Admin>

<style>
  .head-acts{display:flex;flex-wrap:wrap;gap:.5rem}
  h2{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem .75rem;margin:0 0 1rem;font-size:1.35rem}
  .none{margin:0;color:var(--text-soft);font-size:.9375rem}
  .cap::first-letter,.day-head h2::first-letter{text-transform:uppercase}
  .panel{border:1px solid var(--line-soft);border-radius:16px;background:var(--bg);padding:1.25rem;min-width:0}

  .day-head{margin:0 0 1rem}
  .day-head h2{margin:0 0 .3rem;font-size:1.6rem}
  .day-open{display:flex;flex-wrap:wrap;gap:.35rem .6rem;align-items:center;margin:0;color:var(--text-soft)}
  .todo{display:inline-flex;align-items:center;min-height:44px;padding:0 .75rem;border:1px dashed var(--line-soft);border-radius:999px;font-size:.875rem;color:var(--text-soft)}

  .gestures{display:grid;gap:.5rem;list-style:none;margin:0 0 1.25rem;padding:0}
  .gestures li>a{display:block;min-height:48px;padding:.75rem 1rem;border:1px solid var(--accent);border-radius:14px;background:rgb(138 90 82 / .1);color:var(--text);text-decoration:none}
  .gestures .g-alert{padding:.75rem 1rem;border:1px solid rgb(176 70 60 / .5);border-radius:14px;background:rgb(176 70 60 / .12)}

  .day{display:grid;gap:1.5rem}
  @media (min-width:1024px){.day{grid-template-columns:minmax(0,3fr) minmax(0,2fr);align-items:start}}
  .rdvs,.side{display:grid;gap:1.25rem;min-width:0}

  .cards{display:grid;gap:.85rem;list-style:none;margin:0;padding:0}
  .rc{display:grid;gap:.45rem;padding:1rem 1.1rem;border:1px solid var(--line-soft);border-left:4px solid var(--line-soft);border-radius:16px;background:var(--bg);min-width:0}
  .rc--ok{border-left-color:rgb(76 128 92)}
  .rc--due{border-left-color:var(--accent)}
  .rc--wait{border-left-color:rgb(196 150 70)}
  .rc--alert{border-left-color:rgb(176 70 60)}
  .rc--off{opacity:.7}
  .rc--next{box-shadow:0 0 0 2px var(--accent)}
  .rc p,.rc h3{margin:0}
  .rc-time{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .6rem;font-variant-numeric:tabular-nums}
  .rc-time time{font:500 1.35rem/1 var(--f-title)}
  .rc-time small{color:var(--text-soft)}
  .rc-time .badge{margin-left:auto}
  .badge--due{background:var(--accent);color:var(--bg)}
