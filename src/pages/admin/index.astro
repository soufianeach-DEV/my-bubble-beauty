---
export const prerender = false;
// Agenda : rendez-vous du jour ou de la semaine à l'heure de Bruxelles, annulation en deux temps et remboursement de l'acompte
import Admin from './_layout.astro';
import { adminId, agendaAction, fmtDay, fmtTime, readForm } from '../../lib/server/admin.ts';
import { addDays, monday } from '../../lib/server/admin-form.ts';
import { adminAgenda } from '../../lib/server/booking.ts';
import { euros, isDay, todayBrussels } from '../../lib/server/pricing.ts';

const me = adminId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
const q = Astro.url.searchParams;
const vue = q.get('vue') === 'jour' ? 'jour' : 'semaine';
const today = todayBrussels();
const jour = isDay(q.get('jour')) ? q.get('jour')! : today;
const link = (d: string, v = vue) => `/admin?jour=${d}&vue=${v}`;
let error = '';
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  const r = await agendaAction(me, form);
  if (r.ok) return Astro.redirect(`${link(jour)}&ok=${r.key}#r-${r.id}`, 303);
  error = r.error;
  Astro.response.status = 400;
}
const DONE: Record<string, string> = {
  annule: 'Rendez-vous annulé.',
  rembourse: 'Acompte remboursé, rendez-vous annulé.',
  echec: "Le remboursement n'a pas abouti. S'il reste un acompte à rendre, le bouton « Rembourser l'acompte » reste sur la ligne : réessayez plus tard.",
  cree: 'Rendez-vous enregistré.',
};
// Le formulaire repart vers l'URL courante : après un refus, le ?ok= du succès précédent ne doit plus s'afficher
const done = !error && DONE[q.get('ok') ?? ''];
const from = vue === 'jour' ? jour : monday(jour);
const count = vue === 'jour' ? 1 : 7;
const rows = await adminAgenda(from, count);
const days = Array.from({ length: count }, (_, i) => addDays(from, i)).map((d) => ({ d, rows: rows.filter((r) => todayBrussels(r.starts_at) === d) }));
const STATUS = { confirmed: 'Confirmé', pending_payment: 'Paiement en cours', cancelled: 'Annulé', expired: 'Payé après expiration' };
// Acompte encaissé et pas encore rendu
const due = (r: (typeof rows)[number]) => (r.paid ? r.deposit_cents - r.refunded_cents : 0);
---
<Admin title="Agenda">
{done && <p class="notice" role="status">{done}</p>}
{error && <p class="notice notice--error" role="alert">{error}</p>}
<div class="actions bar">
  <a class="btn btn--ghost" href={link(addDays(from, -count))}>{vue === 'jour' ? 'Jour précédent' : 'Semaine précédente'}</a>
  <a class="btn btn--ghost" href={link(today)}>Aujourd'hui</a>
  <a class="btn btn--ghost" href={link(addDays(from, count))}>{vue === 'jour' ? 'Jour suivant' : 'Semaine suivante'}</a>
  <a class="btn btn--solid" href="/admin/reservations/nouvelle">Saisir un rendez-vous</a>
</div>
<form class="actions bar" method="get" action="/admin">
  <div class="field"><label for="jour">Jour</label><input id="jour" name="jour" type="date" value={jour} required></div>
  <div class="field"><label for="vue">Affichage</label>
    <select id="vue" name="vue"><option value="semaine" selected={vue === 'semaine'}>Semaine</option><option value="jour" selected={vue === 'jour'}>Jour</option></select>
  </div>
  <button class="btn btn--ghost" type="submit">Afficher</button>
</form>
{days.map(({ d, rows }) => (
  <section aria-labelledby={`d-${d}`}>
    <h2 id={`d-${d}`}><a href={link(d, 'jour')}>{fmtDay(d)}</a>{d === today && ' (aujourd\'hui)'}</h2>
    {rows.length === 0 ? <p>Aucun rendez-vous.</p> : (
      <div class="table-wrap"><table class="data-table">
        <thead><tr><th scope="col">Heure</th><th scope="col">Prestation</th><th scope="col">Cliente</th><th scope="col">Statut</th><th scope="col">Montants</th><th scope="col">Actions</th></tr></thead>
        <tbody>{rows.map((r) => (
          <tr id={`r-${r.id}`}>
            <td>{fmtTime(r.starts_at)}–{fmtTime(r.ends_at)}</td>
            <td>{r.service}</td>
            <td>
              {r.name ?? '—'}{r.guest && <small> (saisie par l'institut)</small>}
              {r.phone && <><br><a href={`tel:${r.phone.replace(/[^0-9+]/g, '')}`}>{r.phone}</a></>}
              {r.email && <><br><small>{r.email}</small></>}
            </td>
            <td>
              {STATUS[r.status]}
              {r.status === 'cancelled' && due(r) > 0 && <><br><small>Acompte gardé ou remboursement à relancer</small></>}
              {r.status === 'expired' && <><br><small>Créneau repris : acompte à rendre</small></>}
            </td>
            <td>
              Prix {euros(r.price_cents)}
              {r.discount_cents > 0 && <><br>Remise −{euros(r.discount_cents)}{r.promo && ` (${r.promo})`}</>}
              <br>Acompte {r.deposit_cents > 0 ? `${euros(r.deposit_cents)}${r.paid ? ' payé' : ' non payé'}` : 'aucun'}
              {r.refunded_cents > 0 && <><br>Remboursé {euros(r.refunded_cents)}</>}
            </td>
            <td>
              {(r.status === 'confirmed' || r.status === 'pending_payment') && (
                <details class="cancel"><summary>Annuler<span class="visually-hidden"> le rendez-vous de {fmtTime(r.starts_at)}, {r.name ?? r.service}</span></summary>
                  <form class="cell-form" method="post">
                    <input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value={r.id}>
                    {due(r) > 0 && <label class="check"><input type="checkbox" name="refund"><span>Rembourser l'acompte ({euros(due(r))})</span></label>}
                    <button class="btn btn--ghost" type="submit">Confirmer l'annulation</button>
                  </form>
                </details>
              )}
              {(r.status === 'cancelled' || r.status === 'expired') && due(r) > 0 && (
                <form class="cell-form" method="post">
                  <input type="hidden" name="action" value="refund"><input type="hidden" name="id" value={r.id}>
                  <button class="btn btn--ghost" type="submit">Rembourser l'acompte ({euros(due(r))})</button>
                </form>
              )}
            </td>
          </tr>
        ))}</tbody>
      </table></div>
    )}
  </section>
))}
</Admin>

<style>
  .bar{margin:0 0 1.25rem;align-items:flex-end}
  .bar .field{min-width:10rem}
  h2 a{color:inherit;text-decoration:none}
  h2 a:hover{text-decoration:underline}
  .cell-form{display:grid;gap:.5rem;justify-items:start}
  .cell-form .btn{min-height:44px;padding:.55rem 1rem;white-space:normal;text-align:left;line-height:1.3}
</style>
