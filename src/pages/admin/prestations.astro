---
export const prerender = false;
// Prestations : durée, prix, ordre, noms et ouverture à la réservation en ligne ; une ligne = un formulaire, jamais de suppression
import Admin from './_layout.astro';
import { adminId, bulkServices, byCategory, listServices, readForm, saveService } from '../../lib/server/admin.ts';
import { JS_VERSION } from '../../lib/site';
import { centsInput } from '../../lib/server/admin-form.ts';

const me = adminId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
// Message affiché sous la ligne enregistrée (le formulaire renvoie sur son ancre)
let flash: { id: number; text: string; error?: boolean } | null = null;
// Message de l'action en lot, affiché au-dessus de la liste
let bulkMsg: { text: string; error?: boolean } | null = null;
const q = Astro.url.searchParams;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  if (form.get('lot') === '1') {
    const b = await bulkServices(me, form);
    if (b.ok) return Astro.redirect(`/admin/prestations?lot=${form.get('bulk') === 'on' ? 'on' : 'off'}&n=${b.changed}&sans=${b.skipped}#lot`, 303);
    bulkMsg = { text: b.error, error: true };
  } else {
    const r = await saveService(me, form);
    if (r.ok) return Astro.redirect(`/admin/prestations?ok=${r.id}#p-${r.id}`, 303);
    flash = { id: Number(form.get('id')), text: r.error, error: true };
  }
  Astro.response.status = 400;
} else if (q.has('ok')) flash = { id: Number(q.get('ok')), text: 'Prestation enregistrée.' };
else if (q.has('lot')) {
  const n = Number(q.get('n')) || 0, sans = Number(q.get('sans')) || 0, s = n > 1 ? 's' : '';
  bulkMsg = { text: `${n} prestation${s} mise${s} ${q.get('lot') === 'on' ? 'en ligne' : 'hors ligne'}.`
    + (sans ? ` ${sans} sans durée ${sans > 1 ? 'restent' : 'reste'} hors ligne : indiquez une durée dans la barre de sélection.` : '') };
}
const groups = byCategory(await listServices());
---
<Admin title="Prestations">
<script is:inline src={`/assets/js/admin-selection.js?v=${JS_VERSION}`} defer></script>
<p>Une prestation n'est proposée en ligne qu'avec une durée. Prix en euros (35 ou 12,50). Aucun paiement en ligne : la cliente règle au salon. Enregistrez chaque ligne séparément, ou cochez plusieurs prestations et utilisez la barre de sélection.</p>
{/* Barre de sélection : les cases des cartes s'y rattachent par form="lot" ; « tout sélectionner » ne s'affiche qu'avec admin-selection.js */}
<form id="lot" class="lot" method="post" action="#lot" data-selection>
  <input type="hidden" name="lot" value="1">
  <div class="lot-pick" data-selection-tools hidden>
    <button class="btn btn--ghost" type="button" data-select="all">Tout sélectionner</button>
    <button class="btn btn--ghost" type="button" data-select="none">Tout désélectionner</button>
    <span class="lot-count" data-selection-count aria-live="polite">0 sélectionnée</span>
  </div>
  <div class="lot-act">
    <label>Durée pour la sélection (min, facultatif)<input name="duration" type="number" min="5" max="600" step="1" inputmode="numeric"></label>
    <button class="btn btn--solid" type="submit" name="bulk" value="on">Mettre en ligne</button>
    <button class="btn btn--ghost" type="submit" name="bulk" value="off">Mettre hors ligne</button>
  </div>
  {bulkMsg && <p class={bulkMsg.error ? 'notice notice--error' : 'notice'} role={bulkMsg.error ? 'alert' : 'status'}>{bulkMsg.text}</p>}
</form>
{flash?.error && !groups.some((g) => g.items.some((s) => s.id === flash!.id)) && <p class="notice notice--error" role="alert">{flash.text}</p>}
{groups.map((g) => (
  <section aria-labelledby={`c-${g.key}`}>
    <h2 id={`c-${g.key}`}>{g.label} <small>({g.items.filter((s) => s.active).length} en ligne sur {g.items.length})</small></h2>
    <div class="svc-list">{g.items.map((s) => (
      <form id={`p-${s.id}`} class:list={['svc', { 'svc--off': !s.active }]} method="post" action={`#p-${s.id}`}>
        <input type="hidden" name="id" value={s.id}>
        <label class="pick"><input type="checkbox" name="ids" value={s.id} form="lot" data-select-item><span>Sélectionner<span class="visually-hidden"> {s.name_fr}</span></span>{s.duration_min === null && <span class="badge badge--wait">Sans durée</span>}</label>
        <fieldset class="names"><legend class="visually-hidden">Noms de la prestation</legend>
          <label><span>FR</span><input name="name_fr" value={s.name_fr} maxlength="200" required lang="fr"></label>
          <label><span>NL</span><input name="name_nl" value={s.name_nl} maxlength="200" required lang="nl"></label>
          <label><span>EN</span><input name="name_en" value={s.name_en} maxlength="200" required lang="en"></label>
        </fieldset>
        <div class="row"><div class="nums">
          <label>Durée (min)<input name="duration" type="number" min="5" max="600" step="1" value={s.duration_min ?? ''}></label>
          <label>Tampon (min)<input name="buffer" type="number" min="0" max="120" step="5" value={s.buffer_min}></label>
          <label>Prix (€)<input name="price" inputmode="decimal" pattern="[0-9]{1,5}([.,][0-9]{1,2})?" value={centsInput(s.price_cents)} required></label>
          <label>Ordre<input name="sort" type="number" min="0" max="9999" step="1" value={s.sort} required></label>
        </div>
        <div class="end">
          <label class="check"><input name="active" type="checkbox" checked={s.active}><span>En ligne</span></label>
          <button class="btn btn--ghost" type="submit">Enregistrer<span class="visually-hidden"> {s.name_fr}</span></button>
        </div></div>
        {flash?.id === s.id && <p class={flash.error ? 'notice notice--error' : 'notice'} role={flash.error ? 'alert' : 'status'}>{flash.text}</p>}
      </form>
    ))}</div>
  </section>
))}
</Admin>

<style>
  .svc-list{display:grid;gap:.75rem;margin:0 0 2rem}
  /* Barre de sélection : collée en haut sur ordinateur pendant le défilement des 150 cartes ; sur téléphone elle prendrait l'écran */
  @media (min-width:1024px){.lot{position:sticky;top:0;z-index:4}}
  .lot{display:grid;gap:.75rem;margin:0 0 1.5rem;padding:1rem 1.25rem;border:1px solid var(--line-soft);border-radius:16px;background:var(--surface);box-shadow:0 6px 18px rgb(0 0 0 / .06)}
  .lot-pick,.lot-act{display:flex;flex-wrap:wrap;gap:.6rem 1rem;align-items:flex-end}
  .lot-pick[hidden]{display:none}
  .lot-act label{display:grid;gap:.25rem;font-size:.8125rem;color:var(--text-soft)}
  .lot-act input{width:9rem;min-height:44px;padding:.4rem .6rem;border:1px solid var(--line-soft);border-radius:8px;background:rgb(var(--card));color:var(--text);font:inherit}
  .lot .btn{min-height:44px;padding:.55rem 1.1rem}
  .lot-count{align-self:center;font-size:.9375rem;color:var(--text-soft)}
  .lot .notice{margin:0}
  .pick{display:flex !important;flex-direction:row;align-items:center;gap:.5rem;min-height:44px;font-size:.9375rem !important;color:var(--text) !important}
  .pick input{width:1.25rem;height:1.25rem;margin:0;accent-color:var(--accent)}
  .svc:has(.pick input:checked){border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent);opacity:1}
  /* Une carte par prestation : les trois noms côte à côte, puis chiffres et enregistrement sur une ligne ; tout passe à la ligne au lieu de déborder */
  .svc{display:grid;gap:.9rem;padding:1rem 1.25rem;border:1px solid var(--line-soft);border-radius:16px;background:var(--bg);scroll-margin-top:calc(var(--header-h) + 1rem)}
  .svc--off{opacity:.72}
  .svc--off:focus-within{opacity:1}
  .svc input:not([type="checkbox"]){width:100%;min-width:0;min-height:44px;padding:.4rem .6rem;border:1px solid var(--line-soft);border-radius:8px;background:rgb(var(--card));color:var(--text);font:inherit}
  .svc label{display:grid;gap:.25rem;font-size:.8125rem;color:var(--text-soft)}
  .names{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:.6rem;margin:0;padding:0;border:0;min-width:0}
  .names span{font-weight:500;letter-spacing:.08em}
  .nums{display:flex;flex-wrap:wrap;gap:.6rem}
  .nums label{width:6.75rem}
  .row{display:flex;flex-wrap:wrap;gap:.9rem 1.5rem;align-items:flex-end;justify-content:space-between}
  .end{display:flex;flex-wrap:wrap;gap:.6rem 1.25rem;align-items:center}
  .end .check{display:flex;flex-direction:row;align-items:center;gap:.5rem;min-height:44px;font-size:.9375rem;color:var(--text)}
  .end input[type="checkbox"]{width:1.25rem;height:1.25rem;margin:0;accent-color:var(--accent)}
  .end .btn{min-height:44px;padding:.55rem 1.1rem}
  .svc .notice{margin:0}
  h2 small{font-size:1rem;color:var(--text-soft)}
  @media (max-width:599px){.nums label{width:calc(50% - .3rem)}}
</style>
