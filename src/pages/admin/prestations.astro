---
export const prerender = false;
// Prestations : durée, prix, ordre, noms et ouverture à la réservation en ligne ; une ligne = un formulaire, jamais de suppression
import Admin from './_layout.astro';
import { adminId, byCategory, listServices, readForm, saveService } from '../../lib/server/admin.ts';
import { centsInput } from '../../lib/server/admin-form.ts';

const me = adminId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
// Message affiché sous la ligne enregistrée (le formulaire renvoie sur son ancre)
let flash: { id: number; text: string; error?: boolean } | null = null;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  const r = await saveService(me, form);
  if (r.ok) return Astro.redirect(`/admin/prestations?ok=${r.id}#p-${r.id}`, 303);
  flash = { id: Number(form.get('id')), text: r.error, error: true };
  Astro.response.status = 400;
} else if (Astro.url.searchParams.has('ok')) flash = { id: Number(Astro.url.searchParams.get('ok')), text: 'Prestation enregistrée.' };
const groups = byCategory(await listServices());
---
<Admin title="Prestations">
<p>Une prestation n'est proposée en ligne que cochée « En ligne », et seulement avec une durée. Prix en euros (35 ou 12,50). Aucun paiement en ligne : la cliente règle au salon. Enregistrez chaque ligne séparément.</p>
{flash?.error && !groups.some((g) => g.items.some((s) => s.id === flash!.id)) && <p class="notice notice--error" role="alert">{flash.text}</p>}
{groups.map((g) => (
  <section aria-labelledby={`c-${g.key}`}>
    <h2 id={`c-${g.key}`}>{g.label} <small>({g.items.filter((s) => s.active).length} en ligne sur {g.items.length})</small></h2>
    <div class="svc-list">{g.items.map((s) => (
      <form id={`p-${s.id}`} class:list={['svc', { 'svc--off': !s.active }]} method="post" action={`#p-${s.id}`}>
        <input type="hidden" name="id" value={s.id}>
        <fieldset class="names"><legend class="visually-hidden">Noms de la prestation</legend>
          <label><span>FR</span><input name="name_fr" value={s.name_fr} maxlength="200" required lang="fr"></label>
          <label><span>NL</span><input name="name_nl" value={s.name_nl} maxlength="200" required lang="nl"></label>
          <label><span>EN</span><input name="name_en" value={s.name_en} maxlength="200" required lang="en"></label>
        </fieldset>
        <div class="row"><div class="nums">
          <label>Durée (min)<input name="duration" type="number" min="5" max="600" step="1" value={s.duration_min ?? ''}></label>
          <label>Tampon (min)<input name="buffer" type="number" min="0" max="120" step="5" value={s.buffer_min}></label>
          <label>Prix (€)<input name="price" inputmode="decimal" pattern="[0-9]{1,5}([.,][0-9]{1,2})?" value={centsInput(s.price_cents)} required></label>
          <label>Ordre<input name="sort" type="number" min="0" max="9999" step="1" value={s.sort} required></label>
        </div>
        <div class="end">
          <label class="check"><input name="active" type="checkbox" checked={s.active}><span>En ligne</span></label>
          <button class="btn btn--ghost" type="submit">Enregistrer<span class="visually-hidden"> {s.name_fr}</span></button>
        </div></div>
        {flash?.id === s.id && <p class={flash.error ? 'notice notice--error' : 'notice'} role={flash.error ? 'alert' : 'status'}>{flash.text}</p>}
      </form>
    ))}</div>
  </section>
))}
</Admin>

<style>
  .svc-list{display:grid;gap:.75rem;margin:0 0 2rem}
  /* Une carte par prestation : les trois noms côte à côte, puis chiffres et enregistrement sur une ligne ; tout passe à la ligne au lieu de déborder */
  .svc{display:grid;gap:.9rem;padding:1rem 1.25rem;border:1px solid var(--line-soft);border-radius:16px;background:var(--bg);scroll-margin-top:calc(var(--header-h) + 1rem)}
  .svc--off{opacity:.72}
  .svc--off:focus-within{opacity:1}
  .svc input:not([type="checkbox"]){width:100%;min-width:0;min-height:44px;padding:.4rem .6rem;border:1px solid var(--line-soft);border-radius:8px;background:rgb(var(--card));color:var(--text);font:inherit}
  .svc label{display:grid;gap:.25rem;font-size:.8125rem;color:var(--text-soft)}
  .names{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:.6rem;margin:0;padding:0;border:0;min-width:0}
  .names span{font-weight:500;letter-spacing:.08em}
  .nums{display:flex;flex-wrap:wrap;gap:.6rem}
  .nums label{width:6.75rem}
  .row{display:flex;flex-wrap:wrap;gap:.9rem 1.5rem;align-items:flex-end;justify-content:space-between}
  .end{display:flex;flex-wrap:wrap;gap:.6rem 1.25rem;align-items:center}
  .end .check{display:flex;flex-direction:row;align-items:center;gap:.5rem;min-height:44px;font-size:.9375rem;color:var(--text)}
  .end input[type="checkbox"]{width:1.25rem;height:1.25rem;margin:0;accent-color:var(--accent)}
  .end .btn{min-height:44px;padding:.55rem 1.1rem}
  .svc .notice{margin:0}
  h2 small{font-size:1rem;color:var(--text-soft)}
  @media (max-width:599px){.nums label{width:calc(50% - .3rem)}}
</style>
