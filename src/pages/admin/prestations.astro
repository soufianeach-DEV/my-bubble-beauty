---
export const prerender = false;
// Prestations : durée, prix, acompte, ordre, noms et ouverture à la réservation en ligne ; une ligne = un formulaire, jamais de suppression
import Admin from './_layout.astro';
import { adminId, byCategory, listServices, readForm, saveService } from '../../lib/server/admin.ts';
import { centsInput } from '../../lib/server/admin-form.ts';

const me = adminId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
// Message affiché sous la ligne enregistrée (le formulaire renvoie sur son ancre)
let flash: { id: number; text: string; error?: boolean } | null = null;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  const r = await saveService(me, form);
  if (r.ok) return Astro.redirect(`/admin/prestations?ok=${r.id}#p-${r.id}`, 303);
  flash = { id: Number(form.get('id')), text: r.error, error: true };
  Astro.response.status = 400;
} else if (Astro.url.searchParams.has('ok')) flash = { id: Number(Astro.url.searchParams.get('ok')), text: 'Prestation enregistrée.' };
const groups = byCategory(await listServices());
---
<Admin title="Prestations">
<p>Une prestation n'est proposée en ligne que cochée « En ligne », et seulement avec une durée. Montants en euros (35 ou 12,50) ; acompte 0 = réservation confirmée sans paiement. Enregistrez chaque ligne séparément.</p>
{flash?.error && !groups.some((g) => g.items.some((s) => s.id === flash!.id)) && <p class="notice notice--error" role="alert">{flash.text}</p>}
{groups.map((g) => (
  <section aria-labelledby={`c-${g.key}`}>
    <h2 id={`c-${g.key}`}>{g.label} <small>({g.items.filter((s) => s.active).length} en ligne sur {g.items.length})</small></h2>
    <div class="table-wrap"><table class="data-table svc">
      <thead><tr><th scope="col">Noms FR / NL / EN</th><th scope="col">Durée (min)</th><th scope="col">Prix (€)</th><th scope="col">Acompte (€)</th><th scope="col">Ordre</th><th scope="col">En ligne</th><th scope="col"><span class="visually-hidden">Enregistrer</span></th></tr></thead>
      <tbody>{g.items.map((s) => {
        const f = `f-${s.id}`;
        return (
          <>
            <tr id={`p-${s.id}`}>
              <td><div class="names">
                <form id={f} method="post" action={`#p-${s.id}`}><input type="hidden" name="id" value={s.id}></form>
                <input form={f} name="name_fr" value={s.name_fr} maxlength="200" required aria-label={`Nom français (${s.name_fr})`} lang="fr">
                <input form={f} name="name_nl" value={s.name_nl} maxlength="200" required aria-label={`Nom néerlandais (${s.name_fr})`} lang="nl">
                <input form={f} name="name_en" value={s.name_en} maxlength="200" required aria-label={`Nom anglais (${s.name_fr})`} lang="en">
              </div></td>
              <td><input form={f} name="duration" type="number" min="5" max="600" step="1" value={s.duration_min ?? ''} aria-label={`Durée en minutes (${s.name_fr})`}></td>
              <td><input form={f} name="price" inputmode="decimal" pattern="[0-9]{1,5}([.,][0-9]{1,2})?" value={centsInput(s.price_cents)} required aria-label={`Prix en euros (${s.name_fr})`}></td>
              <td><input form={f} name="deposit" inputmode="decimal" pattern="[0-9]{1,5}([.,][0-9]{1,2})?" value={centsInput(s.deposit_cents)} required aria-label={`Acompte en euros (${s.name_fr})`}></td>
              <td><input form={f} name="sort" type="number" min="0" max="9999" step="1" value={s.sort} required aria-label={`Ordre d'affichage (${s.name_fr})`}></td>
              <td><input form={f} name="active" type="checkbox" checked={s.active} aria-label={`Proposée en ligne (${s.name_fr})`}></td>
              <td><button form={f} class="btn btn--ghost" type="submit">Enregistrer</button></td>
            </tr>
            {flash?.id === s.id && (
              <tr><td colspan="7"><p class={flash.error ? 'notice notice--error' : 'notice'} role={flash.error ? 'alert' : 'status'}>{flash.text}</p></td></tr>
            )}
          </>
        );
      })}</tbody>
    </table></div>
  </section>
))}
</Admin>

<style>
  .svc input:not([type="checkbox"]){font:inherit;color:var(--text);background:var(--bg);border:1px solid var(--line-soft);border-radius:8px;padding:.4rem .55rem;min-height:44px;width:6rem}
  .svc .names{display:grid;gap:.35rem;min-width:16rem}
  .svc .names input{width:100%}
  .svc form{display:contents}
  .svc input[type="checkbox"]{width:1.25rem;height:1.25rem;accent-color:var(--accent)}
  .svc td{vertical-align:middle}
  .svc .btn{min-height:44px;padding:.55rem 1rem}
  .svc .notice{margin:0}
  h2 small{font-size:1rem;color:var(--text-soft)}
</style>
