---
export const prerender = false;
// Clientes : tableau de bord des comptes confirmés (séances, total, absences, retards, avantages), recherche, filtre par état,
// tri par colonne, 25 par page ; un clic sur le nom ouvre la fiche.
// Colonne Actions (admin seulement, comme sur la fiche) : désactiver ou réactiver, supprimer (suppression douce) ou restaurer.
// Même chemin que la fiche (clientAction) : sessions fermées, journal ; l'effacement définitif reste sur la fiche.
import Admin from './_layout.astro';
import { adminId, staffId, fmtDateTime, readForm } from '../../lib/server/admin.ts';
import { CLIENT_SORTS, clientAction, clientCounts, listClients, type ClientFilter, type ClientSort } from '../../lib/server/admin-clientes.ts';
import { euros } from '../../lib/server/pricing.ts';

const me = staffId(Astro.locals);
if (!me) return new Response(null, { status: 404 });
const manage = adminId(Astro.locals) !== null;
const sp = Astro.url.searchParams;
let error = '';
let errorId: number | null = null;
if (Astro.request.method === 'POST') {
  if (!manage) return new Response(null, { status: 404 });
  const form = await readForm(Astro.request);
  if (!form) return new Response(null, { status: 413 });
  const action = String(form.get('action') ?? '');
  // Seules les actions de la liste passent ici ; notes, annulation de suppression et effacement restent sur la fiche
  const r = ['block', 'unblock', 'remove', 'unremove'].includes(action) ? await clientAction(me, form, true) : { ok: false as const, error: 'Action inconnue.' };
  if (r.ok) {
    // Même onglet, même recherche et même page après l'action
    const back = new URLSearchParams(sp);
    back.set('ok', r.key ?? '');
    return Astro.redirect(`/admin/clientes?${back}#c-${r.id}`, 303);
  }
  error = r.error;
  errorId = Number(form.get('id')) || null;
  Astro.response.status = 400;
}
const q = (sp.get('q') ?? '').slice(0, 100);
const FILTERS: Record<ClientFilter, string> = { actives: 'Actives', suppression: 'En suppression (30 jours)', bloquees: 'Désactivées', toutes: 'Toutes', supprimees: 'Supprimées' };
const filter = (Object.hasOwn(FILTERS, sp.get('etat') ?? '') ? sp.get('etat') : 'actives') as ClientFilter;
const page = Math.min(Math.max(Number.parseInt(sp.get('page') ?? '1', 10) || 1, 1), 1000);
const SORTS: Record<ClientSort, string> = { nom: 'Nom', visites: 'Séances faites', avenir: 'Séances à venir', derniere: 'Dernière visite', total: 'Total payé', absences: 'Absences', retards: 'Retards', depuis: 'Inscription' };
const sort = (Object.hasOwn(SORTS, sp.get('tri') ?? '') ? sp.get('tri') : 'nom') as ClientSort;
const dir = sp.get('sens') === 'asc' || sp.get('sens') === 'desc' ? (sp.get('sens') as 'asc' | 'desc') : CLIENT_SORTS[sort][1];
const [{ rows, more, loyalty }, counts] = await Promise.all([listClients(q, filter, page, sort, dir), clientCounts()]);
const link = (p: number, etat: string = filter, tri: ClientSort = sort, sens: string = dir) => `/admin/clientes?${new URLSearchParams({ q, etat, tri, sens, page: String(p) })}`;
// En-tête triable : un clic trie, un second clic inverse le sens
const th = (k: ClientSort) => ({ href: link(1, filter, k, k === sort ? (dir === 'asc' ? 'desc' : 'asc') : CLIENT_SORTS[k][1]), sort: k === sort ? (dir === 'asc' ? 'ascending' : 'descending') : undefined });
const LANGS: Record<string, string> = { fr: 'FR', nl: 'NL', en: 'EN' };
const plural = (n: number, one: string, many: string) => `${n} ${n > 1 ? many : one}`;
const day = new Intl.DateTimeFormat('fr-BE', { timeZone: 'Europe/Brussels', dateStyle: 'medium' }).format;
const erased = sp.get('ok') === 'efface';
const DONE: Record<string, string> = { block: 'Compte désactivé : la cliente est déconnectée et ne peut plus se connecter ni réserver. Ses rendez-vous restent.', unblock: 'Compte réactivé.',
  remove: "Compte supprimé : il sort des listes et ne peut plus se connecter. Ses rendez-vous restent ; rien n'est effacé.", unremove: 'Compte restauré : la cliente peut de nouveau se connecter.' };
const done = !error && DONE[sp.get('ok') ?? ''];
---
<Admin title="Clientes">
{erased && <p class="notice" role="status">Compte effacé. Ses rendez-vous restent dans l'agenda, marqués « compte supprimé ».</p>}
{done && <p class="notice" role="status">{done}</p>}
{error && <p class="notice notice--error" role="alert">{error}</p>}
<nav class="tabs" aria-label="État des comptes">{(Object.keys(FILTERS) as ClientFilter[]).map((k) => (
  <a href={link(1, k)} aria-current={k === filter ? 'page' : undefined}>{FILTERS[k]} <span class="count">{counts[k]}</span></a>
))}</nav>
<form class="actions bar" method="get" action="/admin/clientes" role="search">
  <input type="hidden" name="etat" value={filter}>
  <div class="field grow"><label for="q">Nom, e-mail ou téléphone</label><input id="q" name="q" type="search" value={q} maxlength="100" autocomplete="off"></div>
  <div class="field"><label for="tri">Trier par</label><select id="tri" name="tri">{(Object.keys(SORTS) as ClientSort[]).map((k) => <option value={k} selected={k === sort}>{SORTS[k]}</option>)}</select></div>
  <button class="btn btn--ghost" type="submit">Afficher</button>
</form>
<p class="hint">Seuls les comptes dont l'adresse est confirmée apparaissent. Les rendez-vous saisis pour une personne sans compte restent dans l'agenda.</p>
{rows.length === 0 ? <p>Aucune cliente ne correspond.</p> : (
<div class="table-wrap"><table class="data-table dash">
  <caption class="visually-hidden">Clientes, triées par {SORTS[sort].toLowerCase()} ({dir === 'asc' ? 'croissant' : 'décroissant'})</caption>
  <thead><tr>
    <th scope="col" aria-sort={th('nom').sort}><a href={th('nom').href}>Cliente</a></th>
    <th scope="col" aria-sort={th('visites').sort}><a href={th('visites').href}>Séances</a></th>
    <th scope="col" aria-sort={th('total').sort} class="num"><a href={th('total').href}>Total payé</a></th>
    <th scope="col" aria-sort={th('absences').sort}><a href={th('absences').href}>Absences et retards</a></th>
    <th scope="col">Abonnements et avantages</th>
    <th scope="col">État</th>{manage && <th scope="col">Actions</th>}
  </tr></thead>
  <tbody>{rows.map((c) => (
    <tr id={`c-${c.id}`} class:list={{ 'row-error': errorId === c.id }}>
      <td><a class="who" href={`/admin/clientes/${c.id}`}>{c.name || c.email}</a> <small class="lang">{LANGS[c.locale] ?? c.locale}</small>
        {c.name && <><br><small>{c.email}</small></>}
        {c.phone && <><br><small><a href={`tel:${c.phone.replace(/[^0-9+]/g, '')}`}>{c.phone}</a></small></>}</td>
      <td>{c.done} faite{c.done > 1 && 's'} · {c.upcoming} à venir
        <br><small>{c.last_at ? <>Dernière visite : {day(c.last_at)}</> : 'Pas encore venue'}</small></td>
      <td class="num">{euros(c.spent_cents)}</td>
      <td>{c.no_shows === 0 && c.lates === 0 ? '—' : <>
        {c.no_shows > 0 && <span class="badge badge--alert">{plural(c.no_shows, 'absence', 'absences')}</span>}
        {c.lates > 0 && <span class="badge badge--wait">{plural(c.lates, 'retard', 'retards')} · {c.late_minutes} min</span>}</>}</td>
      <td><small>Abonnement : —</small>
        {c.gifts > 0 && <><br><small>{plural(c.gifts, 'bon cadeau valable', 'bons cadeaux valables')}</small></>}
        <br><small>Fidélité : {c.loyalty_sessions} / {loyalty.free_after} séances</small>
        {c.reward === 'free' && <><br><span class="badge badge--ok">Soin offert dû</span></>}
        {c.reward === 'discount' && <><br><span class="badge badge--ok">Remise de {loyalty.discount_percent} % due</span></>}</td>
      <td>{c.removed_at && <span class="badge badge--alert">Supprimée le {day(c.removed_at)}</span>}{c.blocked_at && <span class="badge badge--alert">Désactivée</span>}{c.deleted_at && <span class="badge badge--wait">Suppression demandée le {day(c.deleted_at)}</span>}
        {!c.blocked_at && !c.deleted_at && !c.removed_at && <small>Cliente depuis {day(c.created_at)}</small>}</td>
      {manage && <td>
        <details class="row-acts">
          <summary>Actions<span class="visually-hidden"> pour {c.name || c.email}</span></summary>
          <div class="acts">
            {!c.removed_at && <form method="post">
              <input type="hidden" name="action" value={c.blocked_at ? 'unblock' : 'block'}><input type="hidden" name="id" value={c.id}>
              <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
              <button class="btn btn--ghost" type="submit">{c.blocked_at ? 'Réactiver' : 'Désactiver'}</button>
            </form>}
            <form method="post">
              <input type="hidden" name="action" value={c.removed_at ? 'unremove' : 'remove'}><input type="hidden" name="id" value={c.id}>
              {!c.removed_at && c.upcoming > 0 && <p class="warn">{c.upcoming} rendez-vous à venir : ils restent dans l'agenda. Annulez-les d'abord si besoin.</p>}
              <label class="check"><input type="checkbox" name="confirm" required><span>Je confirme</span></label>
              <button class="btn btn--ghost" type="submit">{c.removed_at ? 'Restaurer' : 'Supprimer'}</button>
            </form>
          </div>
        </details>
      </td>}
    </tr>
  ))}</tbody>
</table></div>
)}
<nav class="actions bar" aria-label="Pages">
  {page > 1 && <a class="btn btn--ghost" href={link(page - 1)}>Page précédente</a>}
  {more && <a class="btn btn--ghost" href={link(page + 1)}>Page suivante</a>}
</nav>
</Admin>

<style>
  /* Onglets avec compteur : les comptes bloqués ou en suppression se voient sans ouvrir de menu */
  .tabs{display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 1.25rem}
  .tabs a{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;padding:.4rem 1rem;border:1px solid var(--line-soft);border-radius:999px;color:var(--text);text-decoration:none;font-size:.9375rem}
  .tabs a:hover,.tabs a:focus-visible{background:rgb(var(--card))}
  .tabs a[aria-current="page"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
  .count{min-width:1.5rem;padding:0 .4rem;border-radius:999px;background:rgb(0 0 0 / .1);font-size:.8125rem;text-align:center}
  .bar{margin:0 0 1.25rem;align-items:flex-end}
  .bar .grow{flex:1 1 16rem}
  td .badge + .badge{margin-top:.3rem}
  /* Actions repliées dans la ligne : la liste reste lisible, deux clics et une case pour agir */
  .row-acts summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font-weight:500;white-space:nowrap}
  .row-acts .acts{display:grid;gap:.75rem;padding:.5rem 0;min-width:13rem}
  .row-acts form{display:grid;gap:.35rem;justify-items:start}
  .row-acts .check{display:flex;align-items:center;gap:.5rem;min-height:44px;font-size:.875rem}
  .row-acts .check input{width:1.25rem;height:1.25rem;margin:0;accent-color:var(--accent)}
  .row-acts .warn{margin:0;font-size:.8125rem;color:var(--text-soft);max-width:16rem}
  .row-error{outline:2px solid var(--accent);outline-offset:-2px}
  /* Tableau de bord : en-têtes triables, montants alignés à droite, badges compacts */
  .dash th a{color:inherit;text-decoration:none}
  .dash th a:hover,.dash th a:focus-visible{text-decoration:underline}
  .dash th[aria-sort="ascending"] a::after{content:' ↑'}
  .dash th[aria-sort="descending"] a::after{content:' ↓'}
  .dash .num{text-align:right;white-space:nowrap}
  .dash td{vertical-align:top}
  .dash .who{font-weight:600}
  .dash .lang{color:var(--text-soft)}
  .dash td .badge{display:inline-block;margin:0 .25rem .25rem 0}
  .dash tbody tr:hover{background:rgb(var(--card))}
</style>
