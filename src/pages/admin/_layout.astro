---
// Gabarit des pages d'admin (hors routage : préfixe _) ; la ligne suivante satisfait le test des routes gardées
export const prerender = false;
import Base from '../../layouts/Base.astro';
import '../../styles/forms.css';

interface Props {
  title: string;
  nav?: boolean;
}
const { title, nav = true } = Astro.props;
const here = Astro.url.pathname.replace(/\/+$/, '') || '/admin';
// Fiche d'une cliente : l'entrée Clientes reste marquée
const section = here.startsWith('/admin/clientes/') ? '/admin/clientes' : here;
// Tracés d'icônes au trait (24×24), dessinés par currentColor
const LINKS = [
  ['/admin', 'Agenda', 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z'],
  ['/admin/reservations/nouvelle', 'Nouveau rendez-vous', 'M12 5v14M5 12h14'],
  ['/admin/clientes', 'Clientes', 'M16 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1M9.5 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM21 20v-1a4 4 0 0 0-3-3.9M16 4.1a3.5 3.5 0 0 1 0 6.8'],
  ['/admin/prestations', 'Prestations', 'M12 3l2.4 5.2 5.6.6-4.2 3.8 1.2 5.6L12 15.4 7 18.2l1.2-5.6L4 8.8l5.6-.6z'],
  ['/admin/horaires', 'Horaires', 'M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z'],
  ['/admin/codes-promo', 'Codes promo', 'M20 12l-8 8-9-9V3h8zM7.5 7.5h.01'],
  ['/admin/journal', 'Journal', 'M5 4h14v16H5zM9 8h6M9 12h6M9 16h4'],
  ['/admin/metriques', 'Métriques', 'M4 20h16M7 16v-4M12 16V7M17 16v-7'],
] as const;
// La déconnexion est ouverte avant le code par le middleware : le bouton reste aussi sur la page du code
---
<Base lang="fr" pageKey="home" canonicalPath={here} title={`${title} — Admin My Bubble Beauty`} description="Administration des rendez-vous." noindex mainClass="legal">
<div class="wrap"><article class="admin">
<aside class="admin-side">
  <p class="admin-brand">My Bubble <span>Beauty</span><small>Administration</small></p>
  {nav && <nav aria-label="Administration"><ul>{LINKS.map(([href, label, d]) => (
    <li><a href={href} aria-current={href === section ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={d} /></svg>{label}
    </a></li>
  ))}</ul></nav>}
  <form method="post" action="/admin/deconnexion"><button class="admin-out" type="submit">Se déconnecter</button></form>
</aside>
<div class="admin-main">
  <header class="admin-head"><h1>{title}</h1><slot name="actions" /></header>
  <slot />
</div>
</article></div>
</Base>

<style>
  :global(.legal) article.admin{max-width:1280px;display:grid;grid-template-columns:15.5rem minmax(0,1fr);padding:0;overflow:hidden}
  /* Panneau latéral dans la couleur de la lame des pages de connexion : même brun en clair et en sombre */
  .admin-side{display:flex;flex-direction:column;gap:1.5rem;padding:1.75rem 1rem;background:#4E302C;color:#FFFBF9}
  .admin-brand{margin:0 .75rem;font:300 1.6rem/1 var(--f-title);font-variation-settings:"SOFT" 100,"WONK" 0;color:inherit}
  .admin-brand span{display:block;font:400 1.3em/.9 "Allura",cursive;color:#E8C9A0}
  .admin-brand small{display:block;margin-top:.6rem;font:500 .7rem/1 var(--f-text);letter-spacing:.14em;text-transform:uppercase;color:rgb(255 251 249 / .6)}
  .admin-side ul{display:grid;gap:.25rem;list-style:none;margin:0;padding:0}
  /* Cibles de 44 px : la gérante passe d'une page à l'autre au téléphone */
  .admin-side a{display:flex;align-items:center;gap:.75rem;min-height:44px;padding:.5rem .75rem;border-radius:12px;color:rgb(255 251 249 / .82);text-decoration:none;transition:background var(--dur-ui),color var(--dur-ui)}
  .admin-side a:hover,.admin-side a:focus-visible{background:rgb(255 251 249 / .08);color:#FFFBF9}
  .admin-side a[aria-current="page"]{background:#FFFBF9;color:#4E302C;font-weight:500}
  .admin-side svg{flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .admin-side form{margin-top:auto}
  .admin-out{width:100%;min-height:44px;padding:.5rem .75rem;border:1px solid rgb(255 251 249 / .35);border-radius:999px;background:none;color:#FFFBF9;font:inherit;cursor:pointer}
  .admin-out:hover,.admin-out:focus-visible{background:#FFFBF9;color:#4E302C}
  .admin-main{min-width:0;padding:clamp(1.25rem,3vw,2.5rem)}
  .admin-head{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;margin:0 0 1.75rem}
  .admin-head h1{margin:0;font-size:clamp(2rem,2vw + 1.25rem,2.75rem)}
  /* Les textes .visually-hidden (position absolue) des tableaux restent dans le défilement du tableau, sinon la page déborde sur mobile */
  .admin :global(.table-wrap){position:relative;border:1px solid var(--line-soft);border-radius:16px;background:var(--bg)}
  .admin :global(.data-table th){background:var(--bg);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase}
  .admin :global(.data-table th),.admin :global(.data-table td){padding:.8rem 1rem}
  .admin :global(.data-table tbody tr:last-child td){border-bottom:0}
  /* Pastille de statut, à poser sur un span dans n'importe quelle page */
  .admin :global(.badge){display:inline-block;padding:.2rem .65rem;border-radius:999px;font-size:.8125rem;font-weight:500;line-height:1.4;white-space:nowrap;background:rgb(138 90 82 / .14);color:var(--text)}
  .admin :global(.badge--ok){background:rgb(76 128 92 / .18)}
  .admin :global(.badge--wait){background:rgb(196 150 70 / .24)}
  .admin :global(.badge--off){background:rgb(120 110 108 / .18);color:var(--text-soft)}
  .admin :global(.badge--alert){background:rgb(176 70 60 / .2)}
  @media (max-width:899px){
    /* minmax(0,…) : sans lui la bande de menu et les tableaux élargissent la colonne au-delà de l'écran */
    :global(.legal) article.admin{grid-template-columns:minmax(0,1fr)}
    .admin-side{position:relative;min-width:0;gap:1rem;padding:1rem}
    .admin-brand{display:flex;align-items:baseline;gap:.4rem;margin:0;min-height:44px;align-items:center;font-size:1.25rem}
    .admin-brand small{display:none}
    /* Menu en bande défilante : tout reste à portée de pouce sans tiroir */
    .admin-side ul{display:flex;overflow-x:auto;gap:.4rem;margin:0 -1rem;padding:0 1rem;scrollbar-width:none}
    .admin-side a{white-space:nowrap}
    .admin-side form{position:absolute;top:1rem;right:1rem;margin:0}
    .admin-out{width:auto;padding:.4rem 1rem}
  }
</style>
