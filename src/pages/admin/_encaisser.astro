---
// Composant (préfixe _, hors routage) ; la ligne suivante satisfait le test des routes gardées
export const prerender = false;
// Panneau « Terminer et encaisser » de l'écran Aujourd'hui (carte et clôture du soir) : montant prérempli (remise et bon déjà déduits),
// mode préchoisi = bon cadeau pour un soin offert, sinon le dernier mode utilisé par la cliente. Le serveur refuse un second encaissement.
import { centsInput } from '../../lib/server/admin-form.ts';
import { PAY_METHODS } from '../../lib/server/booking.ts';
import type { DayBooking } from '../../lib/server/accueil.ts';
import { euros } from '../../lib/server/pricing.ts';
interface Props { r: DayBooking; label?: string }
const { r, label = 'Terminer et encaisser' } = Astro.props;
const due = r.price_cents - r.discount_cents;
const pick = r.gift ? 'bon' : r.last_method && r.last_method in PAY_METHODS ? r.last_method : null;
---
<details class="pay" name="pay">
  <summary class="btn btn--solid">{label}<span class="visually-hidden"> : {r.name ?? 'cliente'}, {r.service}</span></summary>
  <form method="post" action={`/admin#c-${r.id}`} class="pay-form">
    <input type="hidden" name="action" value="pay"><input type="hidden" name="id" value={r.id}>
    <p class="pay-sum">{r.service}<br><small>Prix {euros(r.price_cents)}{r.discount_cents > 0 && <> · {r.gift ? 'bon cadeau' : `remise${r.promo ? ` ${r.promo}` : ''}`} −{euros(r.discount_cents)}</>}{r.paid && r.deposit_cents > 0 && <> · acompte {euros(r.deposit_cents)} payé en ligne</>}</small></p>
    <label class="field">À encaisser (€)<input name="amount" required inputmode="decimal" pattern="\d{1,5}([.,]\d{1,2})?" value={centsInput(due)}></label>
    <fieldset class="modes"><legend>Mode de paiement{!pick && ' (à choisir)'}</legend>
      {Object.entries(PAY_METHODS).map(([k, l]) => <label><input type="radio" name="method" value={k} required checked={k === pick}><span>{l}</span></label>)}
    </fieldset>
    <button class="btn btn--solid" type="submit">Valider : honoré et payé</button>
  </form>
</details>

<style>
  .pay{width:100%}
  .pay>summary{list-style:none;display:flex;justify-content:center;align-items:center;min-height:48px;width:100%;cursor:pointer}
  .pay>summary::-webkit-details-marker{display:none}
  .pay[open]>summary{border-bottom-left-radius:0;border-bottom-right-radius:0}
  .pay-form{display:grid;gap:.75rem;padding:1rem;border:1px solid var(--line-soft);border-top:0;border-radius:0 0 14px 14px;background:var(--bg)}
  .pay-sum{margin:0;font-weight:500}
  .pay-sum small{font-weight:400;color:var(--text-soft)}
  .pay-form .field{display:grid;gap:.3rem;font-size:.9375rem}
  .pay-form input[name=amount]{min-height:48px;font-size:1.25rem;font-variant-numeric:tabular-nums}
  .modes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin:0;padding:0;border:0;min-width:0}
  .modes legend{margin-bottom:.4rem;font-size:.9375rem}
  .modes label{position:relative}
  .modes input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
  .modes span{display:grid;place-items:center;min-height:48px;padding:.4rem;border:1px solid var(--line-soft);border-radius:12px;text-align:center}
  .modes input:checked+span{border-color:var(--accent);box-shadow:inset 0 0 0 2px var(--accent);font-weight:600}
  .modes input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}
  .pay-form button{min-height:48px}
</style>
