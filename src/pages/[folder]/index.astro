---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, FOLDER, CONTACT, SITE, SALON_ID, LANG_META, EXTRA, HOURS, JS_VERSION, hoursRows, openingHoursSchema, t, pagePath, langOfFolder } from '../../lib/site';

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { folder: FOLDER[l] } }));
}
const lang = langOfFolder(Astro.params.folder!);
const d = t(lang);
const h = d.home;
const ui = d.ui;
const treat = (slug: string) => pagePath(lang, `treatment:${slug}`);
// Photo de chaque carte soin, dans l'ordre de home.soins.cards
const CARD_IMG = ['visage', 'massage', 'epilation', 'corps', 'onglerie', 'sourire'];
// FAQ : {hours} et {phone} viennent de site.ts, pour ne jamais diverger des horaires et du numéro affichés ailleurs
const hoursText = hoursRows(lang).map((r) => `${r.label}${lang === 'fr' ? ' :' : ':'} ${r.value}`).join('. ') + '.';
const faq = h.faq ? h.faq.items.map((it: { q: string; a: string }) => ({ q: it.q, a: it.a.replace('{hours}', hoursText).replace('{phone}', CONTACT.phoneLabel) })) : [];
const salon = {
  '@type': 'BeautySalon', '@id': SALON_ID, name: 'My Bubble Beauty', description: h.description,
  url: SITE + pagePath(lang, 'home'), telephone: CONTACT.phone, email: CONTACT.email, hasMap: CONTACT.maps,
  logo: SITE + '/assets/img/logo-my-bubble.png', image: SITE + '/assets/img/galerie-1.webp',
  address: { '@type': 'PostalAddress', streetAddress: CONTACT.street, postalCode: CONTACT.postal, addressLocality: CONTACT.city, addressCountry: 'BE' },
  geo: { '@type': 'GeoCoordinates', latitude: 50.8522424, longitude: 4.2847883 },
  areaServed: ['Anderlecht', 'Molenbeek-Saint-Jean', 'Dilbeek', 'Berchem-Sainte-Agathe'],
  sameAs: CONTACT.social.map((s) => s.href), priceRange: '€€',
  ...(HOURS.length ? { openingHoursSpecification: openingHoursSchema() } : {}),
};
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': faq.length ? [salon, { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : [salon],
};
---
<Base lang={lang} pageKey="home" title={h.title} description={h.description} jsonld={jsonld} isHome>
<link slot="head" rel="preload" as="image" href="/assets/img/hero-souade-voile-1200.webp" imagesrcset="/assets/img/hero-souade-voile-800.webp 800w, /assets/img/hero-souade-voile-1200.webp 1200w, /assets/img/hero-souade-voile-1536.webp 1536w" imagesizes="100vw" fetchpriority="high">

<section class="hero" data-loop aria-labelledby="h-hero">
<div class="hero__media"><img class="hero__img px-far" src="/assets/img/hero-souade-voile-1200.webp" srcset="/assets/img/hero-souade-voile-800.webp 800w, /assets/img/hero-souade-voile-1200.webp 1200w, /assets/img/hero-souade-voile-1536.webp 1536w" sizes="100vw" width="1536" height="768" alt={h.hero.imgAlt} fetchpriority="high" decoding="async"></div>
<div class="wrap hero__wrap">
<div class="hero__panel">
<p class="hero__eyebrow">{h.hero.eyebrow}</p>
<h1 id="h-hero"><span class="h1-brand">{h.hero.brand} <span class="h1-script">Beauty</span></span> <span class="h1-sub">{h.hero.sub}</span></h1>
<div class="hero__cta">
<a class="btn btn--solid sheen" href={`/${FOLDER[lang]}/reserver`}>{h.hero.cta}</a>
{/* Une seule action mise en avant : le téléphone reste un simple lien */}
<a class="hero__tel" href={`tel:${CONTACT.phone}`}><Icon name="phone" />{CONTACT.phoneLabel}</a>
</div>
</div>
</div>
</section>

<section class="infos lit" id="intro" aria-label={h.infos.label}>
<div class="halo halo--lilas px-halo" aria-hidden="true"></div>
<div class="wrap"><ul class="infos__list">
{h.infos.items.map((it) => <li><strong>{it.label}</strong><Fragment set:html={it.html} /></li>)}
</ul></div>
</section>

<section class="section about lit" aria-labelledby="h-about">
<div class="halo halo--lilas" aria-hidden="true"></div>
<div class="wrap about__gallery">
<div class="about__content">
<p class="eyebrow">{h.about.eyebrow}</p>
<h2 id="h-about">{h.about.quote}</h2><p class="about__lead">{h.about.lead}</p>
<details class="about__more"><summary><span class="more">{h.about.more}</span><span class="less">{h.about.less}</span></summary><Fragment set:html={h.about.bodyHtml} /></details>
</div>
{/* Mosaïque des vraies photos de l'institut : la cabine, l'appareil Hydra, le mur My Bubble */}
<div class="about__mosaic">
<figure class="about__tile about__tile--main"><img src="/assets/img/centre-cabine-800.webp" srcset="/assets/img/centre-cabine-800.webp 800w, /assets/img/centre-cabine-1200.webp 1200w" sizes="(max-width: 899px) 60vw, 30vw" width="1200" height="1600" alt={h.about.imgAlt} loading="lazy" decoding="async"></figure>
<figure class="about__tile"><img src="/assets/img/centre-hydra-600.webp" width="600" height="600" alt="" loading="lazy" decoding="async"></figure>
<figure class="about__tile"><img src="/assets/img/centre-mur-600.webp" width="600" height="600" alt="" loading="lazy" decoding="async"></figure>
</div>
</div>
</section>

<section class="section soins lit cursor-zone" id="services" aria-labelledby="h-soins">
<div class="halo halo--rose" aria-hidden="true"></div>
<div class="cursor-glow" aria-hidden="true"></div>
<div class="wrap">
<div class="section__head"><p class="eyebrow">{h.soins.eyebrow}</p><h2 id="h-soins">{h.soins.title}</h2><p>{h.soins.intro}</p></div>
<ul class="soins__grid">
{h.soins.cards.map((c, i) => (
  <li class="soin"><div class="soin__media"><img src={`/assets/img/cartes/${CARD_IMG[i]}.webp`} width="720" height="540" alt="" loading="lazy" decoding="async"></div><div class="soin__body"><Icon name={`soin-${i}`} class="soin__icon" /><h3>{c.title}</h3><p>{c.text}</p><a href={c.href}>{c.link}<span class="visually-hidden">{lang === 'fr' ? ' : ' : ': '}{c.title}</span><span aria-hidden="true"> →</span></a></div></li>
))}
</ul>
</div>
</section>

<section class="section tarifs lit" id="package" aria-labelledby="h-tarifs">
<div class="halo halo--peche" aria-hidden="true"></div>
<div class="wrap">
<div class="section__head"><p class="eyebrow">{h.tarifs.eyebrow}</p><h2 id="h-tarifs">{h.tarifs.title}</h2><p>{h.tarifs.intro}</p></div>
<div class="tarifs__panel">
<div class="filters-wrap">
<ul class="filters" aria-label={h.tarifs.filtersLabel} hidden>
{h.tarifs.filters.map((f, i) => <li><button class="pill" type="button" data-filter={f.key} aria-pressed={f.key === 'visage' ? 'true' : 'false'} data-status={f.status}>{f.label}</button></li>)}
</ul>
{/* Mobile : indique qu'il reste des filtres à droite (décoratif, main.js l'affiche ou le cache) */}
<span class="filters__more" aria-hidden="true">→</span>
</div>
<p class="visually-hidden" id="filter-status" role="status"></p>
{[
  { key: 'presta', title: h.tarifs.partPresta, groups: h.tarifs.groups.filter((g) => !(g as { hidden?: boolean }).hidden) },
  { key: 'formules', title: h.tarifs.partFormules, groups: h.tarifs.formulas },
].map((part) => (
  <section class={`tarifs__part tarifs__part--${part.key}`} aria-labelledby={`h-part-${part.key}`}>
  <h3 class="tarifs__part-title" id={`h-part-${part.key}`}>{part.title}</h3>
  <div class="price-groups">
  {part.groups.map((g) => (
    <section class="price-group" data-cat={g.cat} id={`tarif-${g.id}`} aria-labelledby={`h-tarif-${g.id}`}>
      <h4 id={`h-tarif-${g.id}`}>{g.href
        ? <a href={treat(g.href)}>{g.title}<Icon name="info" class="i-info" /><span class="visually-hidden">, {ui.moreInfo}</span></a>
        : g.title}</h4>
      {g.intro && <p class="price-group__intro">{g.intro}</p>}
      <ul class="prices">{g.items.map((it) => {
        // Prestation : « durée · description » ; formule : son contenu, puis « durée · prix par séance »
        const isFormule = 'detail' in it;
        const line1 = isFormule ? it.detail : [it.duration, it.desc].filter(Boolean).join(' · ');
        const line2 = isFormule ? [it.duration, it.note].filter(Boolean).join(' · ') : '';
        return (
          <li class="sheen"><span class="name">{it.href
            ? <a href={treat(it.href)}>{it.name}<Icon name="info" class="i-info" /><span class="visually-hidden">, {ui.moreInfo}</span></a>
            : it.name}{it.badge && <span class="price-badge">{it.badge}</span>}{line1 && <small>{line1}</small>}{line2 && <small class="price-note">{line2}</small>}</span><span class="dots" aria-hidden="true"></span><span class="amount">{it.amount}{it.was && <s class="was"><span class="visually-hidden"> {h.tarifs.wasLabel} </span>{it.was}</s>}</span></li>
        );
      })}</ul>
      {/* Le titre est un lien, mais peu de clientes le devinent : la fiche est aussi proposée en toutes lettres */}
      <div class="price-group__foot">
        {g.href && <a class="price-group__more" href={treat(g.href)}>{ui.moreInfo}<span class="visually-hidden">{lang === 'fr' ? ' : ' : ': '}{g.title}</span><span aria-hidden="true"> →</span></a>}
        <a class="price-group__book" href={`/${FOLDER[lang]}/reserver`}>{h.tarifs.book}<span class="visually-hidden">{lang === 'fr' ? ' : ' : ': '}{g.title}</span><span aria-hidden="true"> →</span></a>
      </div>
    </section>
  ))}
  </div>
  </section>
))}
<div class="tarifs__cta"><a class="btn btn--solid sheen" href={`/${FOLDER[lang]}/reserver`}>{h.hero.cta}</a><a class="btn btn--ghost" href={`tel:${CONTACT.phone}`}><Icon name="phone" />{CONTACT.phoneLabel}</a></div>
</div>
</div>
</section>

<section class="section galerie lit" id="gallery" aria-labelledby="h-galerie">
<div class="halo halo--lilas" aria-hidden="true"></div>
<div class="wrap">
<div class="section__head"><p class="eyebrow">{h.gallery.eyebrow}</p><h2 id="h-galerie">{h.gallery.title}</h2></div>
<ul class="mosaic">
{h.gallery.items.map((g) => {
  // Taille de l'image pleine (les photos d'origine sont en 1600 × 1200) ; variantes 800 et 1200 seulement si plus petites
  const gw = g.w ?? 1600, gh = g.h ?? 1200;
  // Vidéo : tuile à part (pas .frame, qui ouvre la visionneuse), muette, lancée seulement par la cliente
  if (g.video) return <li><div class="frame-video"><video src={`/assets/video/${g.video}.mp4`} poster={`/assets/video/${g.video}.webp`} width={gw} height={gh} controls muted playsinline preload="none" aria-label={g.alt}></video></div></li>;
  const srcset = [...[800, 1200].filter((x) => x < gw).map((x) => `/assets/img/galerie-${g.n}-${x}.webp ${x}w`), `/assets/img/galerie-${g.n}.webp ${gw}w`].join(', ');
  return <li><a class="frame" href={`/assets/img/galerie-${g.n}.webp`} aria-label={g.ariaLabel}><img src={`/assets/img/galerie-${g.n}-800.webp`} srcset={srcset} sizes="(max-width: 767px) 100vw, 50vw" width="800" height={Math.round(800 * gh / gw)} data-w={gw} data-h={gh} alt={g.alt} loading="lazy" decoding="async"></a></li>;
})}
</ul>
</div>
<dialog class="lightbox" aria-label={h.gallery.dialogLabel}>
<figure><img src="/assets/img/galerie-1-800.webp" alt="" width="1600" height="1200" loading="lazy"><figcaption></figcaption></figure>
<button class="lightbox__close" type="button" aria-label={h.gallery.close}>×</button>
</dialog>
</section>

{/* Avis Google copiés par la tâche planifiée : la page est pré-rendue, avis.js les demande à /api/avis et laisse la section cachée s'il n'y en a pas */}
<section class="section avis lit" id="avis" aria-labelledby="h-avis" hidden data-avis
  data-rating={h.avis.rating} data-count={h.avis.count} data-stars={h.avis.stars} data-locale={LANG_META[lang].hreflang}>
<div class="halo halo--rose" aria-hidden="true"></div>
<div class="wrap">
<div class="section__head"><p class="eyebrow">{h.avis.eyebrow}</p><h2 id="h-avis">{h.avis.title}</h2><p class="avis__score" data-avis-score></p></div>
<ul class="avis__list" data-avis-list></ul>
<p class="avis__note">{h.avis.note}</p>
<p class="avis__links"><a class="btn btn--ghost" href={CONTACT.maps} rel="noopener">{h.avis.more}</a><a class="btn btn--solid sheen" data-avis-write hidden rel="noopener">{h.avis.write}</a></p>
</div>
<script is:inline src={`/assets/js/avis.js?v=${JS_VERSION}`} defer></script>
</section>

{faq.length > 0 && <section class="section faq lit" id="faq" aria-labelledby="h-faq">
<div class="wrap">
<div class="section__head"><p class="eyebrow">{h.faq.eyebrow}</p><h2 id="h-faq">{h.faq.title}</h2></div>
<div class="faq__list">{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
</div>
</section>}

<section class="cta-band" aria-labelledby="h-cta">
<img class="cta-band__img" src="/assets/img/galerie-2-800.webp" srcset="/assets/img/galerie-2-800.webp 800w, /assets/img/galerie-2-1200.webp 1200w, /assets/img/galerie-2.webp 1600w" sizes="100vw" width="1600" height="1200" alt="" loading="lazy" decoding="async">
<div class="wrap cta-band__inner">
<h2 id="h-cta">{h.cta.title}</h2>
<p>{h.contact.intro}</p>
<div class="cta-band__btns"><a class="btn btn--light sheen" href={`/${FOLDER[lang]}/reserver`}>{ui.book}</a><a class="btn btn--outline-light" href={`tel:${CONTACT.phone}`}><Icon name="phone" />{CONTACT.phoneLabel}</a><a class="btn btn--outline-light" href={CONTACT.whatsapp}><Icon name="whatsapp" />WhatsApp</a></div>
</div>
</section>

<section class="section contact lit" id="contact" data-loop aria-labelledby="h-contact">
<div class="halo halo--menthe px-halo" aria-hidden="true"></div>
<div class="halo halo--rose px-halo" aria-hidden="true"></div>
<div class="wrap">
{/* Gauche : l'action d'abord, puis les coordonnées ; droite : horaires et canaux, pour équilibrer les deux colonnes */}
<div class="contact__card">
{/* Le même avatar que dans les reels, en grand : la cliente reconnaît la personne qui l'accueille */}
<figure class="contact__avatar"><img class="contact__avatar-img" src="/assets/img/souade-voile-480.webp" srcset="/assets/img/souade-voile-300.webp 300w, /assets/img/souade-voile-480.webp 480w" sizes="(max-width:1023px) 220px, 300px" width="480" height="672" alt="Souade, My Bubble Beauty" loading="lazy" decoding="async"><figcaption><span class="contact__avatar-name">Souade</span><span class="contact__avatar-role">My Bubble Beauty</span></figcaption></figure>
<div class="contact__main">
<p class="eyebrow">{h.contact.eyebrow}</p>
<h2 id="h-contact">{h.contact.title}</h2>
<p class="contact__intro">{h.contact.intro}</p>
<div class="contact__cta">
<a class="btn btn--solid sheen" href={`/${FOLDER[lang]}/reserver`}>{ui.book}</a>
<a class="btn btn--ghost" href={`tel:${CONTACT.phone}`}><Icon name="phone" />{ui.call}</a>
</div>
<dl class="contact__info">
<div><dt>{h.contact.labels[0]}</dt><dd><address>{CONTACT.street}<br>{CONTACT.postal} {CONTACT.city}<br>{LANG_META[lang].country}</address><a href={CONTACT.maps} rel="noopener">{h.contact.itinerary}</a></dd></div>
<div><dt>{h.contact.labels[1]}</dt><dd><a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneLabel}</a></dd></div>
<div><dt>{h.contact.labels[2]}</dt><dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd></div>
</dl>
</div>
<div class="contact__side">
{HOURS.length > 0 && <section class="contact__hours" aria-labelledby="h-hours"><h3 id="h-hours">{EXTRA[lang].hours}</h3>
<ul class="hours">{hoursRows(lang).map((r, i) => <li data-day={i + 1}><span>{r.label}</span><span>{r.value}</span></li>)}</ul></section>}
<section class="contact__social" aria-labelledby="h-social"><h3 id="h-social">{h.contact.socialTitle}</h3>
<ul class="social"><li><a href={CONTACT.whatsapp} rel="noopener"><Icon name="whatsapp" /><span>WhatsApp</span></a></li>{CONTACT.social.map((s) => <li><a href={s.href} rel="noopener"><Icon name={s.key} /><span>{s.label}</span></a></li>)}</ul></section>
</div>
</div>
</div>
</section>
</Base>
