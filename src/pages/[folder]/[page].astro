---
// Pages légales : mentions, confidentialité, conditions générales (3 langues).
import Base from '../../layouts/Base.astro';
import { LANGS, FOLDER, PAGES, t, langOfFolder } from '../../lib/site';
import { CGV } from '../../data/cgv';
import { LEGAL, AUDIENCE_GC } from '../../data/legal';
import { GOATCOUNTER } from '../../lib/site';

type Key = 'mentions' | 'privacy' | 'cgv';

export function getStaticPaths() {
  // Les constantes doivent vivre ici : Astro isole getStaticPaths du reste de la page.
  const keys = ['mentions', 'privacy', 'cgv'] as const;
  return LANGS.flatMap((l) => keys.map((key) => ({ params: { folder: FOLDER[l], page: PAGES[key][l] }, props: { key } })));
}
const { key } = Astro.props as { key: Key };
const lang = langOfFolder(Astro.params.folder!);
const doc = key === 'cgv' ? CGV[lang] : LEGAL[lang][key];
const title = doc.title;
const metaTitle = `${doc.title} — My Bubble Beauty`;
const description = doc.description;
// Confidentialité : la 4e rubrique (mesure d'audience) décrit GoatCounter dès qu'il est activé.
const sections = doc.sections.map((s, i) => (key === 'privacy' && i === 3 && GOATCOUNTER ? { ...s, html: AUDIENCE_GC[lang] } : s));
const body = sections.map((s) => `<h2>${s.h}</h2>${s.html}`).join('');
const updated = doc.updated;
---
<Base lang={lang} pageKey={key} title={metaTitle} description={description} mainClass="legal">
<div class="wrap"><article>
<h1>{title}</h1>
<Fragment set:html={body} />
{updated && <p class="mt-10 text-sm opacity-80"><em>{updated}</em></p>}
</article></div>
</Base>
