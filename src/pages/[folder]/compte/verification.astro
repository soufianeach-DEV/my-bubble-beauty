---
// Activation du compte : le GET n'affiche qu'un formulaire (les scanners de liens ne consomment rien), le POST demande le mot de passe
// choisi à l'inscription puis ouvre la session. Le jeton voyage dans le corps, jamais dans l'URL du POST.
export const prerender = false;
import { z } from 'astro/zod';
import Base from '../../../layouts/Base.astro';
import PasswordField from './_password-field.astro';
import '../../../styles/forms.css';
import { COMPTE } from '../../../data/i18n/compte.ts';
import { FOLDER, JS_VERSION, langOfFolder } from '../../../lib/site';
import { verifyEmail } from '../../../lib/server/accounts.ts';
import { PASSWORD, TOKEN, readForm } from '../../../lib/server/compte.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const tx = COMPTE[lang];
const t = tx.verify;

let token = Astro.url.searchParams.get('token');
let failed = false;
if (Astro.request.method === 'POST') {
  const { data, raw } = await readForm(Astro.request, z.object({ token: TOKEN, password: PASSWORD }));
  const u = data && (await verifyEmail(Astro.cookies, data.token, data.password, Astro.locals.ip, Astro.request.headers.get('user-agent')));
  if (u) return Astro.redirect(`/${d}/compte`, 303);
  // Mauvais mot de passe : le jeton reste valable, le formulaire est proposé à nouveau
  token = raw.token ?? null;
  failed = true;
}
const valid = TOKEN.safeParse(token).success;
---
<Base lang={lang} pageKey="home" canonicalPath={`/${d}/compte/verification`} title={`${t.title} — My Bubble Beauty`} description={t.description} noindex mainClass="legal">
<Fragment slot="head"><meta name="referrer" content="no-referrer"><script is:inline src={`/assets/js/password.js?v=${JS_VERSION}`} defer></script></Fragment>
<div class="wrap"><article>
<h1>{t.title}</h1>
{failed && <p class="notice notice--error" role="alert">{t.failed}</p>}
{valid ? (
<Fragment>
<p>{t.intro}</p>
<form class="form" method="post" action={`/${d}/compte/verification`}>
<input type="hidden" name="token" value={token}>
<PasswordField id="password" name="password" label={tx.pw.label} lang={lang} invalid={failed} />
<button class="btn btn--solid" type="submit">{t.submit}</button>
</form>
</Fragment>
) : <p class="notice notice--error" role="alert">{t.missing}</p>}
<p>{t.expired} <a href={`/${d}/compte/mot-de-passe-oublie`}>{tx.login.forgot}</a></p>
</article></div>
</Base>
