---
// Connexion : signIn gère limites, cookie d'appareil et nouvelle session. Un seul message d'échec, quelle qu'en soit la cause.
// L'admin passe ensuite par /admin/code ; les autres reviennent au paramètre retour (même origine seulement).
export const prerender = false;
import { SITE_URL } from 'astro:env/server';
import { z } from 'astro/zod';
import Base from '../../../layouts/Base.astro';
import PasswordField from './_password-field.astro';
import External from './_external.astro';
import '../../../styles/forms.css';
import { COMPTE } from '../../../data/i18n/compte.ts';
import { FOLDER, JS_VERSION, langOfFolder } from '../../../lib/site';
import { signIn } from '../../../lib/server/accounts.ts';
import { PASSWORD, readForm } from '../../../lib/server/compte.ts';
import { safeReturn } from '../../../lib/server/redirect.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const tx = COMPTE[lang];
const back = safeReturn(Astro.url.searchParams.get('retour'), SITE_URL, `/${d}/compte`);
if (Astro.locals.user && Astro.request.method === 'GET') return Astro.redirect(back);

let email = '';
let failed = false;
// Retour d'un échec chez Google ou Microsoft (/oauth/…/retour)
const externe = Astro.url.searchParams.get('externe');
if (Astro.request.method === 'POST') {
  // Format d'adresse non contrôlé ici : une adresse fausse reçoit le même échec et compte dans les mêmes limites
  const { data, raw } = await readForm(Astro.request, z.object({ email: z.string().max(254), password: PASSWORD, remember: z.string().max(8).optional() }));
  const u = data && (await signIn(Astro.cookies, data.email, data.password, Astro.locals.ip, Astro.request.headers.get('user-agent'), data.remember === 'on'));
  if (u) return Astro.redirect(u.mfaRequired ? '/admin/code' : back, 303);
  email = (raw.email ?? '').slice(0, 254);
  failed = true;
}
---
<Base lang={lang} pageKey="home" route="compte/connexion" title={`${tx.login.title} - My Bubble Beauty`} description={tx.login.description} noindex mainClass="legal">
<Fragment slot="head"><script is:inline src={`/assets/js/password.js?v=${JS_VERSION}`} defer></script><script is:inline src={`/assets/js/auth-swap.js?v=${JS_VERSION}`}></script></Fragment>
<div class="wrap"><div class="auth"><article>
<h1>{tx.login.title}</h1>
{failed && <p class="notice notice--error" role="alert">{tx.login.failed}</p>}
{!failed && externe === 'echec' && <p class="notice notice--error" role="alert">{tx.ext.failed}</p>}
{!failed && externe === 'annule' && <p class="notice" role="status">{tx.ext.cancelled}</p>}
<p>{tx.login.intro}</p>
<form class="form" method="post">
<div class="field">
<label for="email">{tx.email}</label>
<input id="email" name="email" type="email" required maxlength="254" autocomplete="username" value={email}>
</div>
<PasswordField id="password" name="password" label={tx.pw.label} lang={lang} />
<div class="check">
<input id="remember" name="remember" type="checkbox" aria-describedby="remember-hint">
<label for="remember">{tx.login.remember}<span class="hint" id="remember-hint">{tx.login.rememberHint}</span></label>
</div>
<button class="btn btn--solid" type="submit">{tx.login.submit}</button>
</form>
<p><a href={`/${d}/compte/mot-de-passe-oublie`}>{tx.login.forgot}</a></p>
<External lang={lang} back={back} link />
</article>
{/* Lame de marque : glisse de droite à gauche vers l'inscription (transition de vue, voir forms.css) */}
<aside class="auth__blade"><img class="auth__avatar" src="/assets/img/auth-table-voile-800.webp" srcset="/assets/img/auth-table-voile-480.webp 480w, /assets/img/auth-table-voile-800.webp 800w" sizes="(max-width:759px) 100vw, 480px" width="800" height="1169" alt="" decoding="async"><div class="auth__veil"><p class="auth__brand">My Bubble <span>Beauty</span></p><p>{tx.login.noAccount}</p><a class="btn btn--ghost" href={`/${d}/compte/inscription`}>{tx.login.register}</a></div></aside>
</div></div>
</Base>
