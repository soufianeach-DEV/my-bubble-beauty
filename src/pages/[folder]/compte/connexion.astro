---
// Connexion : signIn gère limites, cookie d'appareil et nouvelle session. Un seul message d'échec, quelle qu'en soit la cause.
// L'admin passe ensuite par /admin/code ; les autres reviennent au paramètre retour (même origine seulement).
export const prerender = false;
import { SITE_URL } from 'astro:env/server';
import { z } from 'astro/zod';
import Base from '../../../layouts/Base.astro';
import PasswordField from './_password-field.astro';
import '../../../styles/forms.css';
import { COMPTE } from '../../../data/i18n/compte.ts';
import { FOLDER, JS_VERSION, langOfFolder } from '../../../lib/site';
import { signIn } from '../../../lib/server/accounts.ts';
import { PASSWORD, readForm } from '../../../lib/server/compte.ts';
import { safeReturn } from '../../../lib/server/redirect.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const tx = COMPTE[lang];
const back = safeReturn(Astro.url.searchParams.get('retour'), SITE_URL, `/${d}/compte`);
if (Astro.locals.user && Astro.request.method === 'GET') return Astro.redirect(back);

let email = '';
let failed = false;
if (Astro.request.method === 'POST') {
  // Format d'adresse non contrôlé ici : une adresse fausse reçoit le même échec et compte dans les mêmes limites
  const { data, raw } = await readForm(Astro.request, z.object({ email: z.string().max(254), password: PASSWORD }));
  const u = data && (await signIn(Astro.cookies, data.email, data.password, Astro.locals.ip, Astro.request.headers.get('user-agent')));
  if (u) return Astro.redirect(u.mfaRequired ? '/admin/code' : back, 303);
  email = (raw.email ?? '').slice(0, 254);
  failed = true;
}
---
<Base lang={lang} pageKey="home" route="compte/connexion" title={`${tx.login.title} — My Bubble Beauty`} description={tx.login.description} noindex mainClass="legal">
<Fragment slot="head"><script is:inline src={`/assets/js/password.js?v=${JS_VERSION}`} defer></script></Fragment>
<div class="wrap"><article>
<h1>{tx.login.title}</h1>
{failed && <p class="notice notice--error" role="alert">{tx.login.failed}</p>}
<p>{tx.login.intro}</p>
<form class="form" method="post">
<div class="field">
<label for="email">{tx.email}</label>
<input id="email" name="email" type="email" required maxlength="254" autocomplete="username" value={email}>
</div>
<PasswordField id="password" name="password" label={tx.pw.label} lang={lang} />
<button class="btn btn--solid" type="submit">{tx.login.submit}</button>
</form>
<p><a href={`/${d}/compte/mot-de-passe-oublie`}>{tx.login.forgot}</a></p>
<p>{tx.login.noAccount} <a href={`/${d}/compte/inscription`}>{tx.login.register}</a></p>
</article></div>
</Base>
