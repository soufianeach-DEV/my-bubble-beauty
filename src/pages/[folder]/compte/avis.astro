---
// Avis sur un rendez-vous honoré (note et texte), puis page de merci. Rendez-vous relu par identifiant ET cliente connectée.
// Merci : « Publier aussi sur Google » copie le texte et ouvre la fiche, pour TOUTES les clientes quelle que soit la note
// (pas de tri des avis, interdit par Google) ; absent si GOOGLE_REVIEW_URL n'est pas réglé.
export const prerender = false;
import { z } from 'astro/zod';
import { GOOGLE_REVIEW_URL } from 'astro:env/server';
import Base from '../../../layouts/Base.astro';
import '../../../styles/forms.css';
import { CONTACT, FOLDER, JS_VERSION, langOfFolder } from '../../../lib/site';
import { readForm, when } from '../../../lib/server/compte.ts';
import { reviewableBooking, saveSiteReview } from '../../../lib/server/avis-site.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const self = `/${d}/compte/avis`;
const user = Astro.locals.user;
if (!user) return Astro.redirect(`/${d}/compte/connexion`);
const T = {
  fr: { title: 'Votre avis', description: 'Donnez votre avis sur votre rendez-vous.', about: 'Rendez-vous : ', rating: 'Votre note', of: (n: number) => `${n} sur 5`, text: 'Votre avis', textHint: 'Ce qui vous a plu, ce qui pourrait être mieux. 2000 caractères au plus.', submit: 'Envoyer mon avis', check: 'Choisissez une note et écrivez quelques mots.', notFound: 'Ce rendez-vous est introuvable ou ne peut pas encore recevoir d’avis. Pour toute question : ', thanks: 'Merci pour votre avis !', yours: 'Votre avis', google: 'Publier aussi sur Google', copied: 'Votre avis est copié, il suffit de le coller sur Google.', back: 'Retour à mon compte' },
  nl: { title: 'Uw review', description: 'Geef uw mening over uw afspraak.', about: 'Afspraak: ', rating: 'Uw score', of: (n: number) => `${n} op 5`, text: 'Uw review', textHint: 'Wat u goed vond, wat beter kan. Maximaal 2000 tekens.', submit: 'Mijn review versturen', check: 'Kies een score en schrijf een paar woorden.', notFound: 'Deze afspraak is niet gevonden of kan nog geen review krijgen. Vragen? ', thanks: 'Bedankt voor uw review!', yours: 'Uw review', google: 'Ook op Google plaatsen', copied: 'Uw review is gekopieerd, u hoeft hem alleen op Google te plakken.', back: 'Terug naar mijn account' },
  en: { title: 'Your review', description: 'Tell us about your appointment.', about: 'Appointment: ', rating: 'Your rating', of: (n: number) => `${n} out of 5`, text: 'Your review', textHint: 'What you liked, what could be better. 2000 characters at most.', submit: 'Send my review', check: 'Choose a rating and write a few words.', notFound: 'This appointment was not found or cannot be reviewed yet. Any question: ', thanks: 'Thank you for your review!', yours: 'Your review', google: 'Also post on Google', copied: 'Your review is copied, just paste it on Google.', back: 'Back to my account' },
}[lang];

const Id = z.string().regex(/^\d{1,18}$/).transform(Number);
const Post = z.object({ id: Id, note: z.enum(['1', '2', '3', '4', '5']).transform(Number), texte: z.string().trim().min(1).max(2000) });
let id: number | null = null;
let error = false;
let draft = { note: 0, texte: '' };
if (Astro.request.method === 'POST') {
  const f = await readForm(Astro.request, Post);
  const p = Id.safeParse(f.raw.id);
  id = p.success ? p.data : null;
  if (f.data) {
    await saveSiteReview(user.id, f.data.id, f.data.note, f.data.texte);
    // Enregistré ou déjà déposé : la page relue montre le merci et l'avis gardé (le double envoi n'en crée pas deux)
    return Astro.redirect(`${self}?id=${f.data.id}`, 303);
  }
  error = true;
  draft = { note: Number(f.raw.note) || 0, texte: (f.raw.texte ?? '').slice(0, 2000) };
} else {
  const p = Id.safeParse(Astro.url.searchParams.get('id'));
  id = p.success ? p.data : null;
}
const b = id ? await reviewableBooking(user.id, id, lang) : null;
---
<Base lang={lang} pageKey="home" route="compte/avis" title={`${T.title} - My Bubble Beauty`} description={T.description} noindex mainClass="legal">
{b?.review && GOOGLE_REVIEW_URL && <Fragment slot="head"><script is:inline src={`/assets/js/avis-google.js?v=${JS_VERSION}`} defer></script></Fragment>}
<div class="wrap"><article>
{!b ? <>
<h1>{T.title}</h1>
<p class="notice notice--error" role="alert">{T.notFound}<a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneLabel}</a>.</p>
</> : b.review ? <>
<h1>{T.thanks}</h1>
<p><strong>{T.about}</strong>{b.service}, {when(b.starts_at, lang)}</p>
<h2>{T.yours}</h2>
<figure class="my-review">
<p class="stars" aria-label={T.of(b.review.rating)}><span aria-hidden="true">{'★'.repeat(b.review.rating)}{'☆'.repeat(5 - b.review.rating)}</span></p>
<blockquote id="avis-texte">{b.review.comment}</blockquote>
</figure>
{GOOGLE_REVIEW_URL && <div class="to-google">
<a class="btn btn--solid" href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener" data-copy-review="avis-texte">{T.google}</a>
<p class="hint">{T.copied}</p>
</div>}
</> : <>
<h1>{T.title}</h1>
<p><strong>{T.about}</strong>{b.service}, {when(b.starts_at, lang)}</p>
{error && <p class="notice notice--error" role="alert">{T.check}</p>}
<form class="form" method="post" action={self}>
<input type="hidden" name="id" value={b.id}>
<fieldset class="field">
<legend>{T.rating}</legend>
<div class="rating">{[1, 2, 3, 4, 5].map((n) => (
<label class="check"><input type="radio" name="note" value={n} required checked={draft.note === n}><span><span aria-hidden="true">{'★'.repeat(n)}</span><span class="visually-hidden">{T.of(n)}</span></span></label>
))}</div>
</fieldset>
<div class="field">
<label for="texte">{T.text}</label>
<textarea id="texte" name="texte" rows="6" maxlength="2000" required aria-describedby="texte-hint">{draft.texte}</textarea>
<span class="hint" id="texte-hint">{T.textHint}</span>
</div>
<button class="btn btn--solid" type="submit">{T.submit}</button>
</form>
</>}
<p><a href={`/${d}/compte`}>{T.back}</a></p>
</article></div>
</Base>

<style>
.rating{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem}
.rating .check{align-items:center;min-height:44px}
.stars{color:var(--accent);font-size:1.25rem;letter-spacing:.1em;margin:0 0 .5rem}
.my-review{margin:0 0 1.5rem;padding:1rem 1.25rem;border:1px solid var(--line-soft);border-radius:12px;background:var(--bg)}
.my-review blockquote{margin:0;white-space:pre-line}
.to-google{display:grid;gap:.5rem;justify-items:start;margin-bottom:1.5rem}
</style>
