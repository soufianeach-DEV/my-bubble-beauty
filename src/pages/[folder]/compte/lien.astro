---
// Connexion par lien envoyé par e-mail. Sans jeton : demande du lien (réponse identique que l'adresse ait un compte ou non).
// Avec jeton : le GET n'affiche qu'un bouton (les antivirus de messagerie ouvrent les liens), le POST consomme le jeton et ouvre la session.
export const prerender = false;
import { z } from 'astro/zod';
import Base from '../../../layouts/Base.astro';
import '../../../styles/forms.css';
import { COMPTE } from '../../../data/i18n/compte.ts';
import { FOLDER, langOfFolder } from '../../../lib/site';
import { requestLoginLink, signInWithLink } from '../../../lib/server/accounts.ts';
import { TOKEN, readForm } from '../../../lib/server/compte.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const tx = COMPTE[lang];
const t = tx.lien;
if (Astro.locals.user && Astro.request.method === 'GET') return Astro.redirect(`/${d}/compte`);

let token = Astro.url.searchParams.get('token');
let sent = false;
let failed = false;
if (Astro.request.method === 'POST') {
  const { data } = await readForm(Astro.request, z.object({ token: TOKEN.optional(), email: z.string().max(254).optional() }));
  if (data?.token) {
    const u = await signInWithLink(Astro.cookies, data.token, Astro.locals.ip, Astro.request.headers.get('user-agent'));
    if (u) return Astro.redirect(`/${d}/compte`, 303);
    failed = true;
  } else if (data?.email) {
    await requestLoginLink(data.email, lang, Astro.locals.ip);
    sent = true;
  }
  token = null;
}
const valid = !failed && TOKEN.safeParse(token).success;
---
<Base lang={lang} pageKey="home" route="compte/lien" title={`${t.title} — My Bubble Beauty`} description={t.description} noindex mainClass="legal">
<Fragment slot="head"><meta name="referrer" content="no-referrer"></Fragment>
<div class="wrap"><article>
<h1>{t.title}</h1>
{failed && <p class="notice notice--error" role="alert">{t.failed}</p>}
{sent && <p class="notice" role="status">{t.sent}</p>}
{valid ? (
<Fragment>
<p>{t.open}</p>
<form class="form" method="post" action={`/${d}/compte/lien`}>
<input type="hidden" name="token" value={token}>
<button class="btn btn--solid" type="submit">{t.go}</button>
</form>
</Fragment>
) : !sent && (
<Fragment>
<p>{t.intro}</p>
<form class="form" method="post" action={`/${d}/compte/lien`}>
<div class="field">
<label for="email">{tx.email}</label>
<input id="email" name="email" type="email" required maxlength="254" autocomplete="email">
</div>
<button class="btn btn--solid" type="submit">{t.submit}</button>
</form>
</Fragment>
)}
<p><a href={`/${d}/compte/connexion`}>← {tx.login.title}</a></p>
</article></div>
</Base>
