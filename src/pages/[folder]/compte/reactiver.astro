---
// Compte en suppression (30 jours) : seule page ouverte par le middleware. Réactiver, effacer tout de suite, ou se déconnecter.
export const prerender = false;
import { z } from 'astro/zod';
import Base from '../../../layouts/Base.astro';
import PasswordField from './_password-field.astro';
import '../../../styles/forms.css';
import { COMPTE } from '../../../data/i18n/compte.ts';
import { FOLDER, JS_VERSION, langOfFolder } from '../../../lib/site';
import { PASSWORD, readForm } from '../../../lib/server/compte.ts';
import { eraseNow, GRACE_DAYS, reactivate } from '../../../lib/server/rgpd.ts';
import { closeSession } from '../../../lib/server/session.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const tx = COMPTE[lang];
const tr = tx.reactivate;
const self = `/${d}/compte/reactiver`;
const user = Astro.locals.user;
if (!user || !user.deletedAt) return Astro.redirect(`/${d}/compte`);
const dayOnly = new Intl.DateTimeFormat({ fr: 'fr-BE', nl: 'nl-BE', en: 'en-GB' }[lang], { timeZone: 'Europe/Brussels', dateStyle: 'long' }).format;
const until = new Date(user.deletedAt.getTime() + GRACE_DAYS * 86_400_000);

const ACTION = z.discriminatedUnion('action', [
  z.object({ action: z.literal('reactivate') }),
  z.object({ action: z.literal('erase'), password: PASSWORD }),
  z.object({ action: z.literal('logout') }),
]);
let notice: { text: string; error?: boolean } | null = null;
let erased = false;
let badPassword = false;
if (Astro.request.method === 'POST') {
  const f = (await readForm(Astro.request, ACTION)).data;
  if (!f) notice = { text: tx.invalid, error: true };
  else if (f.action === 'logout') {
    await closeSession(Astro.cookies);
    return Astro.redirect(`/${d}/compte/connexion`, 303);
  } else if (f.action === 'reactivate') {
    if (await reactivate(user.id, Astro.locals.ip)) return Astro.redirect(`/${d}/compte?reactive=ok`, 303);
    notice = { text: tr.expired, error: true };
  } else {
    const r = await eraseNow(Astro.cookies, user, f.password, Astro.locals.ip);
    if (r === 'ok') erased = true;
    else {
      notice = { text: tx.account.wrong, error: true };
      badPassword = true;
    }
  }
}
---
<Base lang={lang} pageKey="home" route="compte/reactiver" title={`${tr.title} - My Bubble Beauty`} description={tr.description} noindex mainClass="legal">
<Fragment slot="head"><script is:inline src={`/assets/js/password.js?v=${JS_VERSION}`} defer></script></Fragment>
<div class="wrap"><article>
<h1>{tr.title}</h1>
{erased ? <p class="notice" role="status">{tx.account.erasedDone} <a href={`/${d}/index.html`}>{tx.account.home}</a></p> : <>
{notice && <p class:list={['notice', notice.error && 'notice--error']} role={notice.error ? 'alert' : 'status'}>{notice.text}</p>}
<p>{tr.intro(dayOnly(until))}</p>

<h2>{tr.back}</h2>
<p class="hint">{tr.backHint}</p>
<form class="inline-form" method="post" action={self}><input type="hidden" name="action" value="reactivate"><button class="btn btn--solid" type="submit">{tr.back}</button></form>

<h2>{tr.eraseTitle}</h2>
<form class="form" method="post" action={self}>
<input type="hidden" name="action" value="erase">
<p class="hint">{tr.eraseHint} {tx.account.deletePassword}</p>
<PasswordField id="password" name="password" label={tx.pw.label} lang={lang} invalid={badPassword} />
<button class="btn btn--ghost" type="submit">{tr.erase}</button>
</form>

<form class="inline-form" method="post" action={self}><input type="hidden" name="action" value="logout"><button class="btn btn--ghost" type="submit">{tx.account.logout}</button></form>
</>}
</article></div>
</Base>
