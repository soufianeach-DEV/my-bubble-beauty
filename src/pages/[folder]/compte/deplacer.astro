---
// Déplacer un rendez-vous (confirmé, 24 h avant au plus tard) : jour puis créneau, mêmes règles que la réservation en ligne.
// Le rendez-vous est relu par identifiant ET cliente connectée : celui d'une autre cliente donne « introuvable ».
export const prerender = false;
import { z } from 'astro/zod';
import Base from '../../../layouts/Base.astro';
import DayPicker from '../../../components/DayPicker.astro';
import '../../../styles/forms.css';
import { COMPTE } from '../../../data/i18n/compte.ts';
import { RESERVER } from '../../../data/i18n/reserver';
import { CONTACT, FOLDER, langOfFolder } from '../../../lib/site';
import { movableBooking, rescheduleByClient } from '../../../lib/server/booking.ts';
import { readForm, when } from '../../../lib/server/compte.ts';
import { isDay, todayBrussels } from '../../../lib/server/pricing.ts';
import { slots } from '../../../lib/server/slots.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const tm = COMPTE[lang].move;
const L = RESERVER[lang];
const self = `/${d}/compte/deplacer`;
const user = Astro.locals.user;
if (!user) return Astro.redirect(`/${d}/compte/connexion`);

const Id = z.string().regex(/^\d{1,18}$/).transform(Number);
const Post = z.object({ id: Id, debut: z.iso.datetime().regex(/^20\d\d-/) });
let id: number | null = null;
let error: string | null = null;
let day = todayBrussels();
const today = day;
const addDays = (x: string, n: number) => new Date(Date.parse(`${x}T00:00:00Z`) + n * 86_400_000).toISOString().slice(0, 10);
const lastDay = addDays(today, 60);
const dayLabel = (x: string) => new Intl.DateTimeFormat(L.locale, { timeZone: 'Europe/Brussels', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(`${x}T12:00:00Z`));

if (Astro.request.method === 'POST') {
  const f = (await readForm(Astro.request, Post)).data;
  if (f) {
    id = f.id;
    const r = await rescheduleByClient(user.id, f.id, new Date(f.debut));
    if (r === 'ok') return Astro.redirect(`/${d}/compte?deplace=ok`, 303);
    error = r === 'unavailable' ? tm.unavailable : null;
    day = todayBrussels(new Date(f.debut));
  }
} else {
  const p = Id.safeParse(Astro.url.searchParams.get('id'));
  id = p.success ? p.data : null;
  const j = Astro.url.searchParams.get('jour');
  if (j && isDay(j) && j >= today && j <= lastDay) day = j;
}
const b = id ? await movableBooking(user.id, id, lang) : null;
if (b && !Astro.url.searchParams.get('jour') && Astro.request.method !== 'POST') day = todayBrussels(b.starts_at) < today ? today : todayBrussels(b.starts_at);
const list = b ? await slots(b.service_id, day, user.id, b.id) : [];
const link = (x: string) => `${self}?id=${b?.id}&jour=${x}`;
---
<Base lang={lang} pageKey="home" route="compte/deplacer" title={`${tm.title} - My Bubble Beauty`} description={tm.description} noindex mainClass="legal">
<div class="wrap"><article>
<h1>{tm.title}</h1>
{!b ? (
  <p class="notice notice--error" role="alert">{tm.notFound} <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneLabel}</a>.</p>
) : <>
{error && <p class="notice notice--error" role="alert">{error}</p>}
<p><strong>{tm.current}</strong>{b.service}, {when(b.starts_at, lang)}</p>
<p>{tm.intro}</p>
<DayPicker lang={lang} day={day} today={today} lastDay={lastDay} label={L.day} href={(d) => `${self}?id=${b.id}&jour=${d}`} />
<h2 id="h-slots">{L.slotsOf(dayLabel(day))}</h2>
{list.length ? (
  <form method="post" action={self} aria-labelledby="h-slots">
  <input type="hidden" name="id" value={b.id}>
  <ul class="slots">{list.map((s) => <li><button class="btn btn--ghost" type="submit" name="debut" value={s.at.toISOString()}>{s.label}</button></li>)}</ul>
  <p class="hint">{L.brussels}</p>
  </form>
) : <p class="notice">{L.noSlot}</p>}
<nav class="actions days" aria-label={L.day}>
{day > today && <a class="btn btn--ghost" href={link(addDays(day, -1))}>{L.prevDay}</a>}
{day < lastDay && <a class="btn btn--ghost" href={link(addDays(day, 1))}>{L.nextDay}</a>}
</nav>
</>}
<p><a href={`/${d}/compte`}>{tm.back}</a></p>
</article></div>
</Base>

<style>
.days{margin-top:1.25rem}
</style>
