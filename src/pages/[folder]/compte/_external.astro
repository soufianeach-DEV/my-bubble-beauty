---
// Boutons « Continuer avec Google / Microsoft » (seulement ceux configurés) et, sur la connexion, le lien par e-mail.
// Liens ordinaires vers /oauth/… : aucune requête vers Google ou Microsoft depuis la page, la CSP reste inchangée.
// Présent pour le test des routes gardées, qui lit tout fichier de ce dossier
export const prerender = false;
import { COMPTE } from '../../../data/i18n/compte.ts';
import { enabledProviders } from '../../../lib/server/oauth.ts';
import { PROVIDERS } from '../../../lib/server/oidc.ts';
import { FOLDER, pagePath, type Lang } from '../../../lib/site';

interface Props {
  lang: Lang;
  back: string;
  link?: boolean;
  // Inscription : boutons côte à côte en tête de formulaire, « ou » dessous, pour ne pas allonger la carte
  compact?: boolean;
}
const { lang, back, link = false, compact = false } = Astro.props;
const t = COMPTE[lang].ext;
const providers = enabledProviders();
const [c0, cgv, c2, privacy, c4] = t.consent;
const href = (p: string) => `/oauth/${p}?${new URLSearchParams({ lang, retour: back })}`;
---
{(providers.length > 0 || link) && (
<div class:list={['ext', { 'ext--compact': compact }]}>
  {!compact && <p class="ext__or"><span>{t.or}</span></p>}
  <div class="ext__btns">
  {providers.map((p) => (
    <a class="ext__btn" href={href(p)}>
      {p === 'google'
        ? <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        : <svg viewBox="0 0 21 21" width="18" height="18" aria-hidden="true"><path fill="#F25022" d="M1 1h9v9H1z"/><path fill="#7FBA00" d="M11 1h9v9h-9z"/><path fill="#00A4EF" d="M1 11h9v9H1z"/><path fill="#FFB900" d="M11 11h9v9h-9z"/></svg>}
      {compact ? <><span aria-hidden="true">{PROVIDERS[p].label}</span><span class="visually-hidden">{t.with(PROVIDERS[p].label)}</span></> : t.with(PROVIDERS[p].label)}
    </a>
  ))}
  {link && <a class="ext__btn" href={`/${FOLDER[lang]}/compte/lien`}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="ext__mail"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>{t.link}</a>}
  </div>
  {providers.length > 0 && <p class="ext__consent">{c0}<a href={pagePath(lang, 'cgv')} target="_blank" rel="noopener">{cgv}</a>{c2}<a href={pagePath(lang, 'privacy')} target="_blank" rel="noopener">{privacy}</a>{c4}</p>}
  {compact && <p class="ext__or"><span>{t.or}</span></p>}
</div>
)}

<style>
  .ext{display:grid;gap:.6rem;margin:1.5rem 0 0}
  .ext__btns{display:grid;gap:.6rem}
  .ext--compact{margin:0 0 1.25rem}
  .ext--compact .ext__btns{grid-template-columns:repeat(auto-fit,minmax(11rem,1fr))}
  .ext--compact .ext__or{margin:.25rem 0 0}
  /* « ou » au milieu d'un trait fin */
  .ext__or{display:flex;align-items:center;gap:.9rem;margin:0 0 .25rem;color:var(--text-soft);font-size:.875rem}
  .ext__or::before,.ext__or::after{content:"";flex:1;border-top:1px solid var(--line-soft)}
  .ext__btn{display:flex;align-items:center;justify-content:center;gap:.7rem;min-height:48px;padding:.6rem 1rem;border:1px solid var(--line-soft);border-radius:999px;background:var(--bg);color:var(--text);font-weight:500;text-decoration:none;transition:background var(--dur-ui),border-color var(--dur-ui)}
  .ext__btn:hover,.ext__btn:focus-visible{background:rgb(var(--card));border-color:var(--line)}
  .ext__mail{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linejoin:round}
  .ext__consent{margin:.15rem 0 0;font-size:.8125rem;color:var(--text-soft)}
</style>
