---
// Tableau de bord de la cliente : rendez-vous (annulation jusqu'à 24 h avant), retour de Stripe, coordonnées, mot de passe,
// appareils connectés et déconnexion. Toute action passe par POST ; les listes sont lues après l'action, donc dans leur état réel.
export const prerender = false;
import { z } from 'astro/zod';
import Base from '../../../layouts/Base.astro';
import PasswordField from './_password-field.astro';
import '../../../styles/forms.css';
import { COMPTE } from '../../../data/i18n/compte.ts';
import { CONTACT, FOLDER, JS_VERSION, langOfFolder } from '../../../lib/site';
import { changePassword, signOutOthers, updateProfile } from '../../../lib/server/accounts.ts';
import { cancelByClient, clientBookings, confirmReturn } from '../../../lib/server/booking.ts';
import { NAME, PASSWORD, PHONE, device, readForm, when } from '../../../lib/server/compte.ts';
import { euros } from '../../../lib/server/pricing.ts';
import { closeSession, listSessions } from '../../../lib/server/session.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const tx = COMPTE[lang];
const ta = tx.account;
const self = `/${d}/compte`;
const user = Astro.locals.user;
const session = Astro.locals.session;
// Le middleware exige déjà une session : la page ne s'y fie pas pour autant
if (!user || !session) return Astro.redirect(`${self}/connexion`);

const ACTION = z.discriminatedUnion('action', [
  z.object({ action: z.literal('cancel'), id: z.coerce.number().int().positive() }),
  z.object({ action: z.literal('profile'), name: NAME, phone: PHONE }),
  z.object({ action: z.literal('password'), current: PASSWORD, next: PASSWORD }),
  z.object({ action: z.literal('others'), password: PASSWORD }),
  z.object({ action: z.literal('logout') }),
]);

let notice: { text: string; error?: boolean; call?: boolean } | null = null;
let profile = { name: user.name ?? '', phone: user.phone ?? '' };
let bad = new Set<string>();
let cancelled: { id: number; refunded: boolean } | null = null;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request, ACTION);
  const f = form.data;
  bad = form.bad;
  if (!f) {
    notice = { text: tx.invalid, error: true };
    if (form.raw.action === 'profile') profile = { name: form.raw.name ?? '', phone: form.raw.phone ?? '' };
  } else if (f.action === 'logout') {
    await closeSession(Astro.cookies);
    return Astro.redirect(`${self}/connexion`, 303);
  } else if (f.action === 'cancel') {
    const r = await cancelByClient(user.id, f.id);
    if (r.ok) cancelled = { id: f.id, refunded: r.refunded };
    else notice = r.error === 'too_late' ? { text: ta.tooLate, error: true, call: true } : { text: ta.notFound, error: true };
  } else if (f.action === 'profile') {
    await updateProfile(user.id, f);
    profile = f;
    notice = { text: ta.saved };
  } else if (f.action === 'password') {
    const r = await changePassword(user.id, f.current, f.next, session.hash);
    if (r === 'ok') notice = { text: ta.changed };
    else {
      notice = { text: r === 'wrong' ? ta.wrong : tx.problem[r], error: true };
      bad.add(r === 'wrong' ? 'current' : 'next');
    }
  } else if (await signOutOthers(user.id, f.password, session.hash)) notice = { text: ta.othersDone };
  else {
    notice = { text: ta.wrong, error: true };
    bad.add('password');
  }
} else {
  // Retour de Stripe Checkout (success_url) : confirmation rejouable, l'état réel se lit ensuite dans la liste
  const sid = Astro.url.searchParams.get('session_id');
  const outcome = sid ? await confirmReturn(user.id, sid) : null;
  if (outcome === 'confirmed' || outcome === 'already') notice = { text: ta.paid };
  else if (outcome === 'refunded') notice = { text: ta.refunded };
  else if (outcome === 'unpaid') notice = { text: ta.unpaid };
  // Retour de /reserver après une réservation sans acompte ; la liste ci-dessous fait foi, le message renvoie vers elle
  else if (Astro.url.searchParams.get('reservation') === 'ok') notice = { text: ta.booked };
}

const [bookings, sessions] = await Promise.all([clientBookings(user.id, lang), listSessions(user.id, session.hash)]);
if (cancelled) {
  // Un acompte non nul sur une réservation confirmée a été payé : s'il n'a pas pu être rendu, l'admin le voit et le relance
  const paid = (bookings.find((b) => b.id === cancelled!.id)?.deposit_cents ?? 0) > 0;
  notice = { text: [ta.cancelled, cancelled.refunded ? ta.refundSent : paid ? ta.refundLater : ''].join(' ').trim() };
}
const upcoming = bookings.filter((b) => b.upcoming && b.status !== 'cancelled').reverse();
const history = bookings.filter((b) => !b.upcoming || b.status === 'cancelled');
const invalid = (k: string) => (bad.has(k) ? 'true' : undefined);
const price = (b: (typeof bookings)[number]) => euros(b.price_cents - b.discount_cents, lang);
---
<Base lang={lang} pageKey="home" route="compte" title={`${ta.title} — My Bubble Beauty`} description={ta.description} noindex mainClass="legal">
<Fragment slot="head"><script is:inline src={`/assets/js/password.js?v=${JS_VERSION}`} defer></script></Fragment>
<div class="wrap"><article>
<h1>{ta.title}</h1>
{notice && (
<p class:list={['notice', notice.error && 'notice--error']} role={notice.error ? 'alert' : 'status'}>
{notice.text}{notice.call && <Fragment>{' '}<a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneLabel}</a>.</Fragment>}
</p>
)}
<p>{[ta.hello, profile.name].filter(Boolean).join(' ')}</p>
<div class="actions">
<a class="btn btn--solid" href={`/${d}/reserver`}>{ta.book}</a>
{user.isAdmin && <a class="btn btn--ghost" href="/admin">{ta.admin}</a>}
<form class="inline-form" method="post" action={self}><input type="hidden" name="action" value="logout"><button class="btn btn--ghost" type="submit">{ta.logout}</button></form>
</div>

<h2>{ta.upcoming}</h2>
{upcoming.length ? (
<ul class="bookings">{upcoming.map((b) => (
<li>
<p><strong>{when(b.starts_at, lang)}</strong></p>
<p>{b.service} · {price(b)}</p>
<p>{ta.status[b.status]}{b.status === 'confirmed' && b.deposit_cents > 0 && ` · ${ta.depositPaid}${euros(b.deposit_cents, lang)}`}</p>
{b.status === 'pending_payment' && <p class="hint">{ta.pending}</p>}
{b.cancellable ? (
<details class="cancel"><summary>{ta.cancel}<span class="visually-hidden"> {ta.cancelHidden} {when(b.starts_at, lang)}</span></summary>
<form method="post" action={self}><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value={b.id}><button class="btn btn--ghost" type="submit">{ta.cancelConfirm}</button></form>
</details>
) : b.status === 'confirmed' && <p class="hint">{ta.callToCancel}{' '}<a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneLabel}</a></p>}
</li>
))}</ul>
) : <p>{ta.noUpcoming}</p>}

<h2>{ta.history}</h2>
{history.length ? (
<ul class="bookings">{history.map((b) => (
<li>
<p><strong>{when(b.starts_at, lang)}</strong></p>
<p>{b.service} · {price(b)}</p>
<p>{b.status === 'confirmed' ? ta.status.past : ta.status[b.status]}{b.refunded_cents > 0 && ` · ${ta.refundedAmount}${euros(b.refunded_cents, lang)}`}</p>
</li>
))}</ul>
) : <p>{ta.noHistory}</p>}

<h2>{ta.profile}</h2>
<p><strong>{tx.email}</strong><br>{user.email}</p>
<p class="hint">{ta.emailFixed} <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.</p>
<form class="form" method="post" action={self}>
<input type="hidden" name="action" value="profile">
<div class="field">
<label for="name">{tx.register.name}</label>
<input id="name" name="name" type="text" required maxlength="100" autocomplete="name" value={profile.name.slice(0, 100)} aria-invalid={invalid('name')}>
</div>
<div class="field">
<label for="phone">{tx.register.phone} <span class="hint">{tx.optional}</span></label>
<input id="phone" name="phone" type="tel" maxlength="30" autocomplete="tel" value={profile.phone.slice(0, 30)} aria-invalid={invalid('phone')}>
</div>
<button class="btn btn--solid" type="submit">{ta.save}</button>
</form>

<h2>{ta.password}</h2>
<form class="form" method="post" action={self}>
<input type="hidden" name="action" value="password">
<PasswordField id="current" name="current" label={ta.current} lang={lang} invalid={bad.has('current')} />
<PasswordField id="next" name="next" label={ta.next} lang={lang} isNew invalid={bad.has('next')} />
<button class="btn btn--solid" type="submit">{ta.changeSubmit}</button>
</form>

<h2>{ta.sessions}</h2>
<div class="table-wrap"><table class="data-table">
<thead><tr>{ta.sessionCols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
<tbody>{sessions.map((s) => (
<tr>
<td>{device(s.user_agent) || ta.unknownDevice}{s.current && <Fragment> ({ta.thisDevice})</Fragment>}</td>
<td>{when(s.created_at, lang, 'medium')}</td>
<td>{when(s.last_seen_at, lang, 'medium')}</td>
</tr>
))}</tbody>
</table></div>
{sessions.length > 1 && (
<form class="form" method="post" action={self}>
<input type="hidden" name="action" value="others">
<p class="hint">{ta.othersHint}</p>
<PasswordField id="others-password" name="password" label={tx.pw.label} lang={lang} invalid={bad.has('password')} />
<button class="btn btn--ghost" type="submit">{ta.others}</button>
</form>
)}
</article></div>
</Base>

<style>
.actions{margin-bottom:1rem}
/* Cartes plutôt que tableau : cinq colonnes ne tiennent pas sur un téléphone */
.bookings{list-style:none;margin:0 0 1.5rem;padding:0;display:grid;gap:.75rem}
.bookings li{border:1px solid var(--line-soft);border-radius:12px;padding:.9rem 1rem;background:var(--bg)}
.bookings p{margin:0 0 .25rem}
</style>
