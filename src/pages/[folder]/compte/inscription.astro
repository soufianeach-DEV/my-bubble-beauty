---
// Inscription : la réponse est la même, adresse libre ou déjà prise (register envoie l'e-mail qui convient sans l'attendre).
// Seul un problème de mot de passe est affiché : il est jugé avant toute recherche de l'adresse, il ne trahit donc aucun compte.
export const prerender = false;
import { z } from 'astro/zod';
import Base from '../../../layouts/Base.astro';
import PasswordField from './_password-field.astro';
import External from './_external.astro';
import '../../../styles/forms.css';
import { COMPTE } from '../../../data/i18n/compte.ts';
import { SITE_URL } from 'astro:env/server';
import { FOLDER, JS_VERSION, langOfFolder, pagePath } from '../../../lib/site';
import { safeReturn } from '../../../lib/server/redirect.ts';
import { register, type PasswordProblem } from '../../../lib/server/accounts.ts';
import { confirmMismatch, EMAIL, NAME, PASSWORD, PHONE, readForm } from '../../../lib/server/compte.ts';

const lang = langOfFolder(Astro.params.folder!);
const d = FOLDER[lang];
const tx = COMPTE[lang];
const t = tx.register;
// Retour (récapitulatif d'une réservation…) : suivi jusqu'à l'e-mail d'activation, Google / Microsoft et la connexion
const back = safeReturn(Astro.url.searchParams.get('retour'), SITE_URL, `/${d}/compte`);
const qs = back === `/${d}/compte` ? '' : `?retour=${encodeURIComponent(back)}`;
if (Astro.locals.user && Astro.request.method === 'GET') return Astro.redirect(back);

const SCHEMA = z.object({ email: EMAIL, password: PASSWORD, name: NAME, phone: PHONE, terms: z.literal('on') });
let sent = false;
let problem: PasswordProblem | null = null;
let bad = new Set<string>();
let raw: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request, SCHEMA);
  ({ bad, raw } = form);
  // Confirmations refusées côté serveur aussi : le formulaire revient rempli, sans les mots de passe
  const off = confirmMismatch(raw);
  for (const k of off) bad.add(k);
  if (form.data && off.size === 0) {
    problem = await register({ ...form.data, locale: lang, ip: Astro.locals.ip, back });
    if (problem) bad.add('password');
    else sent = true;
  }
}
const error = problem ? tx.problem[problem] : Astro.request.method === 'POST' && !sent ? tx.invalid : null;
const invalid = (k: string) => (bad.has(k) ? 'true' : undefined);
const [t0, cgv, t2, privacy, t4] = t.terms;
---
<Base lang={lang} pageKey="home" route="compte/inscription" title={`${t.title} - My Bubble Beauty`} description={t.description} noindex mainClass="legal">
<Fragment slot="head"><script is:inline src={`/assets/js/password.js?v=${JS_VERSION}`} defer></script><script is:inline src={`/assets/js/auth-swap.js?v=${JS_VERSION}`}></script></Fragment>
<div class="wrap"><div class="auth auth--register"><article>
<h1>{t.title}</h1>
{sent ? (
<Fragment>
<p class="notice" role="status">{t.sent}</p>
<p>{t.spam}</p>
<p><a href={`/${d}/compte/connexion${qs}`}>{tx.login.submit}</a></p>
</Fragment>
) : (
<Fragment>
{error && <p class="notice notice--error" role="alert">{error}</p>}
<p>{t.intro}</p>
<External lang={lang} back={back} compact />
<form class="form" method="post">
<div class="field">
<label for="email">{tx.email}</label>
<input id="email" name="email" type="email" required maxlength="254" autocomplete="username" value={(raw.email ?? '').slice(0, 254)} aria-invalid={invalid('email')}>
</div>
{/* Confirmation : le collage reste permis (accessibilité, gestionnaires de mots de passe) */}
<div class="field">
<label for="email2">{t.email2}</label>
<input id="email2" name="email2" type="email" required maxlength="254" autocomplete="email" value={(raw.email2 ?? '').slice(0, 254)} aria-invalid={invalid('email2')} aria-describedby="email2-match" data-match="email" data-mismatch={t.emailMismatch}>
<p class="hint field-error" id="email2-match" data-match-msg aria-live="polite" hidden={!bad.has('email2')}>{t.emailMismatch}</p>
</div>
<PasswordField id="password" name="password" label={tx.pw.label} lang={lang} isNew invalid={bad.has('password')} />
<PasswordField id="password2" name="password2" label={t.password2} lang={lang} match="password" mismatch={t.passwordMismatch} invalid={bad.has('password2')} />
<div class="form__row">
<div class="field">
<label for="name">{t.name}</label>
<input id="name" name="name" type="text" required maxlength="100" autocomplete="name" value={(raw.name ?? '').slice(0, 100)} aria-invalid={invalid('name')}>
</div>
<div class="field">
<label for="phone">{t.phone} <span class="hint">{tx.optional}</span></label>
<input id="phone" name="phone" type="tel" maxlength="30" autocomplete="tel" value={(raw.phone ?? '').slice(0, 30)} aria-invalid={invalid('phone')} aria-describedby="phone-hint">
<p class="hint" id="phone-hint">{t.phoneHint}</p>
</div>
</div>
<div class="check">
<input id="terms" name="terms" type="checkbox" required checked={raw.terms === 'on'} aria-invalid={invalid('terms')}>
<label for="terms">{t0}<a href={pagePath(lang, 'cgv')} target="_blank" rel="noopener">{cgv}</a>{t2}<a href={pagePath(lang, 'privacy')} target="_blank" rel="noopener">{privacy}</a>{t4}</label>
</div>
<button class="btn btn--solid" type="submit">{t.submit}</button>
</form>
</Fragment>
)}
</article>
{/* Même lame qu'à la connexion, en miroir à gauche */}
<aside class="auth__blade"><img class="auth__avatar" src="/assets/img/auth-visage-voile-800.webp" srcset="/assets/img/auth-visage-voile-480.webp 480w, /assets/img/auth-visage-voile-800.webp 800w" sizes="(max-width:759px) 100vw, 480px" width="800" height="1169" alt="" decoding="async"><div class="auth__veil"><p class="auth__brand">My Bubble <span>Beauty</span></p><p>{t.have}</p><a class="btn btn--ghost" href={`/${d}/compte/connexion${qs}`}>{tx.login.submit}</a></div></aside>
</div></div>
</Base>
