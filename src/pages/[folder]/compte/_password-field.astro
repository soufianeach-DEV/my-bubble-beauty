---
// Champ de mot de passe des pages de compte (le « _ » le tient hors des routes). Bouton afficher/masquer et indicateur de longueur
// restent masqués sans JS : password.js les révèle, le champ et sa règle écrite suffisent sans lui.
// Présent pour le test des routes gardées, qui lit tout fichier de ce dossier
export const prerender = false;
import Icon from '../../../components/Icon.astro';
import { COMPTE } from '../../../data/i18n/compte.ts';
import type { Lang } from '../../../lib/site';

interface Props {
  id: string;
  name: string;
  label: string;
  lang: Lang;
  /** Nouveau mot de passe : règle écrite, indicateur et autocomplétion new-password */
  isNew?: boolean;
  invalid?: boolean;
}
const { id, name, label, lang, isNew = false, invalid = false } = Astro.props;
const pw = COMPTE[lang].pw;
---
<div class="field" data-pw>
{isNew ? (
<div class="pw-head">
<label for={id}>{label}</label>
<details class="pw-info">
<summary><span aria-hidden="true">!</span><span class="visually-hidden">{pw.ruleLabel}</span></summary>
<p class="pw-info__pop" id={`${id}-rule`}>{pw.rule}</p>
</details>
</div>
) : <label for={id}>{label}</label>}
<div class="pw-box">
<input id={id} name={name} type="password" required minlength={isNew ? 12 : undefined} autocomplete={isNew ? 'new-password' : 'current-password'} autocapitalize="off" spellcheck="false" aria-invalid={invalid ? 'true' : undefined} aria-describedby={isNew ? `${id}-rule ${id}-meter` : undefined}>
{/* Œil dans le champ : aria-label dit l'action, aria-pressed l'état ; caché sans JS (password.js le révèle) */}
<button class="pw-toggle" type="button" data-pw-toggle data-show={pw.show} data-hide={pw.hide} aria-controls={id} aria-label={pw.show} aria-pressed="false" hidden><Icon name="eye" class="pw-eye" /><Icon name="eye-off" class="pw-eye-off" /></button>
</div>
{isNew && <p class="hint" id={`${id}-meter`} data-pw-meter data-short={pw.short} data-ok={pw.ok} data-long={pw.long} aria-live="polite" hidden></p>}
</div>

<style>
/* Bouton œil posé à droite dans le champ, zone de 44 px ; le texte ne passe pas dessous */
.pw-box{position:relative}
.pw-box:has(.pw-toggle:not([hidden])) input{padding-right:3rem}
/* Edge ajoute son propre œil : un seul bouton */
.pw-box input::-ms-reveal{display:none}
.pw-toggle{position:absolute;top:50%;right:0;translate:0 -50%;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;border-radius:10px;background:none;color:var(--text-soft);cursor:pointer}
.pw-toggle:hover{color:var(--text)}
.pw-toggle:focus-visible{outline:2px solid var(--link);outline-offset:-4px}
.pw-toggle :global(svg){width:1.25rem;height:1.25rem}
.pw-toggle[aria-pressed="true"] :global(.pw-eye),.pw-toggle[aria-pressed="false"] :global(.pw-eye-off){display:none}
/* Règle repliée derrière « ! » : <details> s'ouvre au clic ou au clavier, sans JS ; l'aide reste lue par aria-describedby */
.pw-head{display:flex;align-items:center;gap:.5rem;position:relative}
.pw-info summary{list-style:none;display:grid;place-items:center;width:1.375rem;height:1.375rem;border:1px solid var(--line);border-radius:50%;font:600 .8125rem/1 var(--f-text);color:var(--text-soft);cursor:pointer}
.pw-info summary::-webkit-details-marker{display:none}
.pw-info summary::after{content:"";position:absolute;inset:-11px}
.pw-info summary{position:relative}
.pw-info[open] summary,.pw-info summary:hover{color:var(--text);border-color:var(--text-soft)}
.pw-info__pop{position:absolute;left:0;right:0;bottom:calc(100% + .4rem);z-index:5;margin:0;padding:.75rem .9rem;border:1px solid var(--line-soft);border-radius:.75rem;background:var(--bg);box-shadow:0 8px 24px rgb(0 0 0/.08);font-size:.875rem;color:var(--text-soft);transform-origin:.7rem 100%;transition:opacity 150ms ease-out,scale 150ms ease-out,translate 150ms ease-out}
/* Ouverture animée sans JS (réglages tooltip de transitions.dev) : @starting-style donne l'état de départ ; fermeture instantanée */
@starting-style{.pw-info[open] .pw-info__pop{opacity:0;scale:.98;translate:0 2px}}
@media (prefers-reduced-motion:reduce){.pw-info__pop{transition:none}}
</style>
