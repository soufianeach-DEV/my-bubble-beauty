---
// Champ de mot de passe des pages de compte (le « _ » le tient hors des routes). Bouton afficher/masquer et indicateur de longueur
// restent masqués sans JS : password.js les révèle, le champ et sa règle écrite suffisent sans lui.
// Présent pour le test des routes gardées, qui lit tout fichier de ce dossier
export const prerender = false;
import { COMPTE } from '../../../data/i18n/compte.ts';
import type { Lang } from '../../../lib/site';

interface Props {
  id: string;
  name: string;
  label: string;
  lang: Lang;
  /** Nouveau mot de passe : règle écrite, indicateur et autocomplétion new-password */
  isNew?: boolean;
  invalid?: boolean;
}
const { id, name, label, lang, isNew = false, invalid = false } = Astro.props;
const pw = COMPTE[lang].pw;
---
<div class="field" data-pw>
<label for={id}>{label}</label>
<input id={id} name={name} type="password" required minlength={isNew ? 12 : undefined} autocomplete={isNew ? 'new-password' : 'current-password'} autocapitalize="off" spellcheck="false" aria-invalid={invalid ? 'true' : undefined} aria-describedby={isNew ? `${id}-rule ${id}-meter` : undefined}>
<button class="pw-toggle" type="button" data-pw-toggle data-show={pw.show} data-hide={pw.hide} aria-controls={id} hidden>{pw.show}</button>
{isNew && <p class="hint" id={`${id}-rule`}>{pw.rule}</p>}
{isNew && <p class="hint" id={`${id}-meter`} data-pw-meter data-short={pw.short} data-ok={pw.ok} data-long={pw.long} aria-live="polite" hidden></p>}
</div>

<style>
.pw-toggle{justify-self:start;font:inherit;font-size:.9375rem;color:var(--link);background:none;border:0;padding:.5rem 0;min-height:44px;text-decoration:underline;text-underline-offset:.2em;cursor:pointer}
</style>
